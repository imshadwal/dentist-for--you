---
// src/layouts/Layout.astro
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dentist For You",
  description = "A premium dental care landing page for confident, personalized smiles.",
} = Astro.props;

import Footer from "../components/Footer.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <!-- Beautiful, glowing gradient background canvas that matches the dentist-for-you page theme -->
    <div class="canva-glow-background">
      <div class="glow-orb glow-orb-1"></div>
      <div class="glow-orb glow-orb-2"></div>
      <div class="glow-orb glow-orb-3"></div>
    </div>

    <!-- Render SiteHeader here! Housed outside `.canva-app-canvas` to guarantee true position: fixed viewport tracking -->
    <SiteHeader />

    <!-- The floating main app card housing everything -->
    <div class="canva-app-canvas">
      <slot />
      <Footer />
    </div>
    <!-- Smooth scroll for anchor links (replaces CSS scroll-behavior:smooth which causes jank) -->
    <script>
      document.addEventListener('click', (e) => {
        const target = e.target instanceof Element && e.target.closest('a[href^="#"]');
        if (!target) return;
        const id = target.getAttribute('href');
        if (!id || id === '#') return;
        const el = document.querySelector(id);
        if (!el) return;
        e.preventDefault();
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, { passive: false });
    </script>
  </body>
</html>

<style is:global>
  /* PREMIUM CANVA-LIKE APP CANVAS LAYOUT SYSTEM */
  
  html, body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    width: 100%;
    background: #edf4fc; /* Fallback baseline background */
    overflow-x: hidden;
  }

  /* 1. Viewport Glowing Background Gradient Canvas */
  .canva-glow-background {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    /* Elegant gradient reflecting luxury clinical spa aesthetic */
    background: linear-gradient(135deg, #f3f8fe 0%, #f6f3ff 50%, #effefa 100%);
    pointer-events: none;
  }

  /* 2. Floating and Drifting Orbs for Theme Glow */
  /* Use contain + will-change to isolate compositing layer & avoid full-page repaints */
  .glow-orb {
    position: absolute;
    border-radius: 50%;
    /* Reduced blur radius dramatically – main perf win */
    filter: blur(60px);
    opacity: 0.5;
    pointer-events: none;
    will-change: transform;
    contain: strict;
  }

  .glow-orb-1 {
    top: -10%;
    left: -10%;
    width: 55vw;
    height: 55vw;
    background: radial-gradient(circle, rgba(88, 179, 250, 0.22) 0%, rgba(88, 179, 250, 0) 70%);
    animation: canva-drift-1 28s ease-in-out infinite alternate;
  }

  .glow-orb-2 {
    bottom: -15%;
    right: -10%;
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.12) 0%, rgba(168, 85, 247, 0) 70%);
    animation: canva-drift-2 35s ease-in-out infinite alternate;
  }

  .glow-orb-3 {
    top: 35%;
    right: 15%;
    width: 45vw;
    height: 45vw;
    background: radial-gradient(circle, rgba(20, 184, 166, 0.10) 0%, rgba(20, 184, 166, 0) 70%);
    animation: canva-drift-3 25s ease-in-out infinite alternate-reverse;
  }

  @keyframes canva-drift-1 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(3%, 5%) scale(1.08); }
    100% { transform: translate(0, 0) scale(1); }
  }
  @keyframes canva-drift-2 {
    0% { transform: translate(0, 0) scale(1.08); }
    50% { transform: translate(-4%, -3%) scale(0.96); }
    100% { transform: translate(0, 0) scale(1.08); }
  }
  @keyframes canva-drift-3 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(4%, -4%) scale(1.12); }
    100% { transform: translate(0, 0) scale(1); }
  }

  /* 3. Rounded Floating Container Card (App Canvas) */
  .canva-app-canvas {
    position: relative;
    width: calc(100% - 48px);
    max-width: 1720px;
    margin: 24px auto;
    /* Solid bg instead of backdrop-filter – massive GPU saving */
    background: #f8fbff;
    border-radius: 32px;
    border: 1px solid rgba(226, 232, 240, 0.85);
    box-shadow: 
      0 24px 60px rgba(41, 64, 115, 0.06),
      0 4px 16px rgba(41, 64, 115, 0.01);
    min-height: calc(100vh - 48px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 10;
    /* Only transition the properties that actually change */
    transition:
      border-radius 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s ease;
  }

  /* Responsive Canvas Margins */
  @media (max-width: 1024px) {
    .canva-app-canvas {
      width: calc(100% - 32px); /* 16px padding on tablet */
      margin: 16px auto;
      min-height: calc(100vh - 32px);
      border-radius: 24px;
    }
  }

  @media (max-width: 640px) {
    .canva-app-canvas {
      width: calc(100% - 20px); /* 10px padding on mobile */
      margin: 10px auto;
      min-height: calc(100vh - 20px);
      border-radius: 20px;
    }
  }
</style>
