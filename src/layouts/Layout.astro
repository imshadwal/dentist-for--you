---
// src/layouts/Layout.astro
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dentist for you",
  description = "Gentle, personal dental care in Varanasi with Dr. Samanvaya Shukla.",
} = Astro.props;

import Footer from "../components/Footer.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WhatsAppChip from "../components/WhatsAppChip.astro";
import PageLoader from "../components/PageLoader.astro";
import Analytics from "@vercel/analytics/astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <PageLoader />
    <!-- Beautiful, glowing gradient background canvas that matches the dentist-for-you page theme -->
    <div class="canva-glow-background">
      <div class="glow-orb glow-orb-1"></div>
      <div class="glow-orb glow-orb-2"></div>
      <div class="glow-orb glow-orb-3"></div>
    </div>

    <!-- Render SiteHeader here! Housed outside `.canva-app-canvas` to guarantee true position: fixed viewport tracking -->
    <SiteHeader />

    <!-- The floating main app card housing everything -->
    <div class="canva-app-canvas">
      <slot />
      <Footer />
    </div>
    <WhatsAppChip />
    <!-- Smooth scroll for anchor links (replaces CSS scroll-behavior:smooth which causes jank) -->
    <script>
      document.addEventListener('click', (e) => {
        const target = e.target instanceof Element && e.target.closest('a[href^="#"]');
        if (!target) return;
        const id = target.getAttribute('href');
        if (!id || id === '#') return;
        const el = document.querySelector(id);
        if (!el) return;
        e.preventDefault();
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, { passive: false });
    </script>
  </body>
</html>

<style is:global>
  /* PREMIUM CANVA-LIKE APP CANVAS LAYOUT SYSTEM */
  
  html, body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    width: 100%;
    background: #fafcff; /* Clean, modern baseline background */
    overflow-x: hidden;
  }

  /* 3. Full-Width Container Card (App Canvas) */
  .canva-app-canvas {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0;
    background: transparent;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    z-index: 10;
  }
</style>
