---
// src/components/SiteHeader.astro
const navigationItems = [
  { label: "Home", href: "/" },
  { label: "About Us", href: "/about" },
  { label: "Treatments", href: "/treatments" },
  { label: "Contact Us", href: "/contact-us" },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 w-full bg-white/40 backdrop-blur-2xl border-b border-white/40 py-4 z-50 transition-all duration-300 shadow-[0_2px_24px_rgba(41,64,115,0.07)]"
>
  <div class="max-w-[1760px] mx-auto w-full px-2 sm:px-4 md:px-6 flex items-center justify-between">
    <!-- 1. Left Side: Logo Wrapper -->
    <div class="header-left flex items-center justify-start w-56 max-[760px]:w-40 transition-all duration-300">
      <a
        id="header-logo-link"
        class="inline-flex h-24 w-56 max-[760px]:w-40 items-center justify-start transition-transform duration-300"
        href="/"
        aria-label="Dentist For You home"
      >
        <img
          class="h-full w-auto object-contain object-left filter brightness-100 contrast-100 scale-125 origin-left"
          src="/images/lgo_png.png"
          alt="Dentist For You"
        />
      </a>
    </div>

    <!-- 2. Right: Navigation Links (Desktop Only) -->
    <nav
      class="header-nav hidden md:flex items-center justify-end gap-10 text-[20px] font-extrabold leading-none ml-auto"
      aria-label="Primary navigation"
    >
      {
        navigationItems.map((item) => (
          <a
            class="nav-link text-[#294073] no-underline relative py-1 px-0 transition-colors duration-300"
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- 4. Mobile Mode: Premium Hamburger Menu Toggle (Mobile Only) -->
    <div class="header-mobile-toggle flex md:hidden items-center gap-3">
      <!-- Sleek vertical line divider (fades in on scroll) -->
      <div id="header-divider" class="w-[1px] h-5 bg-slate-200 opacity-0 transition-opacity duration-300"></div>
      <button
        id="mobile-menu-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-50/60 border border-slate-200/50 text-[#294073] shadow-3xs cursor-pointer active:scale-95 transition-all backdrop-blur-md"
        aria-label="Toggle Navigation Menu"
      >
        <div class="hamburger-icon relative w-4.5 h-3 flex flex-col justify-between pointer-events-none">
          <span class="w-full h-0.5 bg-[#294073] rounded-full transition-transform"></span>
          <span class="w-full h-0.5 bg-[#294073] rounded-full transition-opacity"></span>
          <span class="w-full h-0.5 bg-[#294073] rounded-full transition-transform"></span>
        </div>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Overlay (Breathtaking Liquid Glass Dashboard) -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-[2000] opacity-0 pointer-events-none transition-all duration-500 flex flex-col justify-between p-8"
>
  <!-- Frosted backing glass layer -->
  <div class="absolute inset-0 bg-white/94 backdrop-blur-2xl -z-10"></div>
  <div class="absolute inset-0 bg-radial-gradient(circle_at_top_right,rgba(88,179,250,0.12)_0%,transparent_70%) -z-10"></div>

  <!-- Top Row -->
  <div class="flex items-center justify-between w-full">
    <img
      src="/images/lgo_png.png"
      alt="Dentist For You"
      class="h-14 w-auto object-contain"
    />
    <button
      id="mobile-menu-close"
      class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100/80 border border-slate-200/60 text-[#294073] shadow-3xs cursor-pointer active:scale-95 transition-all"
      aria-label="Close Navigation Menu"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Centered list stack of navigation links -->
  <div class="flex flex-col items-center justify-center my-auto w-full">
    <nav class="flex flex-col items-center gap-6" aria-label="Mobile navigation">
      {
        navigationItems.map((item, idx) => (
          <a
            class="mobile-nav-link text-3xl font-black text-[#294073] tracking-tight no-underline hover:text-[#2b5d9e] transition-all duration-500 opacity-0 translate-y-4"
            href={item.href}
            data-index={idx}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    
    <a
      href="#contact-us"
      id="mobile-menu-cta"
      class="mt-12 inline-flex min-h-12 items-center justify-center text-center gap-2.5 rounded-full bg-linear-to-r from-accent-blue to-card-blue px-8 text-sm font-extrabold text-white no-underline shadow-md hover:scale-[1.02] active:scale-[0.98] transition-all opacity-0 translate-y-4"
    >
      Schedule a visit
    </a>
  </div>

  <!-- Bottom credentials footer -->
  <div class="flex flex-col items-center gap-1.5 w-full text-center border-t border-slate-100 pt-6">
    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Central Jail Road, Varanasi</p>
    <p class="text-[10px] font-bold text-[#2b5d9e] tracking-wide">+91 99350 27527</p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('site-header');
    const logoLink = document.getElementById('header-logo-link');
    const divider = document.getElementById('header-divider');
    
    // Scroll contraction handler using Tailwind utility classes
    if (header) {
      const handleScroll = () => {
        if (window.scrollY > 40) {
          header.classList.add('shadow-lg', 'py-2', 'bg-white/70');
          header.classList.remove('py-4', 'bg-white/40');
          if (logoLink) logoLink.classList.add('scale-92');
          if (divider) divider.classList.remove('opacity-0');
        } else {
          header.classList.remove('shadow-lg', 'py-2', 'bg-white/70');
          header.classList.add('py-4', 'bg-white/40');
          if (logoLink) logoLink.classList.remove('scale-92');
          if (divider) divider.classList.add('opacity-0');
        }
      };
      
      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();
    }

    // Hamburger trigger handler
    const overlay = document.getElementById('mobile-menu-overlay');
    const toggle = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('mobile-menu-close');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    
    if (toggle && overlay) {
      toggle.addEventListener('click', () => {
        overlay.classList.add('mobile-menu-active');
        document.body.style.overflow = 'hidden';
        
        mobileLinks.forEach((link, idx) => {
          (link as HTMLElement).style.transitionDelay = `${idx * 0.08}s`;
        });
      });
    }

    const closeOverlay = () => {
      if (overlay) {
        overlay.classList.remove('mobile-menu-active');
        document.body.style.overflow = '';
        mobileLinks.forEach((link) => {
          (link as HTMLElement).style.transitionDelay = '0s';
        });
      }
    };

    if (closeBtn) {
      closeBtn.addEventListener('click', closeOverlay);
    }

    mobileLinks.forEach(link => {
      link.addEventListener('click', closeOverlay);
    });
  });
</script>

<style>
  /* Navigation Link hover styles */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(to right, #58b3fa, #2b5d9e);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover {
    color: #2b5d9e;
    transform: translateY(-1px);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* MOBILE OVERLAY STYLING */
  #mobile-menu-overlay.mobile-menu-active {
    opacity: 1;
    pointer-events: auto;
  }

  #mobile-menu-overlay.mobile-menu-active .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
  }

  #mobile-menu-overlay.mobile-menu-active #mobile-menu-cta {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.5s ease 0.35s, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.35s;
  }
</style>
