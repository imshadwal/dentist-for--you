---
const fieldClass =
  "mt-2 w-full rounded-xl border border-[#d6e6fb] bg-[#f8fbff] px-4 py-3 text-base font-semibold text-heading placeholder:text-muted focus:border-card-blue focus:outline-none focus:ring-2 focus:ring-accent-blue/30";
---

<section
  class="mx-auto w-full max-w-[1760px] px-4 sm:px-5 md:px-8 py-8 md:py-10"
  id="contact-form-section"
  aria-labelledby="form-title"
>
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] overflow-hidden rounded-[28px] border border-[#d6e6fb] bg-white shadow-[0_18px_40px_rgba(31,63,117,0.08)]">
    <div class="relative flex min-h-[320px] flex-col justify-between overflow-hidden">
      <img
        class="absolute inset-0 h-full w-full object-cover"
        src="/images/photoshoot/IMG_6774.jpg"
        alt="Dentist for you clinic"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-linear-to-t from-card-blue via-card-blue/80 to-card-blue/45"></div>
      <div class="relative z-10 flex h-full flex-col justify-between gap-10 p-8 sm:p-10 lg:p-12">
        <div>
          <p class="m-0 text-base font-semibold uppercase tracking-[0.14em]" style="color: #fff">
            Get in touch
          </p>
          <h1
            id="form-title"
            class="mt-3 max-w-md text-[clamp(32px,3.6vw,48px)] font-extrabold leading-[1.15]"
            style="color: #fff"
          >
            Let’s start with a conversation
          </h1>
          <p class="mt-4 max-w-md text-lg leading-relaxed" style="color: #e8eef8">
            Fill in the form and we’ll reply on WhatsApp. Or call if you’d rather talk now.
          </p>
        </div>

        <ul class="m-0 flex list-none flex-col gap-3 p-0 text-base font-semibold" style="color: #fff">
          <li>
            <a class="hover:underline" href="tel:+919935027027" style="color: #fff">+91 99350 27027</a>
          </li>
          <li>
            <a class="hover:underline" href="mailto:dentist4ushukla@gmail.com" style="color: #fff">
              dentist4ushukla@gmail.com
            </a>
          </li>
          <li>Mon–Sat: 10:30–2, 6–9 · Sun closed</li>
          <li>Central Jail Road, opp. Varuna Garden, Varanasi</li>
        </ul>
      </div>
    </div>

    <div class="p-6 sm:p-8 lg:p-10">
      <form id="clinic-contact-form" class="flex flex-col gap-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <label class="block text-base font-semibold text-heading" for="name">
            Full name *
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Your full name"
              class={fieldClass}
            />
          </label>
          <label class="block text-base font-semibold text-heading" for="email">
            Email *
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@email.com"
              class={fieldClass}
            />
          </label>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <label class="block text-base font-semibold text-heading" for="phone">
            Phone
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              placeholder="+91"
              class={fieldClass}
            />
          </label>
          <label class="relative block text-base font-semibold text-heading" for="service">
            Service *
            <select id="service" name="service" required class={`${fieldClass} appearance-none pr-10`}>
              <option value="">Choose a treatment</option>
              <option value="Pain Relief">Pain Relief</option>
              <option value="Teeth Replacement">Teeth Replacement</option>
              <option value="Cosmetic Dentistry">Cosmetic Dentistry</option>
              <option value="Preventive Dentistry">Preventive Dentistry</option>
              <option value="Kids Dentistry">Kids Dentistry</option>
              <option value="Other">Other</option>
            </select>
          </label>
        </div>

        <label class="block text-base font-semibold text-heading" for="message">
          Message *
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            placeholder="What would you like help with?"
            class={`${fieldClass} resize-none font-sans`}
          ></textarea>
        </label>

        <label class="flex items-start gap-3 text-base text-body" for="consent">
          <input
            id="consent"
            name="consent"
            type="checkbox"
            required
            class="mt-1 rounded border-[#d6e6fb] accent-card-blue"
          />
          I agree to be contacted about this inquiry by Dentist for you.
        </label>

        <button
          type="submit"
          class="inline-flex min-h-14 items-center justify-center rounded-full bg-linear-to-r from-accent-blue to-card-blue px-7 text-base font-extrabold text-white border-0 cursor-pointer shadow-[0_18px_34px_rgba(43,93,158,0.26)] transition duration-200 hover:-translate-y-0.5"
        >
          Send on WhatsApp
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById("clinic-contact-form") as HTMLFormElement | null;
  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(contactForm);
    const name = String(data.get("name") || "").trim();
    const email = String(data.get("email") || "").trim();
    const phone = String(data.get("phone") || "Not provided").trim();
    const service = String(data.get("service") || "Not specified");
    const message = String(data.get("message") || "").trim();
    const text = `Hello, I would like to get in touch.\nName: ${name}\nEmail: ${email}\nPhone: ${phone}\nService: ${service}\nMessage: ${message}`;
    window.open(`https://wa.me/919935027027?text=${encodeURIComponent(text)}`, "_blank");
  });
</script>
