---
const year = new Date().getFullYear();
---

<footer class="bg-[#294073] text-white">
  <div class="max-w-[1760px] mx-auto px-2 sm:px-4 md:px-6 py-8">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">
      <div class="flex flex-col sm:flex-row sm:items-start gap-8">
      <a href="/" class="inline-flex shrink-0 self-start rounded-xl bg-white px-2 py-1.5">
        <img
          src="/images/lgo_png.png"
          alt="Dentist for u"
          class="h-14 w-auto object-contain"
        />
      </a>

      <div class="text-sm md:text-left">
        <h3 class="!text-white font-bold tracking-[0.18em] text-xs mb-3">EXPLORE</h3>
        <nav aria-label="Footer">
          <ul class="flex flex-col gap-2 font-semibold">
            <li>
              <a class="text-white hover:text-[#58b3fa] transition-colors" href="/about">About us</a>
            </li>
            <li>
              <a class="text-white hover:text-[#58b3fa] transition-colors" href="/treatments">Services</a>
            </li>
            <li>
              <a class="text-white hover:text-[#58b3fa] transition-colors" href="/about#meet-team">Specialists</a>
            </li>
            <li>
              <a class="text-white hover:text-[#58b3fa] transition-colors" href="/contact-us">Contact Us</a>
            </li>
            <li>
              <a class="text-white hover:text-[#58b3fa] transition-colors" href="/#testimonials">Testimonials</a>
            </li>
          </ul>
        </nav>
      </div>
      </div>

      <div class="text-sm md:text-center">
        <h3 class="!text-white font-bold tracking-[0.18em] text-xs mb-3">CONTACT US</h3>
        <p class="!text-white">
          <a class="text-white hover:text-[#58b3fa] transition-colors" href="tel:+919935027027">+91 99350 27027</a>
        </p>
        <p class="!text-white mt-1.5">
          <a class="text-white hover:text-[#58b3fa] transition-colors" href="mailto:hello@dentalforyou.com">hello@dentalforyou.com</a>
        </p>
        <p class="!text-white mt-1.5 leading-relaxed md:mx-auto max-w-56">
          <a
            class="text-white hover:text-[#58b3fa] transition-colors"
            href="https://maps.app.goo.gl/42Bx53rT6SRn2Ko5A"
            target="_blank"
            rel="noopener noreferrer"
          >Central Jail Road, opp. Varuna Garden, Varanasi</a>
        </p>
      </div>

      <div class="text-sm md:text-right">
        <h3 class="!text-white font-bold tracking-[0.18em] text-xs mb-3">VISIT HOURS</h3>
        <p class="!text-white">Mon–Sat Morning: 10:30 AM – 2:00 PM</p>
        <p class="!text-white mt-1">Mon–Sat Evening: 6:00 PM – 9:00 PM</p>
        <p class="!text-white mt-1">Sun: Closed</p>

        <h3 class="!text-white font-bold tracking-[0.18em] text-xs mt-5 mb-3">FOLLOW US</h3>
        <ul class="flex items-center gap-3 md:justify-end">
          <li>
            <a
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 text-white hover:bg-white hover:text-[#294073] transition-colors"
              href="https://www.instagram.com/dentistforyou_/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5A4.25 4.25 0 0 0 20.5 16.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7ZM17.5 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 text-white hover:bg-white hover:text-[#294073] transition-colors"
              href="https://www.facebook.com/profile.php?id=61591899643189"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.5 22v-8.2h2.76l.41-3.2H13.5V8.56c0-.93.26-1.56 1.59-1.56h1.7V4.14A22.9 22.9 0 0 0 14.3 4C11.9 4 10.25 5.47 10.25 8.24v2.36H7.6v3.2h2.65V22h3.25Z"></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-6 pt-4 border-t border-white/25 text-xs flex flex-col md:flex-row md:justify-between gap-3">
      <div class="!text-white">© {year} Dentist for u</div>
      <div class="flex flex-wrap gap-4">
        <a class="text-white/90 underline hover:text-white" href="#">Privacy policy</a>
        <a class="text-white/90 underline hover:text-white" href="#">Terms of service</a>
        <a class="text-white/90 underline hover:text-white" href="#">Cookie policy</a>
        <a class="text-white/90 underline hover:text-white" href="#">Patient consent & disclaimer</a>
      </div>
    </div>
  </div>
</footer>
