---
const year = new Date().getFullYear();
---

<footer class="bg-[#3f70ae] text-white">
  <div class="max-w-[1760px] mx-auto px-2 sm:px-4 md:px-6 py-12">
    <div
      class="flex flex-col md:flex-row md:items-start md:justify-between gap-10"
    >
      <div class="md:w-1/3 flex items-center">
        <a href="/" class="flex items-center gap-3">
          <img
            src="/images/logo.png"
            alt="Dental for you"
            class="h-24 w-auto"
          />
        </a>

        <nav>
          <ul class="flex flex-wrap gap-4 text-sm">
            <li>
              <a class="opacity-90 hover:underline" href="/about-us">About us</a
              >
            </li>
            <li>
              <a class="opacity-90 hover:underline" href="/treatments"
                >Services</a
              >
            </li>
            <li>
              <a class="opacity-90 hover:underline" href="/treatments"
                >Specialists</a
              >
            </li>
            <li>
              <a class="opacity-90 hover:underline" href="/contact-us"
                >Contact Us</a
              >
            </li>
            <li>
              <a class="opacity-90 hover:underline" href="/#testimonials"
                >Testimonials</a
              >
            </li>
          </ul>
        </nav>
      </div>

      <div class="md:w-2/3 grid grid-cols-1 sm:grid-cols-2 gap-8 text-sm">
        <div>
          <h3 class="font-semibold mb-3">CONTACT US</h3>
          <p class="opacity-90">+91 99350 27527</p>
          <p class="opacity-90">hello@dentalforyou.com</p>
          <p class="mt-2 opacity-90">Central Jail Road, opp. Varuna Garden, Varanasi</p>
        </div>

        <div>
          <h3 class="font-semibold mb-3">VISIT HOURS</h3>
          <p class="opacity-90">Mon–Sat Morning: 10:30 AM – 2:00 PM</p>
          <p class="opacity-90">Mon–Sat Evening: 6:00 PM – 9:00 PM</p>
          <p class="opacity-90">Sun: Closed</p>

          <div class="mt-4">
            <h4 class="font-semibold mb-2">FOLLOW US</h4>
            <ul class="flex gap-4">
              <li>
                <a class="opacity-90 hover:underline" href="#">Instagram</a>
              </li>
              <li>
                <a class="opacity-90 hover:underline" href="#">Facebook</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div
      class="mt-8 pt-6 text-xs flex flex-col md:flex-row md:justify-between gap-4"
    >
      <div class="opacity-90">© {year} Dental for you</div>
      <div class="flex flex-wrap gap-4">
        <a class="opacity-90 underline" href="#">Privacy policy</a>
        <a class="opacity-90 underline" href="#">Terms of service</a>
        <a class="opacity-90 underline" href="#">Cookie policy</a>
        <a class="opacity-90 underline" href="#">Patient consent & disclaimer</a
        >
      </div>
    </div>
  </div>
</footer>
