---
const year = new Date().getFullYear();
---

<footer class="bg-[#294073] text-white rounded-t-3xl overflow-hidden">
  <div class="max-w-[1760px] mx-auto px-2 sm:px-4 md:px-6 py-6 md:py-7">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <a href="/" class="inline-flex flex-col items-start gap-0.5 min-w-0">
        <img
          src="/images/footer-logo.png"
          alt="Dentist for you"
          class="h-14 w-auto object-contain object-left"
        />
        <span class="text-sm text-white/65 pl-0.5">Gentle care, every visit</span>
      </a>

      <a
        href="/contact-us"
        class="inline-flex h-11 shrink-0 items-center justify-center rounded-xl bg-white px-5 text-sm font-extrabold text-[#294073] no-underline hover:bg-white/90 transition-colors"
      >
        Book an appointment
      </a>
    </div>

    <div class="mt-6 pt-6 border-t border-white/15 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.5fr)_minmax(0,1fr)] gap-6 lg:gap-8">
      <div>
        <h3 class="!text-white/55 font-bold tracking-[0.18em] text-[11px] mb-3">EXPLORE</h3>
        <nav aria-label="Footer">
          <ul class="flex flex-col gap-2.5 text-sm">
            <li>
              <a class="font-medium text-white hover:text-[#58b3fa] transition-colors" href="/about">About us</a>
            </li>
            <li>
              <a class="font-medium text-white hover:text-[#58b3fa] transition-colors" href="/treatments">Services</a>
            </li>
            <li>
              <a class="font-medium text-white hover:text-[#58b3fa] transition-colors" href="/about#meet-team">Specialists</a>
            </li>
            <li>
              <a class="font-medium text-white hover:text-[#58b3fa] transition-colors" href="/#testimonials">Testimonials</a>
            </li>
          </ul>
        </nav>
      </div>

      <div>
        <h3 class="!text-white/55 font-bold tracking-[0.18em] text-[11px] mb-3">CONTACT US</h3>
        <ul class="flex flex-col gap-3 text-sm">
          <li>
            <a class="inline-flex items-start gap-2.5 font-medium text-white hover:text-[#58b3fa] transition-colors" href="tel:+919935027027">
              <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
              +91 99350 27027
            </a>
          </li>
          <li>
            <a class="inline-flex items-start gap-2.5 font-medium text-white hover:text-[#58b3fa] transition-colors" href="mailto:hello@dentalforyou.com">
              <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
              hello@dentalforyou.com
            </a>
          </li>
          <li>
            <a
              class="inline-flex items-start gap-2.5 font-medium text-white hover:text-[#58b3fa] transition-colors"
              href="https://maps.app.goo.gl/42Bx53rT6SRn2Ko5A"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
              <span>Central Jail Road,<br />opp. Varuna Garden, Varanasi</span>
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="!text-white/55 font-bold tracking-[0.18em] text-[11px] mb-3">VISIT HOURS</h3>
        <ul class="flex flex-col gap-3 text-sm">
          <li class="inline-flex items-start gap-2.5 !text-white">
            <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span>
              Mon–Sat: 10:30–2, 6–9
              <span class="block mt-1">Sun: Closed</span>
            </span>
          </li>
        </ul>

        <h3 class="!text-white/55 font-bold tracking-[0.18em] text-[11px] mt-4 mb-2.5">FOLLOW US</h3>
        <ul class="flex items-center gap-3">
          <li>
            <a
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 text-white hover:bg-white hover:text-[#294073] transition-colors"
              href="https://www.instagram.com/dentistforyou_/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5A4.25 4.25 0 0 0 20.5 16.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7ZM17.5 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 text-white hover:bg-white hover:text-[#294073] transition-colors"
              href="https://www.facebook.com/profile.php?id=61591899643189"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.5 22v-8.2h2.76l.41-3.2H13.5V8.56c0-.93.26-1.56 1.59-1.56h1.7V4.14A22.9 22.9 0 0 0 14.3 4C11.9 4 10.25 5.47 10.25 8.24v2.36H7.6v3.2h2.65V22h3.25Z"></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-6 pt-4 border-t border-white/15 text-xs flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <div class="text-white/55">© {year} Dentist for you</div>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a class="font-medium text-white hover:text-[#58b3fa] transition-colors" href="/privacy-policy">Privacy policy</a>
        <a class="font-medium text-white hover:text-[#58b3fa] transition-colors" href="/terms-of-service">Terms of service</a>
        <a class="font-medium text-white hover:text-[#58b3fa] transition-colors" href="/cookie-policy">Cookie policy</a>
        <a class="font-medium text-white hover:text-[#58b3fa] transition-colors" href="/patient-consent">Patient consent</a>
      </div>
    </div>
  </div>
</footer>
