---

---

<section
  class="relative mx-auto w-[calc(100%-32px)] max-w-460 min-h-[calc(100svh-140px)] grid items-center pt-[clamp(40px,8vw,80px)] pb-[clamp(40px,8vw,80px)] max-[620px]:w-[calc(100%-28px)]"
  id="contact-hero"
  aria-labelledby="contact-hero-title"
>
  <div
    class="grid grid-cols-2 gap-[clamp(24px,4vw,60px)] items-center max-[980px]:grid-cols-1 max-[980px]:gap-8"
  >
    <!-- Left: Content -->
    <div class="flex flex-col justify-center">
      <p
        class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase"
      >
        Get In Touch
      </p>
      <h1
        id="contact-hero-title"
        class="mt-3 text-[clamp(42px,5vw,72px)] font-extrabold leading-[1.02] text-heading max-[620px]:text-[clamp(36px,10vw,56px)]"
      >
        Let's create your perfect smile
      </h1>
      <p
        class="mt-6 text-[clamp(15px,1.05vw,18px)] leading-normal text-heading/80 max-w-140"
      >
        Have questions about your treatment? Ready to schedule? Our friendly
        team is here to help you every step of the way.
      </p>

      <div class="mt-10 space-y-4">
        <a class="flex items-start gap-4 group" href="tel:+919935027527">
          <div class="flex-shrink-0 mt-1">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-lg bg-linear-to-br from-accent-blue to-card-blue text-white"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M3 8.5c0-1.1.9-2 2-2h3.97c.5 0 .98.2 1.33.55l2.97 2.97c.63.63.63 1.65 0 2.28l-1.42 1.42c-.37.37-.58.88-.58 1.41 0 .53.21 1.04.58 1.41l1.41 1.41c.63.63.63 1.65 0 2.28l-2.97 2.97c-.35.35-.83.55-1.33.55H5c-1.1 0-2-.9-2-2V8.5z"
                ></path>
              </svg>
            </div>
          </div>
          <div class="flex-grow">
            <p
              class="text-sm font-semibold text-heading group-hover:text-card-blue transition-colors"
            >
              Call us
            </p>
            <p class="text-[13px] text-heading/70">+91 99350 27527</p>
          </div>
        </a>

        <a
          class="flex items-start gap-4 group"
          href="mailto:hello@dentalforyou.com"
        >
          <div class="flex-shrink-0 mt-1">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-lg bg-linear-to-br from-accent-blue to-card-blue text-white"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                ></path>
              </svg>
            </div>
          </div>
          <div class="flex-grow">
            <p
              class="text-sm font-semibold text-heading group-hover:text-card-blue transition-colors"
            >
              Email us
            </p>
            <p class="text-[13px] text-heading/70">hello@dentalforyou.com</p>
          </div>
        </a>

        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 mt-1">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-lg bg-linear-to-br from-accent-blue to-card-blue text-white"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                ></path>
              </svg>
            </div>
          </div>
          <div class="flex-grow">
            <p class="text-sm font-semibold text-heading">Hours</p>
            <p class="text-[13px] text-heading/70">
              Mon–Sat Morning: 10:30 AM – 2:00 PM
            </p>
            <p class="text-[13px] text-heading/70">
              Mon–Sat Evening: 6:00 PM – 9:00 PM
            </p>
            <p class="text-[13px] text-heading/70">Sun: Closed</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Visual Element -->
    <div
      class="relative flex items-center justify-center h-100 max-[980px]:h-75 max-[620px]:h-70"
      aria-hidden="true"
    >
      <div class="absolute inset-0 rounded-3xl overflow-hidden shadow-xs border border-slate-100/50">
        <img
          class="h-full w-full object-cover transition-transform duration-700 ease-out hover:scale-103"
          src="/images/photoshoot/IMG_6774.jpg"
          alt="Dentist For You Reception Lobby"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
