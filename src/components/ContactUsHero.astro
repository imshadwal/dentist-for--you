---
const whatsappHref =
  "https://wa.me/919935027027?text=" +
  encodeURIComponent("Hello, I would like to book a visit at Dentist for you.");
---

<section
  class="mx-auto w-full max-w-[1760px] px-4 sm:px-5 md:px-8 pt-8 pb-10 md:pt-10 md:pb-12"
  id="contact-hero"
  aria-labelledby="contact-hero-title"
>
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] overflow-hidden rounded-[28px] border border-[#d6e6fb] bg-white shadow-[0_18px_40px_rgba(31,63,117,0.08)]">
    <div class="relative min-h-[240px] lg:min-h-[420px]">
      <img
        class="absolute inset-0 h-full w-full object-cover"
        src="/images/photoshoot/IMG_6774.jpg"
        alt="Dentist for you clinic"
        loading="lazy"
      />
    </div>

    <div class="flex flex-col justify-center gap-6 p-8 sm:p-10 lg:p-12">
      <div>
        <p class="eyebrow">Get in touch</p>
        <h1
          id="contact-hero-title"
          class="mt-3 text-[clamp(32px,3.6vw,48px)] font-extrabold leading-[1.15] text-heading"
        >
          Let’s start with a conversation
        </h1>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-body">
          Questions about treatment, timing, or a first visit — message us and we’ll reply on WhatsApp.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-12 items-center justify-center rounded-full bg-linear-to-r from-accent-blue to-card-blue px-6 text-base font-extrabold text-white no-underline shadow-[0_12px_24px_rgba(43,93,158,0.24)]"
        >
          Chat on WhatsApp
        </a>
        <a
          href="tel:+919935027027"
          class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#d6e6fb] px-6 text-base font-extrabold text-heading no-underline hover:border-card-blue"
        >
          Call +91 99350 27027
        </a>
      </div>
    </div>
  </div>
</section>
