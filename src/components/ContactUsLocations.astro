---
const mapsUrl = "https://maps.app.goo.gl/42Bx53rT6SRn2Ko5A";
const mapsEmbed =
  "https://maps.google.com/maps?q=Central+Jail+Road+opp.+Varuna+Garden+Varanasi&z=16&output=embed";
---

<section
  class="mx-auto w-full max-w-[1760px] px-4 sm:px-5 md:px-8 pt-8 pb-20 md:pt-10 md:pb-28"
  id="office-locations"
  aria-labelledby="locations-title"
>
  <div class="overflow-hidden rounded-[28px] border border-[#d6e6fb] bg-white shadow-[0_18px_40px_rgba(31,63,117,0.08)]">
    <div class="grid grid-cols-1 lg:grid-cols-2 items-stretch">
      <div class="flex flex-col justify-between gap-8 p-8 sm:p-10 lg:p-12">
        <div>
          <p class="eyebrow">Visit us</p>
          <h2
            id="locations-title"
            class="mt-3 text-[clamp(32px,3.6vw,48px)] font-extrabold leading-[1.15] text-heading"
          >
            Our clinic
          </h2>
          <p class="mt-3 max-w-md text-lg leading-relaxed text-body">
            One practice on Central Jail Road. Walk in during hours, or message before you come.
          </p>
        </div>

        <dl class="m-0 grid gap-5 text-base">
          <div>
            <dt class="font-bold text-card-blue">Address</dt>
            <dd class="mt-1 font-semibold text-heading">
              Central Jail Road, opp. Varuna Garden<br />Varanasi
            </dd>
          </div>
          <div>
            <dt class="font-bold text-card-blue">Hours</dt>
            <dd class="mt-1 font-semibold text-heading">
              Mon–Sat: 10:30–2, 6–9<br />Sun: Closed
            </dd>
          </div>
          <div>
            <dt class="font-bold text-card-blue">Contact</dt>
            <dd class="mt-1 flex flex-col gap-1 font-semibold text-heading">
              <a class="text-heading no-underline hover:text-card-blue" href="tel:+919935027027">
                +91 99350 27027
              </a>
              <a class="text-heading no-underline hover:text-card-blue" href="mailto:dentist4ushukla@gmail.com">
                dentist4ushukla@gmail.com
              </a>
            </dd>
          </div>
        </dl>

        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-12 w-fit items-center justify-center rounded-full bg-card-blue px-6 text-base font-extrabold text-white no-underline hover:brightness-110"
        >
          Open in Maps
        </a>
      </div>

      <div class="min-h-[280px] lg:min-h-[480px] border-t lg:border-t-0 lg:border-l border-[#d6e6fb]">
        <iframe
          title="Dentist for you on Google Maps"
          class="h-full w-full min-h-[280px] lg:min-h-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src={mapsEmbed}
        ></iframe>
      </div>
    </div>
  </div>
</section>
