---
const milestones = [
  {
    year: "2008",
    title: "The Beginning",
    description: "Founded with a singular vision: to revolutionize dental care through innovation and human-centered design.",
    icon: "✨"
  },
  {
    year: "2012",
    title: "Recognition",
    description: "Awarded Best Aesthetic Dentistry Practice by the International Dental Association.",
    icon: "🏆"
  },
  {
    year: "2017",
    title: "Expansion",
    description: "Opened our state-of-the-art facility featuring cutting-edge CEREC technology and comfort-first treatment rooms.",
    icon: "🚀"
  },
  {
    year: "2023",
    title: "Community",
    description: "Reached 5,000+ transformed smiles and established the Smile Forward scholarship program.",
    icon: "❤️"
  },
];
---

<section
  class="mx-auto w-[calc(100%-32px)] max-w-460 py-[clamp(40px,8vw,100px)] max-[620px]:w-[calc(100%-28px)]"
  id="our-journey"
  aria-labelledby="journey-title"
>
  <div class="text-center mb-[clamp(40px,6vw,80px)]">
    <p class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase">
      Our Evolution
    </p>
    <h2
      id="journey-title"
      class="mt-3 text-[clamp(36px,4.4vw,56px)] font-extrabold leading-[1.05] text-heading"
    >
      A timeline of passion
    </h2>
  </div>

  <!-- Timeline -->
  <div class="relative">
    <!-- Vertical line on desktop, hidden on mobile -->
    <div
      class="absolute left-1/2 top-0 bottom-0 w-0.5 bg-linear-to-b from-accent-blue via-card-blue to-accent-blue/30 transform -translate-x-1/2 max-[800px]:hidden"
      aria-hidden="true"
    ></div>

    <!-- Timeline items -->
    <div class="space-y-[clamp(40px,6vw,80px)] max-[800px]:space-y-8">
      {
        milestones.map((milestone, index) => (
          <div
            data-timeline-item
            class="grid grid-cols-[1fr_auto_1fr] gap-[clamp(20px,3vw,40px)] items-center max-[800px]:grid-cols-1 max-[800px]:gap-4 transition-all duration-700 timeline-row"
          >
            <!-- Left content (alternate) -->
            <div
              class={`${
                index % 2 === 0 ? "text-right" : "max-[800px]:order-2"
              } max-[800px]:text-left`}
            >
              <div
                class={`timeline-text-container ${
                  index % 2 === 0
                    ? "max-[800px]:hidden"
                    : "max-[800px]:block hidden"
                }`}
              >
                <p class="text-[13px] font-bold tracking-[0.32em] text-card-blue/60 uppercase">
                  {milestone.year}
                </p>
                <h3 class="mt-2 text-[clamp(22px,2vw,28px)] font-extrabold text-heading">
                  {milestone.title}
                </h3>
                <p class="mt-2 text-[14px] leading-[1.4] text-heading/70 max-w-140 ml-auto max-[800px]:ml-0">
                  {milestone.description}
                </p>
              </div>
            </div>

            <!-- Center dot -->
            <div class="flex flex-col items-center max-[800px]:order-1">
              <div class="relative flex h-16 w-16 items-center justify-center">
                <div class="timeline-glow" aria-hidden="true"></div>
                <div class="timeline-dot">
                  <span class="timeline-icon">{milestone.icon}</span>
                </div>
              </div>
            </div>

            <!-- Right content -->
            <div
              class={`${
                index % 2 === 1 ? "text-left" : "max-[800px]:order-2 hidden max-[800px]:block"
              } max-[800px]:text-left`}
            >
              <div
                class={`timeline-text-container ${
                  index % 2 === 1
                    ? "max-[800px]:hidden"
                    : "max-[800px]:block hidden"
                }`}
              >
                <p class="text-[13px] font-bold tracking-[0.32em] text-card-blue/60 uppercase">
                  {milestone.year}
                </p>
                <h3 class="mt-2 text-[clamp(22px,2vw,28px)] font-extrabold text-heading">
                  {milestone.title}
                </h3>
                <p class="mt-2 text-[14px] leading-[1.4] text-heading/70 max-w-140">
                  {milestone.description}
                </p>
              </div>
            </div>

            <!-- Mobile timeline info -->
            <div class="timeline-text-container max-[800px]:col-span-3 max-[800px]:order-3 hidden max-[800px]:block">
              <p class="text-[13px] font-bold tracking-[0.32em] text-card-blue/60 uppercase">
                {milestone.year}
              </p>
              <h3 class="mt-2 text-[22px] font-extrabold text-heading">
                {milestone.title}
              </h3>
              <p class="mt-2 text-[14px] leading-[1.4] text-heading/70">
                {milestone.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const timelineItems = document.querySelectorAll("[data-timeline-item]");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-active");
        } else {
          entry.target.classList.remove("is-active");
        }
      });
    },
    {
      rootMargin: "-25% 0px -25% 0px",
      threshold: 0.1,
    }
  );

  timelineItems.forEach((item) => observer.observe(item));
</script>

<style>
  .timeline-row {
    opacity: 0.4;
    filter: grayscale(30%);
    transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-row.is-active {
    opacity: 1;
    filter: grayscale(0%);
  }

  .timeline-glow {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: linear-gradient(135deg, rgba(88, 179, 250, 0.15) 0%, rgba(43, 93, 158, 0.15) 100%);
    transform: scale(0.85);
    opacity: 0.2;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .is-active .timeline-glow {
    transform: scale(1.3);
    opacity: 1;
    background: linear-gradient(135deg, rgba(88, 179, 250, 0.45) 0%, rgba(43, 93, 158, 0.45) 100%);
    box-shadow: 0 0 25px rgba(88, 179, 250, 0.4);
    animation: timeline-pulse 2s infinite alternate ease-in-out;
  }

  .timeline-dot {
    position: relative;
    display: flex;
    height: 48px;
    width: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-color: #fff;
    border: 2px solid var(--color-card-blue);
    box-shadow: 0 8px 16px rgba(43, 93, 158, 0.15);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 10;
  }

  .is-active .timeline-dot {
    border-color: var(--color-accent-blue);
    background: linear-gradient(135deg, #fff 0%, #f0f7ff 100%);
    transform: scale(1.18);
    box-shadow: 0 12px 24px rgba(88, 179, 250, 0.35);
  }

  .timeline-icon {
    font-size: 20px;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .is-active .timeline-icon {
    transform: scale(1.22) rotate(8deg);
  }

  .timeline-text-container {
    transform: translateY(10px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .is-active .timeline-text-container {
    transform: translateY(0);
  }

  @keyframes timeline-pulse {
    0% {
      transform: scale(1.2);
      box-shadow: 0 0 20px rgba(88, 179, 250, 0.35);
    }
    100% {
      transform: scale(1.4);
      box-shadow: 0 0 35px rgba(43, 93, 158, 0.65);
    }
  }
</style>
