---
const features = [
  {
    title: "Modern diagnostics",
    description:
      "Careful exams and contemporary tools so treatment is planned before it starts — not guessed in the chair.",
  },
  {
    title: "Principal-led care",
    description:
      "Every visit is directed by Dr. Samanvaya Shukla, with two decades of family dentistry and orthodontics.",
  },
  {
    title: "Comfort first",
    description:
      "Unhurried appointments, clear explanations, and a calm clinic — so you know what happens next.",
  },
  {
    title: "Plans that fit you",
    description:
      "No template pathway. Treatment is mapped to your teeth, timeline, and what you actually want to change.",
  },
  {
    title: "Clear next steps",
    description:
      "You leave knowing the plan, the visits involved, and how to reach us if something feels off.",
  },
  {
    title: "We stand by the work",
    description:
      "Major procedures are followed through. If something needs attention after treatment, we take it seriously.",
  },
];
---

<section
  class="mx-auto w-full max-w-[1760px] px-4 sm:px-5 md:px-8 py-20 md:py-28"
  id="treatment-guarantees"
  aria-labelledby="guarantees-title"
>
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">
    <div class="max-w-xl">
      <p class="eyebrow">How we work</p>
      <h2
        id="guarantees-title"
        class="mt-3 text-[clamp(32px,4vw,52px)] font-extrabold leading-[1.18] text-heading tracking-tight"
      >
        Our promises to you
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-body">
        What you can expect from a one-doctor clinic that knows your smile.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {
      features.map((feature, idx) => (
        <article class="flex flex-col gap-3 rounded-[28px] border border-[#d6e6fb] bg-white p-7 sm:p-8 shadow-[0_12px_32px_rgba(31,63,117,0.06)]">
          <p class="m-0 text-base font-extrabold tabular-nums tracking-tight text-card-blue">
            {String(idx + 1).padStart(2, "0")}
          </p>
          <h3 class="m-0 text-xl font-extrabold leading-snug text-heading">{feature.title}</h3>
          <p class="m-0 text-base leading-relaxed text-body">{feature.description}</p>
        </article>
      ))
    }
  </div>
</section>
