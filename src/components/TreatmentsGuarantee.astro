---
// src/components/TreatmentsGuarantee.astro
const features = [
  {
    id: "advanced-tech",
    title: "Advanced Tech",
    tagline: "Standard-setting clinical gear",
    description: "Equipped with state-of-the-art diagnostic tools, 3D intraoral scanners, and soft-tissue lasers to ensure high surgical precision and comfortable recovery.",
    icon: "🔬",
    color: "from-blue-500 to-cyan-500",
    glowColor: "shadow-blue-100/50 bg-blue-500/10",
    image: "/images/treatments/3d_technology.png",
  },
  {
    id: "expert-specs",
    title: "Expert Specialists",
    tagline: "Board-certified clinical mastery",
    description: "Every treatment is directed by a dedicated board-certified specialist with extensive fellowship training and standard-setting clinical experience.",
    icon: "👨‍⚕️",
    color: "from-indigo-500 to-purple-500",
    glowColor: "shadow-indigo-100/50 bg-indigo-500/10",
    image: "/images/treatments/3d_specialists.png",
  },
  {
    id: "pain-free",
    title: "Pain-Free Care",
    tagline: "Sanctuary of clinical comfort",
    description: "Our comfort pathways combine gentle manual techniques, modern sedation options, and aromatherapy to completely eliminate treatment anxiety.",
    icon: "😌",
    color: "from-teal-500 to-emerald-500",
    glowColor: "shadow-teal-100/50 bg-teal-500/10",
    image: "/images/treatments/3d_pain_free.png",
  },
  {
    id: "custom-plans",
    title: "Customized Plans",
    tagline: "Pathways built for your timeline",
    description: "No templates. We design custom treatment plans fully mapped to your specific jaw structure, aesthetic goals, comfort choices, and schedule.",
    icon: "📋",
    color: "from-amber-500 to-orange-500",
    glowColor: "shadow-amber-100/50 bg-amber-500/10",
    image: "/images/treatments/3d_plans.png",
  },
  {
    id: "fast-results",
    title: "Fast Results",
    tagline: "Shorter timelines, high accuracy",
    description: "Leveraging 3D printing and digital setups to deliver extremely fast, precise treatments with significantly minimized healing downtime.",
    icon: "⚡",
    color: "from-rose-500 to-pink-500",
    glowColor: "shadow-rose-100/50 bg-rose-500/10",
    image: "/images/treatments/3d_fast_results.png",
  },
  {
    id: "warranty-guar",
    title: "Warranty Policy",
    tagline: "Standing behind our artistry",
    description: "We are committed to delivering standard-setting clinical longevity. Every major procedure is backed by our comprehensive warranty policy.",
    icon: "✅",
    color: "from-emerald-500 to-sky-500",
    glowColor: "shadow-emerald-100/50 bg-emerald-500/10",
    image: "/images/treatments/3d_warranty.png",
  },
];
---

<section
  class="mx-auto w-[calc(100%-32px)] max-w-460 py-[clamp(60px,10vw,120px)] max-[620px]:w-[calc(100%-28px)] overflow-visible"
  id="treatment-guarantees"
  aria-labelledby="guarantees-title"
>
  <div class="text-center mb-24 max-[620px]:mb-16">
    <p class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase">
      Treatment Excellence
    </p>
    <h2
      id="guarantees-title"
      class="mt-3 text-[clamp(36px,4vw,60px)] font-extrabold leading-[1.05] text-heading tracking-tight"
    >
      What makes our treatments exceptional
    </h2>
    <p class="mx-auto mt-4 max-w-lg text-sm md:text-base text-heading/70 leading-relaxed">
      Discover our foundational promises, engineered to merge clinical mastery with standard-setting patient care.
    </p>
  </div>

  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-24">
    {
      features.map((feature, idx) => (
        <div
          class="reveal-text-block text-center flex flex-col items-center"
          data-reveal-block
        >
          <!-- Badge -->
          <span class="text-[11px] font-bold tracking-[0.25em] text-accent-blue/85 uppercase">
            Promise 0{idx + 1}
          </span>
          
          <!-- Icon + Title -->
          <div class="flex items-center justify-center gap-3 mt-4">
            <span class="text-2xl md:text-3xl">{feature.icon}</span>
            <h3 class="text-[clamp(24px,2.5vw,36px)] font-extrabold text-heading tracking-tight leading-tight transition-colors duration-500">
              {feature.title}
            </h3>
          </div>

          <!-- Tagline -->
          <p class="mt-2 text-sm md:text-base font-bold text-slate-500 tracking-wide">
            {feature.tagline}
          </p>

          <!-- Description -->
          <p class="mt-4 text-sm md:text-[16px] text-heading/75 leading-relaxed max-w-2xl">
            {feature.description}
          </p>

          <!-- Action button -->
          <div class="mt-6">
            <a
              href="#contact-us"
              class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-accent-blue hover:text-card-blue transition-colors duration-300 no-underline"
            >
              Inspect Guarantee
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const blocks = document.querySelectorAll('[data-reveal-block]');
    
    const observerOptions = {
      root: null,
      rootMargin: '-20% 0px -20% 0px', // Trigger reveal when block is inside center 60% of viewport
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        } else {
          entry.target.classList.remove('is-visible');
        }
      });
    }, observerOptions);

    blocks.forEach(block => observer.observe(block));
  });
</script>

<style>
  .reveal-text-block {
    opacity: 0.15;
    transform: translateY(35px) scale(0.97);
    filter: blur(2px);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity, filter;
  }

  .reveal-text-block.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
</style>
