<section
  class="mx-auto w-full max-w-[1760px] px-4 sm:px-5 md:px-8 py-20 md:py-28"
  id="contact-us"
  aria-labelledby="booking-title"
>
  <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-16 items-stretch overflow-hidden rounded-[28px] border border-[#d6e6fb] bg-[#f4f8fd]">
    <div class="relative min-h-[320px] lg:min-h-full">
      <img
        src="/images/photoshoot/IMG_6774.jpg"
        alt="Dentist for you clinic, Varanasi"
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-[#152445]/55"></div>
      <div class="absolute inset-0 bg-linear-to-r from-[#0f1b33] via-[#0f1b33]/80 to-[#0f1b33]/25"></div>
      <div class="relative z-10 flex h-full min-h-[320px] flex-col justify-end p-8 md:p-10">
        <p class="m-0 text-base font-semibold uppercase tracking-[0.14em]" style="color: #fff">
          Consultation
        </p>
        <h2
          id="booking-title"
          class="mt-3 max-w-md text-[clamp(32px,3.4vw,48px)] font-extrabold leading-[1.15]"
          style="color: #fff"
        >
          Book your first visit
        </h2>
        <p class="mt-3 max-w-md text-lg leading-relaxed" style="color: #f3f6fb">
          Tell us a preferred day and treatment. We will confirm on WhatsApp.
        </p>
        <ul class="mt-6 flex flex-col gap-2 text-base font-semibold" style="color: #fff">
          <li>Mon–Sat: 10:30–2, 6–9 · Sun closed</li>
          <li>
            <a class="underline-offset-4 hover:underline" href="tel:+919935027027" style="color: #fff">+91 99350 27027</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="p-6 sm:p-8 lg:p-10 lg:pl-0">
      <form
        id="booking-form"
        class="flex h-full flex-col gap-5 rounded-3xl border border-[#d6e6fb] bg-white p-6 sm:p-8 shadow-[0_18px_40px_rgba(31,63,117,0.08)]"
      >
        <div>
          <p class="text-base font-bold uppercase tracking-[0.14em] text-card-blue">Request a slot</p>
          <p class="mt-1 text-lg leading-relaxed text-body">Takes under a minute. No account needed.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <label class="block text-base font-semibold text-heading">
            Name
            <input
              class="mt-2 w-full rounded-xl border border-[#d6e6fb] bg-[#f8fbff] px-4 py-3 text-base font-semibold text-heading placeholder:text-muted focus:border-card-blue focus:outline-none focus:ring-2 focus:ring-accent-blue/30"
              type="text"
              name="name"
              placeholder="Your full name"
              required
              autocomplete="name"
            />
          </label>
          <label class="block text-base font-semibold text-heading">
            Phone
            <input
              class="mt-2 w-full rounded-xl border border-[#d6e6fb] bg-[#f8fbff] px-4 py-3 text-base font-semibold text-heading placeholder:text-muted focus:border-card-blue focus:outline-none focus:ring-2 focus:ring-accent-blue/30"
              type="tel"
              name="phone"
              placeholder="+91"
              required
              autocomplete="tel"
            />
          </label>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <label class="relative block text-base font-semibold text-heading">
            Service
            <select
              class="mt-2 w-full appearance-none rounded-xl border border-[#d6e6fb] bg-[#f8fbff] px-4 py-3 pr-10 text-base font-semibold text-heading focus:border-card-blue focus:outline-none focus:ring-2 focus:ring-accent-blue/30"
              name="service"
              required
            >
              <option value="" selected disabled>Choose a treatment</option>
              <option value="aesthetic">Aesthetic dentistry</option>
              <option value="orthodontics">Orthodontics</option>
              <option value="implantology">Implantology</option>
              <option value="whitening">Whitening</option>
              <option value="surgical">Surgical dentistry</option>
            </select>
            <span class="pointer-events-none absolute right-4 top-[2.85rem] text-muted">
              <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </label>
          <label class="block text-base font-semibold text-heading">
            Preferred date
            <input
              class="mt-2 w-full rounded-xl border border-[#d6e6fb] bg-[#f8fbff] px-4 py-3 text-base font-semibold text-heading focus:border-card-blue focus:outline-none focus:ring-2 focus:ring-accent-blue/30"
              type="date"
              name="date"
            />
          </label>
        </div>

        <div class="mt-auto flex flex-col gap-3 pt-2">
          <button
            type="submit"
            class="inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-linear-to-r from-accent-blue to-card-blue px-7 text-base font-extrabold text-white border-0 cursor-pointer shadow-[0_18px_34px_rgba(43,93,158,0.26)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_22px_42px_rgba(43,93,158,0.32)]"
          >
            Send on WhatsApp
          </button>
          <p class="text-base text-muted">
            By sending, you accept our <a class="underline text-body hover:text-card-blue" href="/privacy-policy">Privacy Policy</a>.
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const bookingForm = document.getElementById("booking-form") as HTMLFormElement | null;
  bookingForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(bookingForm);
    const name = String(data.get("name") || "").trim();
    const phone = String(data.get("phone") || "").trim();
    const service = String(data.get("service") || "Not specified");
    const date = String(data.get("date") || "Not specified");
    const message = `Hello, I would like to book a visit.\nName: ${name}\nPhone: ${phone}\nService: ${service}\nDate: ${date}`;
    window.open(`https://wa.me/919935027027?text=${encodeURIComponent(message)}`, "_blank");
  });
</script>
