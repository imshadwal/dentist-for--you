<section
  class="relative mx-auto flex min-h-[calc(100svh-120px)] w-full max-w-[1760px] items-center justify-center py-16 md:py-24 px-2 sm:px-4 md:px-6"
  id="contact-us"
  aria-labelledby="booking-title"
>
  <div class="relative w-full">
    <div class="relative z-10 mx-auto max-w-200 text-center">
      <p
        class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase"
      >
        Consultation
      </p>
      <h2
        id="booking-title"
        class="mt-3 text-[clamp(34px,4.4vw,60px)] font-extrabold leading-[1.18] text-heading capitalize"
      >
        Book Your First Step
      </h2>
      <p
        class="mx-auto mt-4 max-w-170 text-[clamp(17px,1.2vw,20px)] leading-relaxed text-heading/70"
      >
        Choose your preferred date, treatment type,
        <span class="block">and we'll handle the rest.</span>
      </p>

      <form
        id="booking-form"
        class="mx-auto mt-10 grid max-w-120 gap-6 text-left max-[1080px]:text-center"
      >
        <div
          class="grid gap-6 max-[620px]:gap-5 max-[620px]:text-left max-[620px]:grid-cols-1 grid-cols-2"
        >
          <label class="block text-[12px] font-semibold text-heading/70">
            <span class="sr-only">Enter your name</span>
            <input
              class="w-full border-b border-[#d6e6fb] bg-transparent pb-2 text-[14px] font-semibold text-heading placeholder:text-heading/50 focus:border-card-blue focus:outline-none"
              type="text"
              name="name"
              placeholder="Enter your name"
              required
              autocomplete="name"
            />
          </label>

          <label class="block text-[12px] font-semibold text-heading/70">
            <span class="sr-only">Enter your phone number</span>
            <input
              class="w-full border-b border-[#d6e6fb] bg-transparent pb-2 text-[14px] font-semibold text-heading placeholder:text-heading/50 focus:border-card-blue focus:outline-none"
              type="tel"
              name="phone"
              placeholder="Enter your phone number"
              required
              autocomplete="tel"
            />
          </label>
        </div>

        <div
          class="grid gap-6 max-[620px]:gap-5 max-[620px]:text-left max-[620px]:grid-cols-1 grid-cols-2"
        >
          <label
            class="relative block text-[12px] font-semibold text-heading/70"
          >
            <span class="sr-only">Service</span>
            <select
              class="w-full appearance-none border-b border-[#d6e6fb] bg-transparent pb-2 pr-7 text-[14px] font-semibold text-heading/70 focus:border-card-blue focus:outline-none"
              name="service"
              required
            >
              <option value="" selected disabled>Service</option>
              <option value="aesthetic">Aesthetic dentistry</option>
              <option value="orthodontics">Orthodontics</option>
              <option value="implantology">Implantology</option>
              <option value="whitening">Whitening</option>
              <option value="surgical">Surgical dentistry</option>
            </select>
            <span
              class="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 text-heading/50"
            >
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                role="img"
                aria-hidden="true"
              >
                <path
                  d="M6 9l6 6 6-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </label>

          <label
            class="relative block text-[12px] font-semibold text-heading/70"
          >
            <span class="sr-only">Date</span>
            <input
              class="w-full border-b border-[#d6e6fb] bg-transparent pb-2 pr-7 text-[14px] font-semibold text-heading/70 focus:border-card-blue focus:outline-none"
              type="date"
              name="date"
            />
          </label>
        </div>

        <div
          class="flex flex-wrap items-center gap-4 max-[620px]:justify-center"
        >
          <button
            type="submit"
            class="inline-flex min-h-14.5 items-center gap-3 rounded-full bg-linear-to-r from-accent-blue to-card-blue py-0 pr-7 pl-3 text-base font-extrabold text-white border-0 cursor-pointer shadow-[0_18px_34px_rgba(43,93,158,0.26)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_22px_42px_rgba(43,93,158,0.32)] max-[620px]:min-h-13 max-[620px]:pr-5.5 max-[620px]:text-sm"
          >
            <span
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/20"
              aria-hidden="true"
            >
              <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" role="img">
                <path
                  d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5H19a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h1.25V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v8A1.5 1.5 0 0 0 5 19.5h14a1.5 1.5 0 0 0 1.5-1.5v-8h-17Zm3 3.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5a.75.75 0 0 1-.75-.75Z"
                  fill="currentColor"></path>
              </svg>
            </span>
            Send request
          </button>
          <p class="text-[11px] text-heading/60">
            By clicking this button you accept our <a class="underline text-heading/70 hover:text-card-blue" href="/privacy-policy">Privacy Policy</a>
          </p>
        </div>
      </form>
    </div>

    <div
      class="booking-visual pointer-events-none absolute left-0 top-[8%] -translate-y-6 -translate-x-4 max-[1080px]:static max-[1080px]:mt-10 max-[1080px]:flex max-[1080px]:justify-center max-[1080px]:translate-y-0 max-[1080px]:translate-x-0"
    >
      <div
        class="absolute -z-10 h-56 w-56 rounded-full bg-[radial-gradient(circle,rgba(88,179,250,0.18)_0%,rgba(88,179,250,0.08)_48%,transparent_70%)]"
      >
      </div>
      <img
        class="h-auto w-[min(260px,32vw)] drop-shadow-[0_24px_40px_rgba(88,179,250,0.24)] max-[1080px]:w-[min(240px,70vw)]"
        src="/images/booking/1.png"
        alt="Clear aligner trays"
        loading="lazy"
      />
    </div>

    <div
      class="booking-visual pointer-events-none absolute right-0 bottom-[8%] translate-y-6 max-[1080px]:static max-[1080px]:mt-8 max-[1080px]:flex max-[1080px]:justify-center max-[1080px]:translate-y-0 max-[1080px]:translate-x-0"
    >
      <div
        class="absolute -z-10 h-56 w-56 rounded-full bg-[radial-gradient(circle,rgba(88,179,250,0.18)_0%,rgba(88,179,250,0.08)_48%,transparent_70%)]"
      >
      </div>
      <img
        class="h-auto w-[min(210px,28vw)] drop-shadow-[0_22px_36px_rgba(88,179,250,0.22)] max-[1080px]:w-[min(220px,62vw)]"
        src="/images/booking/2.png"
        alt="Dental crown"
        loading="lazy"
      />
    </div>
  </div>
</section>

<script>
  const bookingForm = document.getElementById("booking-form") as HTMLFormElement | null;
  bookingForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(bookingForm);
    const name = String(data.get("name") || "").trim();
    const phone = String(data.get("phone") || "").trim();
    const service = String(data.get("service") || "Not specified");
    const date = String(data.get("date") || "Not specified");
    const message = `Hello, I would like to book a visit.\nName: ${name}\nPhone: ${phone}\nService: ${service}\nDate: ${date}`;
    window.open(`https://wa.me/919935027027?text=${encodeURIComponent(message)}`, "_blank");
  });
</script>
