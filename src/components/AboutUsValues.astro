---
// src/components/AboutUsValues.astro
---

<section
  class="mx-auto w-full max-w-[1760px] px-2 sm:px-4 md:px-6 py-20 md:py-28 overflow-visible"
  id="our-values"
  aria-labelledby="values-title"
>
  <!-- 1. Header (Centered) -->
  <div class="text-center mb-16">
    <p class="eyebrow">
      Core Philosophy
    </p>
    <h2
      id="values-title"
      class="mt-3 text-[clamp(32px,4vw,56px)] font-extrabold leading-[1.18] text-heading capitalize"
    >
      What Drives Us Every Day
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-body leading-relaxed">
      Every treatment is an act of artistry. We combine meticulous craftsmanship with clinical empathy to create results that exceed expectations.
    </p>
  </div>

  <!-- 2. Three Visual Concept Cards (Side-by-side) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
    
    <!-- Visual Card 1: Clinical Artistry -->
    <div class="group relative overflow-hidden rounded-3xl border border-slate-100 bg-white p-4 shadow-xs transition-all duration-300 hover:shadow-md">
      <div class="relative h-64 overflow-hidden rounded-2xl bg-slate-50">
        <img 
          src="/images/photoshoot/IMG_6704.jpg" 
          alt="Clinical Artistry & Concept" 
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-linear-to-t from-slate-950/50 via-transparent to-transparent"></div>
        <span class="absolute bottom-4 left-4 bg-white/90 backdrop-blur-md text-base uppercase tracking-wider font-bold text-heading px-3 py-1 rounded-full shadow-2xs">Artistry & Science</span>
      </div>
      <div class="mt-4 px-2">
        <h3 class="text-xl font-extrabold text-heading tracking-tight mb-2">Precision Craftsmanship</h3>
        <p class="text-base text-body leading-relaxed">Combining advanced clinical knowledge with standard-setting aesthetic standards.</p>
      </div>
    </div>

    <!-- Visual Card 2: Soothing Practice Sanctuary -->
    <div class="group relative overflow-hidden rounded-3xl border border-slate-100 bg-white p-4 shadow-xs transition-all duration-300 hover:shadow-md">
      <div class="relative h-64 overflow-hidden rounded-2xl bg-slate-50">
        <img 
          src="/images/photoshoot/IMG_6929.jpg" 
          alt="Luxury Soothing Lounge" 
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-linear-to-t from-slate-950/50 via-transparent to-transparent"></div>
        <span class="absolute bottom-4 left-4 bg-white/90 backdrop-blur-md text-base uppercase tracking-wider font-bold text-heading px-3 py-1 rounded-full shadow-2xs">Patient Comfort</span>
      </div>
      <div class="mt-4 px-2">
        <h3 class="text-xl font-extrabold text-heading tracking-tight mb-2">Luxury Spa Environment</h3>
        <p class="text-base text-body leading-relaxed">Relaxing spaces with aromatherapy and premium lounges to dissolve clinical anxiety.</p>
      </div>
    </div>

    <!-- Visual Card 3: Advanced Dental Science -->
    <div class="group relative overflow-hidden rounded-3xl border border-slate-100 bg-white p-4 shadow-xs transition-all duration-300 hover:shadow-md">
      <div class="relative h-64 overflow-hidden rounded-2xl bg-slate-50">
        <img 
          src="/images/photoshoot/IMG_6805.jpg" 
          alt="Cutting-Edge Equipment" 
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-linear-to-t from-slate-950/50 via-transparent to-transparent"></div>
        <span class="absolute bottom-4 left-4 bg-white/90 backdrop-blur-md text-base uppercase tracking-wider font-bold text-heading px-3 py-1 rounded-full shadow-2xs">Tech Excellence</span>
      </div>
      <div class="mt-4 px-2">
        <h3 class="text-xl font-extrabold text-heading tracking-tight mb-2">Cutting-Edge Equipment</h3>
        <p class="text-base text-body leading-relaxed">Utilizing advanced 3D scanning, laser diagnostics, and digital alignment systems.</p>
      </div>
    </div>

  </div>

  <!-- 3. Core Tagline Statement -->
  <div class="text-center max-w-3xl mx-auto mb-16 px-4">
    <p class="text-xl md:text-2xl font-extrabold text-heading leading-relaxed tracking-tight">
      We are on a mission to redefine the dental experience, creating a <span class="bg-linear-to-r from-accent-blue to-card-blue bg-clip-text text-transparent">judgment-free sanctuary</span> where anxiety dissolves and clinical artistry flourishes.
    </p>
  </div>

  <!-- 4. Four Statistics Cards (Side-by-side) -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6" data-counter-section>
    
    <!-- Stat 1: Experience -->
    <div class="group relative overflow-hidden rounded-2xl border border-slate-100 bg-[#f8fafc] p-6 shadow-xs text-center flex flex-col justify-center items-center hover:border-card-blue/30 transition-all duration-300">
      <span class="text-4xl font-extrabold text-card-blue mb-1">
        <span data-counter data-target="20">0</span>+
      </span>
      <span class="text-base font-bold text-body uppercase tracking-widest">Years of practice</span>
    </div>

    <!-- Stat 2: Open days -->
    <div class="group relative overflow-hidden rounded-2xl border border-slate-100 bg-[#f8fafc] p-6 shadow-xs text-center flex flex-col justify-center items-center hover:border-card-blue/30 transition-all duration-300">
      <span class="text-4xl font-extrabold text-card-blue mb-1">
        <span data-counter data-target="6">0</span>
      </span>
      <span class="text-base font-bold text-body uppercase tracking-widest">Days a week</span>
    </div>

    <!-- Stat 3: Principal dentist -->
    <div class="group relative overflow-hidden rounded-2xl border border-slate-100 bg-[#f8fafc] p-6 shadow-xs text-center flex flex-col justify-center items-center hover:border-card-blue/30 transition-all duration-300">
      <span class="text-4xl font-extrabold text-card-blue mb-1">
        <span data-counter data-target="1">0</span>
      </span>
      <span class="text-base font-bold text-body uppercase tracking-widest">Principal dentist</span>
    </div>

  </div>
</section>

<script>
  const counterSections = document.querySelectorAll("[data-counter-section]");
  const counterFormatter = new Intl.NumberFormat("en-US", {
    maximumFractionDigits: 1,
  });

  const animateCounter = (counter: Element) => {
    const targetStr = (counter as HTMLElement).dataset.target ?? "0";
    const target = Number(targetStr);
    const isFloat = targetStr.includes(".");
    const duration = 1300;
    const startTime = performance.now();

    const tick = (currentTime: number) => {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const easedProgress = 1 - Math.pow(1 - progress, 3);
      
      let currentValue;
      if (isFloat) {
        currentValue = Math.round(target * easedProgress * 10) / 10;
      } else {
        currentValue = Math.round(target * easedProgress);
      }

      counter.textContent = counterFormatter.format(currentValue);

      if (progress < 1) {
        requestAnimationFrame(tick);
      }
    };

    requestAnimationFrame(tick);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) {
          return;
        }

        entry.target.querySelectorAll("[data-counter]").forEach((counter) => {
          counter.textContent = "0";
          animateCounter(counter);
        });
      });
    },
    {
      threshold: 0.2,
    },
  );

  counterSections.forEach((section) => observer.observe(section));
</script>

<style>
  @keyframes float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-4px);
    }
    100% {
      transform: translateY(0px);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
</style>
