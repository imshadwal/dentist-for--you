---
const team = [
  {
    name: "Dr. Samanvaya Shukla",
    role: "Principal Dentist & Founder",
    specialty: "Orthodontics",
    bio: "Dedicated 20 year experience practitioner delivering exceptional stress free dental care for the whole family.",
    image: "/images/photoshoot/IMG_6835.jpg",
  },
];
---

<section 
  class="mx-auto w-full max-w-[1760px] py-16 md:py-24 px-2 sm:px-4 md:px-6 grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-12 items-start overflow-hidden" 
  id="meet-team"
  aria-labelledby="team-title"
>
  <div class="lg:col-span-1 lg:sticky lg:top-24 flex flex-col justify-between h-full z-10 bg-white">
    <div>
      <div class="flex items-center gap-3">
        <span id="team-title" class="text-xs font-bold tracking-[0.3em] text-slate-400 uppercase">
          Specialists
        </span>
        <div class={`flex -space-x-2 overflow-hidden ${team.length <= 1 ? 'hidden' : ''}`}>
          <div class="inline-block h-5 w-5 rounded-full ring-2 ring-white bg-slate-200"></div>
          <div class="inline-block h-5 w-5 rounded-full ring-2 ring-white bg-slate-300"></div>
          <div class="inline-block h-5 w-5 rounded-full ring-2 ring-white bg-slate-400"></div>
          <div class="inline-block h-5 w-5 rounded-full ring-2 ring-white bg-[#2b5d9e] flex items-center justify-center text-[8px] font-bold text-white">+3</div>
        </div>
      </div>

      <h2 class="mt-4 text-[clamp(32px,4vw,52px)] font-extrabold leading-[1.2] text-[#294073] tracking-tight capitalize">
        Meet The Minds<br />Behind Your Smile
      </h2>
      
      <p class="mt-6 text-base leading-relaxed text-[#294073]/70 max-w-sm">
        Our principal specialist brings precision, empathy, and artistry to every treatment — combining years of experience with a passion for truly personalized care.
      </p>
      
      <a href="#all-specialists" class={`inline-flex items-center text-sm font-bold text-[#2b5d9e] mt-6 hover:opacity-80 transition-opacity ${team.length <= 1 ? 'hidden' : ''}`}>
        View all specialists <span class="ml-2">→</span>
      </a>
    </div>

    <div class={`flex items-center space-x-6 mt-16 lg:mt-32 ${team.length <= 1 ? 'hidden' : ''}`}>
      <span class="text-sm font-bold text-[#294073]">
        <span id="carousel-counter">01</span> <span class="text-slate-300 font-normal">/ {String(team.length).padStart(2, '0')}</span>
      </span>
      <div class="flex space-x-2">
        <button id="slide-prev" class="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-slate-400 hover:border-slate-400 hover:text-[#294073] transition-colors cursor-pointer" aria-label="Previous specialist">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </button>
        <button id="slide-next" class="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center text-slate-400 hover:border-slate-400 hover:text-[#294073] transition-colors cursor-pointer" aria-label="Next specialist">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="lg:col-span-2 w-full relative">
    {
      team.length === 1 ? (
        <div class="w-full bg-[#f8fafc] border border-slate-100 rounded-3xl shadow-xs overflow-hidden transition-all duration-300 hover:shadow-md grid grid-cols-1 md:grid-cols-12">
          <!-- Image Column (7 cols) -->
          <div class="md:col-span-7 relative h-[420px] md:h-[520px] bg-slate-100">
            {team[0].image ? (
              <img
                src={team[0].image}
                alt={team[0].name}
                class="h-full w-full object-cover grayscale-[15%] transition-transform duration-300 hover:scale-103 pointer-events-none"
                loading="lazy"
              />
            ) : (
              <div class="flex items-center justify-center h-full bg-linear-to-br from-[#58b3fa]/20 to-[#2b5d9e]/20">
                <div class="text-5xl font-extrabold text-[#2b5d9e]/30">
                  {team[0].name.charAt(0)}{team[0].name.split(" ")[1]?.charAt(0)}
                </div>
              </div>
            )}
            <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-md text-[10px] uppercase tracking-wider font-bold text-[#294073] px-3.5 py-1.5 rounded-full border border-white/20 shadow-xs">
              {team[0].specialty}
            </span>
          </div>

          <!-- Details Column (5 cols) -->
          <div class="md:col-span-5 p-8 md:p-10 flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#2b5d9e]">Principal Specialist</span>
              <h3 class="text-[clamp(24px,2.8vw,32px)] font-extrabold text-[#294073] tracking-tight mt-1 mb-1.5 capitalize">
                {team[0].name}
              </h3>
              <p class="text-sm font-semibold text-slate-400">
                {team[0].role}
              </p>
              
              <p class="text-base text-slate-600 mt-6 leading-relaxed">
                {team[0].bio}
              </p>

              <!-- Highlights Grid to Fill Space -->
              <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div class="flex items-start gap-3">
                  <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#58b3fa]/15 text-[#58b3fa] font-bold text-[10px] font-mono">✓</span>
                  <div>
                    <h4 class="text-xs font-bold text-[#294073]">M.D.S. in Orthodontics</h4>
                    <p class="text-[10px] text-slate-400 mt-0.5 leading-normal">Advanced specialization in jaw alignment</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#58b3fa]/15 text-[#58b3fa] font-bold text-[10px] font-mono">✓</span>
                  <div>
                    <h4 class="text-xs font-bold text-[#294073]">20+ Years Practice</h4>
                    <p class="text-[10px] text-slate-400 mt-0.5 leading-normal">Exceptional clinical experience</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#58b3fa]/15 text-[#58b3fa] font-bold text-[10px] font-mono">✓</span>
                  <div>
                    <h4 class="text-xs font-bold text-[#294073]">Premium Care Visionary</h4>
                    <p class="text-[10px] text-slate-400 mt-0.5 leading-normal">Pioneer of stress-free dental care</p>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#58b3fa]/15 text-[#58b3fa] font-bold text-[10px] font-mono">✓</span>
                  <div>
                    <h4 class="text-xs font-bold text-[#294073]">Certified Orthodontist</h4>
                    <p class="text-[10px] text-slate-400 mt-0.5 leading-normal">Expert in aligner and clear braces</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div 
          id="carousel-track" 
          class="flex flex-row overflow-x-auto gap-6 scroll-smooth snap-x snap-mandatory [-ms-overflow-style:none] [scrollbar-width:none] pb-4 select-none cursor-grab active:cursor-grabbing"
        >
          {
            team.map((member) => (
              <article class="w-[290px] min-w-[290px] md:w-[320px] md:min-w-[320px] snap-start group relative overflow-hidden rounded-2xl border border-slate-100 bg-[#f8fafc] shadow-sm transition-all duration-300 flex flex-col justify-between">
                <div>
                  <div class="relative h-80 overflow-hidden bg-slate-100">
                    {member.image ? (
                      <img
                        src={member.image}
                        alt={member.name}
                        class="h-full w-full object-cover grayscale-[15%] transition-transform duration-300 group-hover:scale-105 pointer-events-none"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex items-center justify-center h-full bg-linear-to-br from-[#58b3fa]/20 to-[#2b5d9e]/20">
                        <div class="text-5xl font-extrabold text-[#2b5d9e]/30">
                          {member.name.charAt(0)}{member.name.split(" ")[1]?.charAt(0)}
                        </div>
                      </div>
                    )}
                    <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-md text-[10px] uppercase tracking-wider font-bold text-[#294073] px-3 py-1 rounded-full border border-white/20 shadow-sm">
                      {member.specialty.split(" & ")[0]}
                    </span>
                  </div>

                  <div class="p-6">
                    <h3 class="text-lg font-bold text-[#294073] tracking-tight mb-0.5">
                      {member.name}
                    </h3>
                    <p class="text-[11px] font-semibold text-slate-400">
                      {member.role}
                    </p>
                    <p class="text-xs text-slate-500 mt-4 leading-relaxed line-clamp-3">
                      {member.bio}
                    </p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      )
    }
  </div>
</section>

<script>
  const track = document.getElementById('carousel-track') as HTMLElement;
  const nextBtn = document.getElementById('slide-next');
  const prevBtn = document.getElementById('slide-prev');
  const counter = document.getElementById('carousel-counter');

  if (track && nextBtn && prevBtn && counter) {
    const getCardWidth = () => track.firstElementChild?.getBoundingClientRect().width || 320;
    const gap = 24;

    // Direct Arrow Pushes Loop Mechanics
    nextBtn.addEventListener('click', () => {
      const maxScroll = track.scrollWidth - track.clientWidth;
      if (Math.ceil(track.scrollLeft) >= maxScroll) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: getCardWidth() + gap, behavior: 'smooth' });
      }
    });

    prevBtn.addEventListener('click', () => {
      if (track.scrollLeft <= 0) {
        track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: -(getCardWidth() + gap), behavior: 'smooth' });
      }
    });

    // Dynamic Tracking Counter Logic
    track.addEventListener('scroll', () => {
      const currentScroll = track.scrollLeft;
      const cardSpace = getCardWidth() + gap;
      const index = Math.round(currentScroll / cardSpace);
      counter.textContent = String(Math.min(index + 1, track.children.length)).padStart(2, '0');
    });

    // Inertial Mouse Drag Setup
    let isDown = false;
    let startX: number;
    let scrollLeft: number;

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      track.classList.replace('cursor-grab', 'cursor-grabbing');
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    track.addEventListener('mouseleave', () => {
      isDown = false;
      track.classList.replace('cursor-grabbing', 'cursor-grab');
    });

    track.addEventListener('mouseup', () => {
      isDown = false;
      track.classList.replace('cursor-grabbing', 'cursor-grab');
    });

    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.5;
      track.scrollLeft = scrollLeft - walk;
    });
  }
</script>