---
const team = [
  {
    name: "Dr. Sarah Mitchell",
    role: "Principal Dentist & Founder",
    specialty: "Aesthetic & General Dentistry",
    bio: "Over 15 years refining smiles with an artist's eye and a scientist's precision.",
    image: "/images/team/doctor1.jpg",
  },
  {
    name: "Dr. James Chen",
    role: "Orthodontic Specialist",
    specialty: "Orthodontics & Alignment",
    bio: "Transforming bites with gentle, predictable results and cutting-edge aligners.",
    image: "/images/team/doctor2.jpg",
  },
  {
    name: "Dr. Elena Rodriguez",
    role: "Oral Surgeon",
    specialty: "Surgical & Implant Dentistry",
    bio: "Expert in complex cases with a reputation for precision and patient comfort.",
    image: "/images/team/doctor3.jpg",
  },
  {
    name: "Dr. Marcus Thompson",
    role: "Cosmetic Specialist",
    specialty: "Teeth Whitening & Veneers",
    bio: "Creating luminous, natural-looking smiles that enhance confidence.",
    image: "/images/team/doctor4.jpg",
  },
];
---

<section
  class="mx-auto w-[calc(100%-32px)] max-w-460 py-[clamp(40px,8vw,100px)] max-[620px]:w-[calc(100%-28px)]"
  id="meet-team"
  aria-labelledby="team-title"
>
  <div class="text-center mb-[clamp(40px,6vw,80px)]">
    <p class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase">
      Expertise
    </p>
    <h2
      id="team-title"
      class="mt-3 text-[clamp(36px,4.4vw,56px)] font-extrabold leading-[1.05] text-heading"
    >
      Specialists in excellence
    </h2>
    <p class="mx-auto mt-4 max-w-180 text-[clamp(14px,1.05vw,18px)] leading-[1.45] text-heading/70">
      Our board-certified team brings decades of combined experience and unwavering commitment to your care.
    </p>
  </div>

  <!-- Team Grid -->
  <div class="grid grid-cols-2 gap-[clamp(16px,2.5vw,28px)] max-[900px]:grid-cols-1">
    {
      team.map((member) => (
        <article
          class="group relative overflow-hidden rounded-2xl border border-[#d6e6fb] shadow-[0_12px_24px_rgba(31,63,117,0.12)] transition-all duration-300 hover:shadow-[0_24px_48px_rgba(31,63,117,0.18)]"
        >
          <!-- Image container -->
          <div class="relative h-70 max-[620px]:h-60 overflow-hidden bg-linear-to-br from-accent-blue/10 to-card-blue/10">
            <div
              class="absolute inset-0 bg-linear-to-b from-transparent via-transparent to-white/5"
              aria-hidden="true"
            ></div>

            {member.image ? (
              <img
                src={member.image}
                alt={member.name}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            ) : (
              <div class="flex items-center justify-center h-full bg-linear-to-br from-accent-blue/20 to-card-blue/20">
                <div class="text-center">
                  <div class="text-5xl font-extrabold text-card-blue/30">
                    {member.name.charAt(0)}{member.name.split(" ")[1]?.charAt(0)}
                  </div>
                </div>
              </div>
            )}

            <!-- Gradient overlay on hover -->
            <div
              class="absolute inset-0 bg-linear-to-t from-black/60 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              aria-hidden="true"
            ></div>
          </div>

          <!-- Content -->
          <div class="p-[clamp(18px,2.5vw,28px)]">
            <p class="text-[12px] font-bold tracking-[0.32em] text-card-blue/60 uppercase mb-2">
              {member.specialty}
            </p>
            <h3 class="text-[clamp(18px,1.8vw,22px)] font-extrabold text-heading mb-1">
              {member.name}
            </h3>
            <p class="text-[13px] font-semibold text-card-blue mb-3">
              {member.role}
            </p>
            <p class="text-[13px] leading-normal text-heading/70">
              {member.bio}
            </p>

            <!-- Accent line -->
            <div
              class="mt-4 h-1 w-6 bg-linear-to-r from-accent-blue to-card-blue rounded-full transform transition-all duration-300 group-hover:w-12"
              aria-hidden="true"
            ></div>
          </div>
        </article>
      ))
    }
  </div>

  <!-- CTA -->
  <div class="mt-[clamp(40px,8vw,60px)] flex justify-center">
    <a
      class="inline-flex min-h-14.5 items-center gap-3 rounded-full bg-linear-to-r from-accent-blue to-card-blue py-0 pr-7 pl-3 text-base font-extrabold text-white no-underline shadow-[0_18px_34px_rgba(43,93,158,0.26)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_22px_42px_rgba(43,93,158,0.32)] max-[620px]:min-h-13 max-[620px]:pr-5.5 max-[620px]:text-sm"
      href="#contact-us"
    >
      <span
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/20"
        aria-hidden="true"
      >
        <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" role="img">
          <path
            d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5H19a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h1.25V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v8A1.5 1.5 0 0 0 5 19.5h14a1.5 1.5 0 0 0 1.5-1.5v-8h-17Zm3 3.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5a.75.75 0 0 1-.75-.75Z"
              fill="currentColor"
            ></path>
          </svg>
        </span>
        Meet our team
      </a>
    </a>
  </div>
</section>
