---
const metrics = [
  {
    value: 20,
    suffix: "k+",
    label: "Soothed smiles",
  },
  {
    value: 99,
    suffix: "%",
    label: "Satisfaction",
  },
  {
    value: 6,
    suffix: "",
    label: "Days open each week",
  },
];
---

<section
  class="mx-auto w-full max-w-[1760px] px-4 sm:px-5 md:px-8 py-12 md:py-20"
  id="about"
  aria-labelledby="about-highlights-title"
>
  <div
    class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] overflow-hidden rounded-[28px] border border-[#d6e6fb] bg-white shadow-[0_18px_40px_rgba(31,63,117,0.08)]"
    data-counter-section
  >
    <div class="relative min-h-[280px] lg:min-h-[560px]">
      <img
        class="absolute inset-0 h-full w-full object-cover"
        src="/images/photoshoot/IMG_6784.jpg"
        alt="Modern dental treatment room"
        loading="lazy"
      />
    </div>

    <div class="flex flex-col justify-between gap-10 bg-[#294073] p-8 sm:p-10 lg:p-12">
      <div>
        <p class="m-0 text-base font-semibold uppercase tracking-[0.14em]" style="color: #58b3fa">
          About
        </p>
        <h2
          id="about-highlights-title"
          class="mt-3 max-w-lg text-[clamp(32px,3.6vw,48px)] font-extrabold leading-[1.15] tracking-tight"
          style="color: #fff"
        >
          The Dentist for you difference
        </h2>
        <p class="mt-4 max-w-lg text-lg leading-relaxed" style="color: #e8eef8">
          Your smile deserves more than a rushed appointment. Dr. Samanvaya Shukla
          offers comfort-first dentistry and orthodontics in a calm, personal clinic.
        </p>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-3 gap-6 border-t border-white/20 pt-8"
        aria-label="Practice highlights"
      >
        {
          metrics.map((metric) => (
            <div>
              <p class="m-0 flex items-baseline text-[clamp(32px,3vw,44px)] font-extrabold leading-none tracking-tight" style="color: #fff">
                <span data-counter data-target={metric.value}>0</span>
                <span>{metric.suffix}</span>
              </p>
              <p class="mt-2 text-base font-semibold leading-snug" style="color: #d5e4f7">
                {metric.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const counterSections = document.querySelectorAll("[data-counter-section]");
  const counterFormatter = new Intl.NumberFormat("en-US", {
    maximumFractionDigits: 0,
  });

  const animateCounter = (counter: Element) => {
    const target = Number((counter as HTMLElement).dataset.target ?? 0);
    const duration = 1300;
    const startTime = performance.now();

    const tick = (currentTime: number) => {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const easedProgress = 1 - Math.pow(1 - progress, 3);
      const currentValue = Math.round(target * easedProgress);

      counter.textContent = counterFormatter.format(currentValue);

      if (progress < 1) {
        requestAnimationFrame(tick);
      }
    };

    requestAnimationFrame(tick);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) {
          return;
        }

        entry.target.querySelectorAll("[data-counter]").forEach((counter) => {
          counter.textContent = "0";
          animateCounter(counter);
        });
      });
    },
    {
      threshold: 0.4,
    },
  );

  counterSections.forEach((section) => observer.observe(section));
</script>
