---
const metrics = [
  {
    value: 20,
    suffix: "+",
    label: "Years of excellence",
  },
  {
    value: 99,
    suffix: "%",
    label: "Patient satisfaction rate",
  },
  {
    value: 20000,
    suffix: "+",
    label: "Smiles transformed",
  },
  {
    value: 5,
    suffix: "",
    label: "Certified experts",
  },
];
---

<section
  class="mx-auto w-[calc(100%-32px)] max-w-460 py-[clamp(28px,5vw,84px)] max-[620px]:w-[calc(100%-28px)]"
  id="about"
  aria-labelledby="about-highlights-title"
>
  <div
    class="relative min-h-[clamp(560px,58vw,980px)] overflow-hidden rounded-lg bg-card-blue max-[980px]:min-h-auto"
    data-counter-section
  >
    <img
      class="animate-image-zoom motion-reduce:animate-none absolute inset-0 z-0 h-full w-full origin-center object-cover"
      src="/images/second.avif"
      alt="Modern dental treatment room"
      loading="lazy"
    />
    <div
      class="absolute inset-0 z-1 [background:linear-gradient(90deg,rgba(43,93,158,0.676)_0%,rgba(43,93,158,0.514)_45%),rgba(157,189,232,0.46)]"
    >
    </div>

    <div
      class="relative z-2 flex min-h-[inherit] flex-col justify-between p-[clamp(28px,3.6vw,64px)] max-[980px]:min-h-190 max-[620px]:min-h-215 max-[620px]:p-6"
    >
      <div class="max-w-190">
        <h2
          id="about-highlights-title"
          class="m-0 max-w-205 text-[clamp(42px,5vw,92px)] leading-[0.95] font-extrabold tracking-normal text-white max-[620px]:text-[clamp(38px,12vw,58px)]"
        >
          Unveil excellence. Discover the Dentist For You difference.
        </h2>
        <p
          class="mt-[clamp(28px,3vw,52px)] max-w-175 text-[clamp(16px,1.16vw,22px)] leading-[1.34] font-medium text-white"
        >
          At Dentist For You, we believe that your smile deserves more than just
          care. It deserves celebration. Our board-certified experts offer a
          spa-like, comforting experience paired with cutting-edge dental and
          orthodontic treatments.
        </p>
      </div>

      <div
        class="mt-[clamp(80px,16vw,300px)] grid grid-cols-4 gap-[clamp(14px,1.4vw,24px)] max-[980px]:mt-20 max-[980px]:grid-cols-2 max-[620px]:grid-cols-1 max-[620px]:gap-3"
        aria-label="Practice highlights"
      >
        {
          metrics.map((metric) => (
            <article class="min-h-32 rounded-lg border border-white/15 bg-white/15 p-[clamp(18px,2vw,30px)] backdrop-blur-sm max-[620px]:min-h-28">
              <strong class="flex min-h-[1em] items-baseline text-[clamp(42px,4.2vw,76px)] leading-[0.9] font-extrabold tracking-normal text-white">
                <span data-counter data-target={metric.value}>
                  0
                </span>
                <span>{metric.suffix}</span>
              </strong>
              <p class="mt-3.5 text-[clamp(15px,1.05vw,20px)] leading-[1.15] font-bold text-white">
                {metric.label}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const counterSections = document.querySelectorAll("[data-counter-section]");
  const counterFormatter = new Intl.NumberFormat("en-US", {
    maximumFractionDigits: 0,
  });

  const animateCounter = (counter: Element) => {
    const target = Number((counter as HTMLElement).dataset.target ?? 0);
    const duration = 1300;
    const startTime = performance.now();

    const tick = (currentTime: number) => {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const easedProgress = 1 - Math.pow(1 - progress, 3);
      const currentValue = Math.round(target * easedProgress);

      counter.textContent = counterFormatter.format(currentValue);

      if (progress < 1) {
        requestAnimationFrame(tick);
      }
    };

    requestAnimationFrame(tick);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) {
          return;
        }

        entry.target.querySelectorAll("[data-counter]").forEach((counter) => {
          counter.textContent = "0";
          animateCounter(counter);
        });
      });
    },
    {
      threshold: 0.4,
    },
  );

  counterSections.forEach((section) => observer.observe(section));
</script>
