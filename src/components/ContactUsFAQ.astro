---
const faqs = [
  {
    question: "Why do my gums bleed when I brush/floss?",
    answer:
      "Bleeding gums are early signs of inflammation of gums. So these areas need extra care and cleaning.",
  },
  {
    question: "I have black spots on teeth?",
    answer:
      "These black spots are caries, which need to be treated as early as possible.",
  },
  {
    question: "Why do I have bad breath?",
    answer:
      "Deposits around the teeth and gums cause bad breath. Complete oral prophylaxis is suggested.",
  },
  {
    question: "For RCT how many times I need to visit dental clinic?",
    answer:
      "Single time.",
  },
];
---

<section
  class="mx-auto w-full max-w-[1760px] px-2 sm:px-4 md:px-6 py-16 md:py-24"
  id="contact-faq"
  aria-labelledby="faq-title"
>
  <div class="text-center mb-[clamp(40px,6vw,80px)]">
    <h2
      id="faq-title"
      class="m-0 text-[clamp(40px,5vw,72px)] font-extrabold tracking-tight text-[#294073]"
    >
      FAQs
    </h2>
  </div>

  <!-- FAQ Accordion -->
  <div class="max-w-3xl mx-auto space-y-4">
    {
      faqs.map((faq, index) => (
        <details class="group relative rounded-2xl border border-[#d6e6fb] shadow-[0_8px_16px_rgba(31,63,117,0.08)] transition-all duration-300 hover:shadow-[0_12px_24px_rgba(31,63,117,0.12)] hover:border-card-blue/50 open:shadow-[0_12px_24px_rgba(31,63,117,0.12)]">
          <summary class="flex cursor-pointer items-center justify-between p-[clamp(20px,2.5vw,28px)] text-heading font-semibold hover:text-card-blue transition-colors">
            <span class="text-[clamp(14px,1.05vw,18px)]">{faq.question}</span>
            <svg
              class="h-6 w-6 shrink-0 transition-transform duration-300 group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>

          <div class="border-t border-[#e8f0f8] px-[clamp(20px,2.5vw,28px)] pb-[clamp(20px,2.5vw,28px)] bg-linear-to-br from-white to-accent-blue/3">
            <p class="text-[14px] leading-[1.6] text-heading/80">
              {faq.answer}
            </p>
          </div>
        </details>
      ))
    }
  </div>

  <!-- Additional Help CTA -->
  <div
    class="mt-[clamp(40px,8vw,60px)] p-[clamp(24px,3vw,40px)] rounded-2xl bg-linear-to-br from-accent-blue/10 to-card-blue/10 border border-accent-blue/20 text-center"
  >
    <p class="text-[clamp(14px,1.05vw,18px)] text-heading font-semibold mb-4">
      Didn't find what you're looking for?
    </p>
    <a
      class="inline-flex min-h-13 items-center gap-2 rounded-full bg-linear-to-r from-accent-blue to-card-blue py-0 px-7 text-sm font-extrabold text-white no-underline shadow-[0_12px_24px_rgba(43,93,158,0.2)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_16px_32px_rgba(43,93,158,0.3)]"
      href="/contact-us#contact-form-section"
    >
      Contact us directly
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          d="M5 12h14M12 5l7 7-7 7"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</section>
