---
const benefits = [
  {
    number: "01",
    title: "Spa-like Environment",
    description: "Experience dentistry in a sanctuary of comfort—think soothing aromatherapy, premium seating, and calming aesthetics.",
    icon: "🧘",
  },
  {
    number: "02",
    title: "Cutting-Edge Technology",
    description: "We invest in CEREC, intraoral scanning, and 3D imaging for faster, more accurate, pain-free treatments.",
    icon: "🔬",
  },
  {
    number: "03",
    title: "Bespoke Treatment Plans",
    description: "No cookie-cutter solutions. Every plan is crafted specifically for your goals, timeline, and lifestyle.",
    icon: "🎯",
  },
  {
    number: "04",
    title: "Transparent Pricing",
    description: "Upfront costs with no hidden fees. We provide detailed breakdowns and flexible financing options.",
    icon: "💎",
  },
  {
    number: "05",
    title: "Comprehensive Care",
    description: "From preventive to cosmetic to surgical—we handle everything under one roof by specialists you trust.",
    icon: "✨",
  },
  {
    number: "06",
    title: "Lifetime Relationships",
    description: "We're not just treating teeth; we're building lifelong partnerships in your dental health journey.",
    icon: "💜",
  },
];
---

<section
  class="mx-auto w-[calc(100%-32px)] max-w-460 py-[clamp(40px,8vw,100px)] max-[620px]:w-[calc(100%-28px)]"
  id="why-us"
  aria-labelledby="benefits-title"
>
  <div class="text-center mb-[clamp(40px,6vw,80px)]">
    <p class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase">
      Advantages
    </p>
    <h2
      id="benefits-title"
      class="mt-3 text-[clamp(36px,4.4vw,56px)] font-extrabold leading-[1.05] text-heading"
    >
      Why patients choose us
    </h2>
  </div>

  <!-- Benefits Grid -->
  <div class="grid grid-cols-3 gap-[clamp(16px,2vw,24px)] max-[1080px]:grid-cols-2 max-[620px]:grid-cols-1">
    {
      benefits.map((benefit, index) => (
        <article
          class="group relative h-full min-h-[240px] flex flex-col rounded-2xl border border-[#d6e6fb] p-[clamp(20px,2.5vw,32px)] shadow-[0_8px_16px_rgba(31,63,117,0.08)] transition-all duration-300 hover:shadow-[0_20px_40px_rgba(31,63,117,0.15)] hover:border-card-blue/50"
        >
          <!-- Background gradient on hover -->
          <div
            class="absolute inset-0 rounded-2xl bg-linear-to-br from-accent-blue/5 to-card-blue/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
            aria-hidden="true"
          ></div>

          <!-- Content -->
          <div class="relative z-1 flex flex-col h-full">
            <div class="flex items-start justify-between mb-4">
              <span
                class="text-[clamp(36px,3vw,48px)] font-extrabold text-card-blue/20 group-hover:text-card-blue/30 transition-colors duration-300"
                aria-hidden="true"
              >
                {benefit.number}
              </span>
              <span class="text-2xl">{benefit.icon}</span>
            </div>

            <h3 class="text-[clamp(16px,1.5vw,20px)] font-extrabold text-heading mb-3">
              {benefit.title}
            </h3>

            <p class="text-[13px] leading-[1.5] text-heading/70 flex-grow">
              {benefit.description}
            </p>

            <!-- Bottom accent -->
            <div
              class="mt-4 h-1 w-4 bg-linear-to-r from-accent-blue to-card-blue rounded-full transform transition-all duration-300 group-hover:w-8"
              aria-hidden="true"
            ></div>
          </div>
        </article>
      ))
    }
  </div>
</section>
