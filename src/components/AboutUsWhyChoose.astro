---
// src/components/AboutUsWhyChoose.astro
const values = [
  {
    title: "Precision",
    description: "Every treatment is an act of clinical artistry. We combine meticulous craftsmanship with advanced medical technology to create results that exceed expectations.",
    icon: "💎",
  },
  {
    title: "Compassion",
    description: "Your comfort is our absolute priority. We create a judgment-free sanctuary where dental anxiety dissolves and clinical trust flourishes.",
    icon: "🧘",
  },
  {
    title: "Innovation",
    description: "We continuously evolve our methods, staying at the forefront of global dental science to bring you the most advanced pain-free treatments available.",
    icon: "🔬",
  },
  {
    title: "Transparency",
    description: "No surprises, no hidden agendas. We explain every clinical step clearly and involve you in every decision regarding your aesthetic goals.",
    icon: "👁️",
  },
];

const benefits = [
  {
    title: "Spa-like Environment",
    description: "Experience dentistry in a sanctuary of comfort — with relaxing aromatherapy, premium leather seating, and calming design.",
  },
  {
    title: "Cutting-Edge Technology",
    description: "We invest in CEREC, intraoral scanning, and 3D diagnostics for faster, more predictable, and pain-free treatments.",
  },
  {
    title: "Bespoke Treatment Plans",
    description: "No templated solutions. Every clinical pathway is crafted specifically for your timeline, jaw structure, and lifestyle.",
  },
  {
    title: "Transparent Pricing",
    description: "Upfront cost breakdowns with zero hidden fees. We provide detailed estimates and flexible financing options.",
  },
  {
    title: "Comprehensive Care",
    description: "From preventive care to cosmetic artistry to surgical implants — we handle everything under one roof by trusted specialists.",
  },
  {
    title: "Lifetime Relationships",
    description: "We are not just treating teeth; we are building lifelong partnerships in your personal dental health journey.",
  },
];
---

<section
  class="mx-auto w-[calc(100%-32px)] max-w-460 py-24 max-[620px]:w-[calc(100%-28px)] flex flex-col gap-32"
  id="about-why-us"
  aria-label="Clinic Advantages and Philosophy"
>
  
  <!-- alternating split block 1: our core values (delivering certainty) -->
  <div class="flex flex-col md:flex-row items-center justify-between gap-16 w-full">
    
    <!-- Left Column: Core Values Text & List -->
    <div class="w-full md:w-[50%] flex flex-col justify-center">
      <span class="text-[11px] font-bold text-accent-blue tracking-[0.25em] font-mono uppercase bg-slate-50 border border-slate-100 px-3.5 py-1 rounded-full w-fit mb-5 shadow-2xs">PHILOSOPHY</span>
      
      <h2 class="text-3xl md:text-5xl font-black text-heading tracking-tight mb-5 leading-[1.1]">
        Delivering Certainty
      </h2>
      
      <p class="text-base md:text-[17px] text-heading/80 leading-relaxed mb-8 font-medium">
        No cookie-cutter shortcuts. We design custom clinical pathways mapped completely to your jaw structure and aesthetic goals, ensuring absolute safety and predictable results.
      </p>

      <!-- Values Grid Stack -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {
          values.map((val) => (
            <div class="group/card flex flex-col gap-3 p-5 rounded-2xl border border-slate-100 bg-slate-50/30 hover:bg-white hover:border-accent-blue/30 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-accent-blue/15 to-card-blue/5 text-accent-blue border border-accent-blue/10 shadow-3xs group-hover/card:scale-105 transition-transform duration-300">
                  <span class="text-lg leading-none">{val.icon}</span>
                </div>
                <h3 class="text-[16px] font-black text-heading group-hover/card:text-card-blue transition-colors duration-300">{val.title}</h3>
              </div>
              <p class="text-[13px] text-heading/75 leading-relaxed font-medium">{val.description}</p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Right Column: Premium Visual Card (Clinic Art) -->
    <div class="w-full md:w-[45%] relative rounded-3xl overflow-hidden shadow-xs border border-slate-100 group transition-all duration-300 hover:shadow-md max-[760px]:order-first">
      <div class="relative h-[480px] bg-slate-50">
        <img 
          src="/images/about/clinic_art.png" 
          alt="Clinical Artistry Design" 
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-103"
        />
        <div class="absolute inset-0 bg-linear-to-t from-slate-950/30 via-transparent to-transparent"></div>
        <div class="absolute bottom-6 left-6 right-6 text-white z-10">
          <p class="text-[10px] font-bold text-accent-blue uppercase tracking-widest font-mono mb-1">DESIGN LAB</p>
          <h4 class="text-lg font-black tracking-tight">Precision Crystalline Concept</h4>
        </div>
      </div>
    </div>

  </div>

  <!-- alternating split block 2: why patients choose us (unparalleled experience) -->
  <div class="flex flex-col md:flex-row-reverse items-center justify-between gap-16 w-full">
    
    <!-- Right Column: Advantages Text & List -->
    <div class="w-full md:w-[50%] flex flex-col justify-center">
      <span class="text-[11px] font-bold text-accent-blue tracking-[0.25em] font-mono uppercase bg-slate-50 border border-slate-100 px-3.5 py-1 rounded-full w-fit mb-5 shadow-2xs">ADVANTAGES</span>
      
      <h2 class="text-3xl md:text-5xl font-black text-heading tracking-tight mb-5 leading-[1.1]">
        Why Patients Choose Us
      </h2>
      
      <p class="text-base md:text-[17px] text-heading/80 leading-relaxed mb-8 font-medium">
        We combine premium diagnostics, board-certified mastery, and customized care to deliver an elite patient experience, redefining standard clinical dentistry.
      </p>

      <!-- Benefits Bullet Stack -->
      <div class="flex flex-col gap-4">
        {
          benefits.map((benefit) => (
            <div class="group/item flex gap-5 p-5 rounded-2xl border border-slate-100 bg-slate-50/30 hover:bg-white hover:border-accent-blue/30 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-accent-blue/20 to-card-blue/10 text-accent-blue border border-accent-blue/15 shadow-3xs group-hover/item:scale-105 transition-transform duration-300">
                <span class="text-xs font-black">✓</span>
              </div>
              <div class="flex flex-col gap-1">
                <h3 class="text-[16px] font-black text-heading group-hover/item:text-card-blue transition-colors duration-300">{benefit.title}</h3>
                <p class="text-[13px] text-heading/75 leading-relaxed font-medium">{benefit.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Left Column: Premium Visual Card (Clinic Lounge) -->
    <div class="w-full md:w-[45%] relative rounded-3xl overflow-hidden shadow-xs border border-slate-100 group transition-all duration-300 hover:shadow-md">
      <div class="relative h-[480px] bg-slate-50">
        <img 
          src="/images/about/clinic_lounge.png" 
          alt="Clinic Spa Lounge Sanctuary" 
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-103"
        />
        <div class="absolute inset-0 bg-linear-to-t from-slate-950/30 via-transparent to-transparent"></div>
        <div class="absolute bottom-6 left-6 right-6 text-white z-10">
          <p class="text-[10px] font-bold text-accent-blue uppercase tracking-widest font-mono mb-1">SANCTUARY</p>
          <h4 class="text-lg font-black tracking-tight">Luxury Spa Practice Environment</h4>
        </div>
      </div>
    </div>

  </div>

</section>
