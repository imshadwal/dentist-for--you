  </div>

  <!-- Fullscreen Liquid Glass Backdrop Blur Overlay -->
  <div id="categories-glass-backdrop"></div>

  <!-- CTA -->
  <div class="mt-16 flex justify-center">
    <a
      class="inline-flex min-h-14.5 items-center gap-3 rounded-full bg-linear-to-r from-accent-blue to-card-blue py-0 pr-7 pl-3 text-base font-extrabold text-white no-underline shadow-[0_18px_34px_rgba(43,93,158,0.26)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_22px_42px_rgba(43,93,158,0.32)] max-[620px]:min-h-13 max-[620px]:pr-5.5 max-[620px]:text-sm"
      href="#contact-us"
    >
      <span
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/20"
        aria-hidden="true"
      >
        <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" role="img">
          <path
            d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5H19a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h1.25V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v8A1.5 1.5 0 0 0 5 19.5h14a1.5 1.5 0 0 0 1.5-1.5v-8h-17Zm3 3.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5a.75.75 0 0 1-.75-.75Z"
            fill="currentColor"
          ></path>
        </svg>
      </span>
      Explore our treatments
    </a>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrappers = document.querySelectorAll('.category-card-wrapper');
    const backdrop = document.getElementById('categories-glass-backdrop');
    
    if (wrappers.length > 0 && backdrop) {
      wrappers.forEach(wrapper => {
        const card = wrapper.querySelector('.category-showcase-card');
        if (!card) return;

        // Spotlight hover interaction (Apple iOS style) bound to the stable slot wrapper
        wrapper.addEventListener('mouseenter', () => {
          // Calculate dynamic horizontal shift to prevent viewport/container cropping
          const rect = wrapper.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const halfWidth = 290; // 580 / 2
          const padding = 24; // 24px safe padding from screen edge

          let shiftX = 0;
          const leftEdge = centerX - halfWidth;
          const rightEdge = centerX + halfWidth;

          if (leftEdge < padding) {
            shiftX = padding - leftEdge;
          } else if (rightEdge > window.innerWidth - padding) {
            shiftX = (window.innerWidth - padding) - rightEdge;
          }

          card.style.setProperty('--shift-x', `${shiftX}px`);

          wrapper.classList.add('active-hover');
          card.classList.add('card-popout');
          backdrop.classList.add('backdrop-active');
        });

        wrapper.addEventListener('mouseleave', () => {
          wrapper.classList.remove('active-hover');
          card.classList.remove('card-popout');
          backdrop.classList.remove('backdrop-active');
          card.style.setProperty('--shift-x', '0px');
        });
      });
    }

    // Intersection Observer for scroll-triggered slide-ins
    const observerOptions = {
      root: null,
      threshold: 0.1,
      rootMargin: '0px 0px -40px 0px'
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = Number(el.dataset.index ?? 0) * 80;
          
          setTimeout(() => {
            el.style.transform = 'translateY(0)';
            el.style.opacity = '1';
          }, delay);
          
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    wrappers.forEach(wrapper => observer.observe(wrapper));
  });
</script>

<style>
  /* Custom self-contained styles for high performance animations */
  @keyframes float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-4px);
    }
    100% {
      transform: translateY(0px);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  /* STABLE SLOT WRAPPER (Portrait Ratio, matches our team cards perfectly) */
  .category-card-wrapper {
    width: 320px;
    height: 450px;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
    z-index: 10;
  }

  .category-card-wrapper.active-hover {
    z-index: 90;
  }

  /* INITIAL COMPACT STATE (Clean layout, width matches exactly) */
  .category-showcase-card {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    cursor: pointer;
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 24px;
    box-shadow: 0 4px 20px rgba(41, 64, 115, 0.04);
    transition: 
      width 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      left 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      top 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.4s ease,
      border-color 0.4s ease,
      box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* COMPACT STATE INNER LAYOUT */
  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    padding: 8px 4px;
    justify-content: space-between;
  }

  .card-visual-section {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-orb-frame {
    width: 180px;
    height: 180px;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-info-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .compact-footer {
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .expanded-only-content {
    max-height: 0px;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* FULLSCREEN LIQUID GLASS BACKDROP BLUR OVERLAY */
  #categories-glass-backdrop {
    position: fixed;
    inset: 0;
    z-index: 80;
    background-color: rgba(15, 23, 42, 0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  #categories-glass-backdrop.backdrop-active {
    opacity: 1;
  }

  /* EXPANDED DESKTOP STATE INNER LAYOUT */
  @media (min-width: 681px) {
    .category-showcase-card.card-popout {
      width: 580px;
      height: 450px;
      left: 50%;
      top: 50%;
      transform: translate(calc(-50% + var(--shift-x, 0px)), -50%) scale(1.04);
      z-index: 100;
      border-color: rgba(88, 179, 250, 0.35);
      background-color: rgba(255, 255, 255, 0.98);
      box-shadow: 
        0 24px 60px rgba(31, 63, 117, 0.22),
        0 0 40px rgba(88, 179, 250, 0.15);
    }

    .category-showcase-card.card-popout .card-inner {
      flex-direction: row;
      align-items: center;
      gap: 24px;
      padding: 16px;
    }

    .category-showcase-card.card-popout .card-visual-section {
      width: 42%;
      height: 100%;
      margin: 0;
      padding: 0;
    }

    .category-showcase-card.card-popout .card-orb-frame {
      width: 200px;
      height: 200px;
    }

    .category-showcase-card.card-popout .card-info-section {
      width: 58%;
      height: 100%;
      justify-content: center;
    }

    .category-showcase-card.card-popout .compact-footer {
      display: none;
    }

    .category-showcase-card.card-popout .expanded-only-content {
      max-height: 280px;
      opacity: 1;
      pointer-events: auto;
      margin-top: 12px;
    }
  }

  /* Responsive Stacking for small viewports */
  @media (max-width: 680px) {
    .category-card-wrapper {
      width: 100% !important;
      max-width: 320px !important;
      height: 450px !important;
    }
    
    .category-showcase-card {
      position: absolute !important;
      width: 100% !important;
      height: 100% !important;
    }

    .category-showcase-card.card-popout {
      width: 100% !important;
      height: 520px !important;
      left: 0 !important;
      top: 0 !important;
      transform: translateY(-16px) scale(1.03) !important;
      z-index: 100;
      border-color: rgba(88, 179, 250, 0.35);
      background-color: rgba(255, 255, 255, 0.98);
      box-shadow: 
        0 24px 60px rgba(31, 63, 117, 0.22);
    }

    .category-showcase-card.card-popout .compact-footer {
      display: none;
    }

    .category-showcase-card.card-popout .expanded-only-content {
      max-height: 300px !important;
      opacity: 1 !important;
      pointer-events: auto !important;
      margin-top: 12px;
    }
  }
</style>
