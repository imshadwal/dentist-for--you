---
const treatmentCategories = [
  {
    id: "pain-relief",
    title: "Pain Relief",
    tagline: "Stop the pain, start the relief.",
    treatments: ["Root canal treatment", "Disimpaction", "Composite fillings"],
  },
  {
    id: "teeth-replacement",
    title: "Teeth Replacement",
    tagline: "The confidence of a complete smile.",
    treatments: ["Bridges & crowns", "Dental implants", "Complete & RPD dentures"],
  },
  {
    id: "cosmetic-dentistry",
    title: "Cosmetic Dentistry",
    tagline: "A smile designed to look like yours — brighter and more balanced.",
    treatments: [
      "Smile makeover",
      "Teeth whitening",
      "Clear aligners",
      "Braces",
      "Laminates & veneers",
    ],
  },
  {
    id: "preventive-dentistry",
    title: "Preventive Dentistry",
    tagline: "Keep your natural teeth healthy for longer.",
    treatments: [
      "Advanced gum treatment",
      "Bad breath treatment",
      "Teeth cleaning",
      "Mouth ulcers",
    ],
  },
  {
    id: "kids-dentistry",
    title: "Kids Dentistry",
    tagline: "Gentle visits that make the next one easier.",
    treatments: [
      "Pediatric checkup",
      "Kids cavity treatment",
      "Fluoride treatment",
      "Habit counseling",
    ],
  },
];

const whatsappNumber = "919935027027";

const bookingLink = (title: string) => {
  const message = `Hello, I would like to book an appointment for ${title} at Dentist for you.`;
  return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
};
---

<section
  class="mx-auto w-full max-w-[1760px] px-4 sm:px-5 md:px-8 pt-10 pb-16 md:pt-12 md:pb-20"
  id="treatment-categories"
  aria-labelledby="categories-title"
>
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">
    <div class="max-w-xl">
      <p class="eyebrow">Treatment menu</p>
      <h2
        id="categories-title"
        class="mt-3 text-[clamp(32px,4vw,52px)] font-extrabold leading-[1.18] text-heading tracking-tight"
      >
        Every smile deserves specialized care
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-body">
        Five focused paths — from pain relief to kids’ visits — led by Dr. Shukla.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {
      treatmentCategories.map((category, idx) => (
        <article
          id={category.id}
          class={`scroll-mt-40 flex flex-col rounded-[28px] border border-[#d6e6fb] bg-white p-6 sm:p-8 shadow-[0_12px_32px_rgba(31,63,117,0.06)] ${
            idx === 4 ? "md:col-span-2" : ""
          }`}
        >
          <p class="m-0 text-base font-extrabold tabular-nums tracking-tight text-card-blue">
            {String(idx + 1).padStart(2, "0")}
          </p>
          <h3 class="mt-3 text-[clamp(22px,2vw,30px)] font-extrabold leading-tight text-heading">
            {category.title}
          </h3>
          <p class="mt-2 text-lg leading-relaxed text-body">{category.tagline}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {category.treatments.map((treatment) => (
              <span class="rounded-full border border-[#d6e6fb] bg-[#f8fbff] px-3 py-1.5 text-base font-semibold text-heading">
                {treatment}
              </span>
            ))}
          </div>
          <a
            href={bookingLink(category.title)}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-2 text-base font-extrabold text-card-blue no-underline hover:text-heading"
          >
            Book {category.title}
            <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>
</section>
