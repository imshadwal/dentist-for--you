---

<section
  class="mx-auto w-full max-w-[1280px] px-6 md:px-12 py-20 md:py-28 overflow-visible"
  id="treatment-categories"
  aria-labelledby="categories-title"
>
  <div class="text-center mb-16">
    <p class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase">
      Treatment Menu
    </p>
    <h2
      id="categories-title"
      class="mt-3 text-[clamp(32px,4vw,56px)] font-extrabold leading-[1.18] text-heading tracking-tight capitalize"
    >
      Every Smile Deserves Specialized Care
    </h2>
    <p class="mx-auto mt-4 max-w-lg text-base text-heading/70 leading-relaxed">
      Explore our premium interactive horizontal menu, showcasing advanced clinical concepts and specialized care.
     <!-- Centered Scroll-Reveal Treatments List -->
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-24">
    {
      treatmentCategories.map((category, idx) => (
        <div
          class={`reveal-text-block text-center flex flex-col items-center ${
            idx === 4 ? "md:col-span-2 max-w-3xl mx-auto" : ""
          }`}
          data-reveal-block
        >
          <!-- Badge -->
          <span class="text-[11px] font-bold tracking-[0.25em] text-accent-blue/85 uppercase">
            Category 0{idx + 1}
          </span>
          
          <!-- Emoji + Title -->
          <div class="flex items-center justify-center gap-3 mt-4">
            <span class="text-2xl md:text-3xl">{category.emoji}</span>
            <h3 class="text-[clamp(24px,2.5vw,36px)] font-extrabold text-heading tracking-tight leading-tight transition-colors duration-500">
              {category.title}
            </h3>
          </div>

          <!-- Tagline -->
          <p class="mt-2 text-sm md:text-base font-bold text-slate-500 tracking-wide">
            {category.tagline}
          </p>

          <!-- Description -->
          <p class="mt-4 text-sm md:text-[16px] text-heading/75 leading-relaxed max-w-2xl">
            {category.description}
          </p>

          <!-- Treatments List -->
          <div class="mt-6 flex flex-wrap justify-center gap-2 max-w-2xl">
            {category.treatments.map((treatment) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-50 border border-slate-200/60 text-xs font-semibold text-heading/85 shadow-3xs transition-all hover:scale-[1.02] hover:bg-white duration-300">
                <span class="inline-flex h-3.5 w-3.5 items-center justify-center rounded-full bg-linear-to-br from-accent-blue to-card-blue text-[8px] text-white">✓</span>
                {treatment}
              </span>
            ))}
          </div>

          <!-- Action button -->
          <div class="mt-8">
            <a
              href="#contact-us"
              class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-accent-blue hover:text-card-blue transition-colors duration-300 no-underline"
            >
              Book {category.title}
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Explore CTA -->
  <div class="mt-24 flex justify-center">
    <a
      class="inline-flex min-h-14.5 items-center gap-3 rounded-full bg-linear-to-r from-accent-blue to-card-blue py-0 pr-7 pl-3 text-base font-extrabold text-white no-underline shadow-[0_18px_34px_rgba(43,93,158,0.26)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_22px_42px_rgba(43,93,158,0.32)] max-[620px]:min-h-13 max-[620px]:pr-5.5 max-[620px]:text-sm"
      href="#contact-us"
    >
      <span
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/20"
        aria-hidden="true"
      >
        <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" role="img">
          <path
            d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5H19a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h1.25V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v8A1.5 1.5 0 0 0 5 19.5h14a1.5 1.5 0 0 0 1.5-1.5v-8h-17Zm3 3.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5a.75.75 0 0 1-.75-.75Z"
            fill="currentColor"
          ></path>
        </svg>
      </span>
      Explore our treatments
    </a>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const blocks = document.querySelectorAll('[data-reveal-block]');
    
    const observerOptions = {
      root: null,
      rootMargin: '-20% 0px -20% 0px', // Trigger reveal when block is inside center 60% of viewport
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        } else {
          entry.target.classList.remove('is-visible');
        }
      });
    }, observerOptions);

    blocks.forEach(block => observer.observe(block));
  });
</script>

<style>
  .reveal-text-block {
    opacity: 0.15;
    transform: translateY(35px) scale(0.97);
    filter: blur(2px);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity, filter;
  }

  .reveal-text-block.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
</style>
