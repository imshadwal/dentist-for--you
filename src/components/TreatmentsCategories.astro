---
// src/components/TreatmentsCategories.astro
const treatmentCategories = [
  {
    id: "pain-relief",
    title: "Pain Relief",
    iconType: "pain",
    tagline: "Stop the Pain, Start the relief",
    description: "Turning toothaches back into happy smiles.",
    color: "from-blue-600 to-indigo-600",
    glowColor: "shadow-blue-100/50 bg-blue-500/10",
    image: "/images/treatments/3d_pain_relief.png",
    treatments: [
      "Root Canal Treatment",
      "Disimpaction",
      "Composite fillings",
    ],
  },
  {
    id: "teeth-replacement",
    title: "Teeth Replacement",
    iconType: "replacement",
    tagline: "Smile out loud again",
    description: "The confidence of a complete smile.",
    color: "from-blue-600 to-indigo-600",
    glowColor: "shadow-blue-100/50 bg-blue-500/10",
    image: "/images/treatments/3d_replacement.png",
    treatments: [
      "Bridges & Crown",
      "Dental implants",
      "Complete & RPD Dentures",
    ],
  },
  {
    id: "cosmetic-dentistry",
    title: "Cosmetic Dentistry",
    iconType: "cosmetic",
    tagline: "Your dream smile, art fully created.",
    description: "Designing smiles as unique as you are.",
    color: "from-blue-600 to-indigo-600",
    glowColor: "shadow-blue-100/50 bg-blue-500/10",
    image: "/images/treatments/3d_cosmetic.png",
    treatments: [
      "Smile Makeover",
      "Teeth Whitening",
      "Clear Aligners",
      "Braces & Aligners",
      "Laminates & Veneers",
    ],
  },
  {
    id: "preventive-dentistry",
    title: "Preventive Dentistry",
    iconType: "preventive",
    tagline: "Protecting your smile today for a healthier tomorrow.",
    description: "Smart care to keep your natural smile for life",
    color: "from-blue-600 to-indigo-600",
    glowColor: "shadow-blue-100/50 bg-blue-500/10",
    image: "/images/treatments/excellence_shield.png",
    treatments: [
      "Advanced Gum Treatment",
      "Bad Breath Treatment",
      "Teeth Cleaning",
      "Mouth Ulcers",
    ],
  },
  {
    id: "kids-dentistry",
    title: "Kids Dentistry",
    iconType: "kids",
    tagline: "When little smile get gentle care",
    description: "Making dental visit fun, one smile at a time.",
    color: "from-blue-600 to-indigo-600",
    glowColor: "shadow-blue-100/50 bg-blue-500/10",
    image: "/images/treatments/3d_kids_dentistry.png",
    treatments: [
      "Pediatric Dental Checkup",
      "Kids Cavity Treatment",
      "Fluoride Treatment",
      "Habit Counseling",
    ],
  },
];
---

<section
  class="mx-auto w-full max-w-[1760px] px-2 sm:px-4 md:px-6 py-16 md:py-24 overflow-visible"
  id="treatment-categories"
  aria-labelledby="categories-title"
>
  <div class="text-center mb-16">
    <p class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase">
      Treatment Menu
    </p>
    <h2
      id="categories-title"
      class="mt-3 text-[clamp(32px,4vw,56px)] font-extrabold leading-[1.18] text-heading tracking-tight capitalize"
    >
      Every Smile Deserves Specialized Care
    </h2>
    <p class="mx-auto mt-4 max-w-lg text-base text-heading/70 leading-relaxed">
      Explore our premium interactive horizontal menu, showcasing advanced clinical concepts and specialized care.
    </p>
  </div>

  <!-- Centered Scroll-Reveal Treatments List -->
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-24">
    {
      treatmentCategories.map((category, idx) => (
        <div
          class={`reveal-text-block text-center flex flex-col items-center ${
            idx === 4 ? "md:col-span-2 max-w-3xl mx-auto" : ""
          }`}
          data-reveal-block
        >
          <!-- Badge -->
          <span class="text-[11px] font-bold tracking-[0.25em] text-accent-blue/85 uppercase">
            Category 0{idx + 1}
          </span>
          
          <!-- Blue Theme Icon + Title -->
          <div class="flex items-center justify-center gap-3.5 mt-4">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-linear-to-br from-[#2b5d9e] to-[#58b3fa] text-white shadow-md shadow-[#2b5d9e]/20">
              {category.iconType === "pain" && (
                <svg class="h-5.5 w-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
              )}
              {category.iconType === "replacement" && (
                <svg class="h-5.5 w-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                </svg>
              )}
              {category.iconType === "cosmetic" && (
                <svg class="h-5.5 w-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 3h12l4 6-10 12L2 9z"/>
                  <path d="M11 3v18M2 9h20"/>
                </svg>
              )}
              {category.iconType === "preventive" && (
                <svg class="h-5.5 w-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              )}
              {category.iconType === "kids" && (
                <svg class="h-5.5 w-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              )}
            </span>
            <h3 class="text-[clamp(24px,2.5vw,36px)] font-extrabold text-heading tracking-tight leading-tight transition-colors duration-500">
              {category.title}
            </h3>
          </div>

          <!-- Tagline -->
          <p class="mt-2 text-sm md:text-base font-bold text-slate-500 tracking-wide">
            {category.tagline}
          </p>

          <!-- Description -->
          <p class="mt-4 text-sm md:text-[16px] text-heading/75 leading-relaxed max-w-2xl">
            {category.description}
          </p>

          <!-- Treatments List -->
          <div class="mt-6 flex flex-wrap justify-center gap-2 max-w-2xl">
            {category.treatments.map((treatment) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-50 border border-slate-200/60 text-xs font-semibold text-heading/85 shadow-3xs transition-all hover:scale-[1.02] hover:bg-white duration-300">
                <span class="inline-flex h-3.5 w-3.5 items-center justify-center rounded-full bg-linear-to-br from-[#2b5d9e] to-[#58b3fa] text-[8px] text-white">✓</span>
                {treatment}
              </span>
            ))}
          </div>

          <!-- Action Button -->
          <a
            href="/contact-us"
            class="mt-8 inline-flex items-center gap-2 text-xs font-extrabold tracking-widest text-[#2b5d9e] uppercase transition-all duration-300 hover:gap-3 hover:text-accent-blue"
          >
            <span>Book {category.title}</span>
            <span class="text-sm">→</span>
          </a>
        </div>
      ))
    }
  </div>
</section>

<script>
  const revealBlocks = document.querySelectorAll('[data-reveal-block]');

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 }
  );

  revealBlocks.forEach((block) => revealObserver.observe(block));
</script>
