---

<section
  class="mx-auto w-[calc(100%-32px)] max-w-460 py-24 max-[620px]:w-[calc(100%-28px)] overflow-visible"
  id="treatment-categories"
  aria-labelledby="categories-title"
>
  <div class="text-center mb-16">
    <p class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase">
      Treatment Menu
    </p>
    <h2
      id="categories-title"
      class="mt-3 text-4xl font-extrabold leading-[1.08] text-heading tracking-tight"
    >
      Every smile deserves specialized care
    </h2>
    <p class="mx-auto mt-4 max-w-lg text-sm text-heading/70 leading-relaxed">
      Explore our elite treatments through our interactive cards below, showcasing advanced clinical concepts and specialized care.
    </p>
  </div>

  <!-- Centered flex-wrap list of card wrappers -->
  <div 
    class="flex flex-wrap gap-8 justify-center items-center transition-all duration-500 w-full"
    id="categories-container"
  >
    {
      treatmentCategories.map((category, idx) => (
        /* Stable slot wrapper to perfectly maintain layout dimensions and match Team cards ratio */
        <div
          class="category-card-wrapper relative flex items-center justify-center translate-y-8 opacity-0"
          data-index={idx}
          data-wrapper-id={category.id}
        >
          <article
            class="category-showcase-card group overflow-hidden rounded-3xl border border-slate-100 p-6 flex flex-col justify-between"
            data-card-id={category.id}
          >
            <!-- Accent color gradient line at top -->
            <div class={`absolute top-0 left-0 right-0 h-1 bg-linear-to-r ${category.color}`}></div>

            <div class="card-inner">
              
              <!-- Upper Section (Visual clinical concept with 3D model) -->
              <div class="card-visual-section">
                <div class="card-orb-frame relative flex items-center justify-center rounded-full">
                  <div class={`absolute inset-0 rounded-full ${category.glowColor} blur-md transition-transform duration-500 group-hover:scale-110`}></div>
                  <div class="absolute inset-1 rounded-full bg-linear-to-b from-white to-slate-50/50 shadow-inner border border-white/60 overflow-hidden flex items-center justify-center">
                    <img
                      src={category.image}
                      alt={`${category.title} Concept`}
                      class="h-[75%] w-auto object-contain z-10 animate-float mix-blend-multiply transition-transform duration-500 group-hover:scale-105"
                    />
                  </div>
                </div>
              </div>
              
              <!-- Lower Section (Interactive Info) -->
              <div class="card-info-section">
                
                <!-- Emoji & Title Header -->
                <div class="flex items-center gap-3">
                  <div class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-linear-to-br ${category.color} text-white shadow-sm`}>
                    <span class="text-base">{category.emoji}</span>
                  </div>
                  <h3 class="text-lg font-extrabold text-heading tracking-tight">{category.title}</h3>
                </div>

                <p class="mt-3 text-xs text-heading/75 leading-relaxed card-description">
                  {category.description}
                </p>

                <!-- Compact-only Indicator -->
                <div class="compact-footer mt-4 flex items-center justify-between border-t border-slate-100 pt-3 w-full">
                  <span class="text-[10px] font-bold text-accent-blue/80 tracking-wider uppercase">Hover to expand</span>
                  <svg class="h-3.5 w-3.5 text-accent-blue/80 animate-pulse" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </div>

                <!-- Expanded-only Content Block -->
                <div class="expanded-only-content">
                  <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Available Procedures</h4>
                  <div class="flex flex-wrap gap-1.5">
                    {category.treatments.map((treatment) => (
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-50 border border-slate-100 text-[10px] font-bold text-heading/85 hover:scale-105 transition-transform">
                        <span class="inline-flex h-3 w-3 items-center justify-center rounded-full bg-linear-to-br from-accent-blue to-card-blue text-[6px] text-white">✓</span>
