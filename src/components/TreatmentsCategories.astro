---
const treatmentCategories = [
  {
    id: "pain-relief",
    title: "Pain Relief",
    emoji: "💊",
    description: "Advanced solutions for dental pain and discomfort",
    color: "from-red-400 to-rose-500",
    treatments: [
      "Root Canal Treatment",
      "Wisdom Teeth Removal",
      "Jaw Pain Treatment",
    ],
  },
  {
    id: "teeth-replacement",
    title: "Teeth Replacement",
    emoji: "✨",
    description: "Restore your smile with modern replacement options",
    color: "from-blue-400 to-cyan-500",
    treatments: ["Dentures", "Dental Implants", "Bridges & Crowns"],
  },
  {
    id: "cosmetic-dentistry",
    title: "Cosmetic Dentistry",
    emoji: "💎",
    description: "Enhance your smile with aesthetic treatments",
    color: "from-purple-400 to-pink-500",
    treatments: [
      "Smile Makeover",
      "Teeth Whitening",
      "Clear Aligners",
      "Braces & Aligners",
      "Laminates & Veneers",
    ],
  },
  {
    id: "preventive-dentistry",
    title: "Preventive Dentistry",
    emoji: "🛡️",
    description: "Keep your teeth healthy with preventive care",
    color: "from-green-400 to-emerald-500",
    treatments: [
      "Advanced Gum Treatment",
      "Bad Breath Treatment",
      "Teeth Cleaning",
      "Mouth Ulcers",
    ],
  },
  {
    id: "kids-dentistry",
    title: "Kids Dentistry",
    emoji: "🦷",
    description: "Specialized dental care for children",
    color: "from-orange-400 to-amber-500",
    treatments: [
      "Pediatric Dental Checkup",
      "Kids Cavity Treatment",
      "Fluoride Treatment",
      "Habit Counseling",
    ],
  },
];
---

<section
  class="mx-auto w-[calc(100%-32px)] max-w-460 py-[clamp(40px,8vw,100px)] max-[620px]:w-[calc(100%-28px)]"
  id="treatment-categories"
  aria-labelledby="categories-title"
>
  <div class="text-center mb-[clamp(40px,6vw,80px)]">
    <p class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase">
      Treatment Menu
    </p>
    <h2
      id="categories-title"
      class="mt-3 text-[clamp(36px,4.4vw,56px)] font-extrabold leading-[1.05] text-heading"
    >
      Every smile deserves specialized care
    </h2>
  </div>

  <!-- Categories Grid -->
  <div class="space-y-6 max-[900px]:space-y-5">
    {
      treatmentCategories.map((category) => (
        <article
          class="group relative overflow-hidden rounded-2xl border border-[#d6e6fb] shadow-[0_12px_24px_rgba(31,63,117,0.12)] transition-all duration-300 hover:shadow-[0_24px_48px_rgba(31,63,117,0.18)] hover:border-card-blue/50"
          data-category={category.id}
        >
          <!-- Category Header -->
          <div
            class="relative overflow-hidden p-[clamp(24px,3vw,40px)] bg-linear-to-r from-white to-accent-blue/5 transition-all duration-300 group-hover:from-accent-blue/5"
          >
            <!-- Accent background -->
            <div
              class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-linear-to-r from-transparent via-white/30 to-transparent"
              aria-hidden="true"
            ></div>

            <div class="relative z-1 flex items-start justify-between gap-6">
              <div class="grow">
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-3xl">{category.emoji}</span>
                  <h3 class="text-[clamp(22px,2.2vw,28px)] font-extrabold text-heading">
                    {category.title}
                  </h3>
                </div>
                <p class="text-[14px] leading-[1.4] text-heading/70">
                  {category.description}
                </p>
              </div>

              <div class="shrink-0">
                <div
                  class={`flex h-12 w-12 items-center justify-center rounded-xl bg-linear-to-br ${category.color} opacity-20 transform transition-all duration-300 group-hover:opacity-100 group-hover:scale-110`}
                  aria-hidden="true"
                >
                  <svg
                    class="h-6 w-6 text-heading/40 group-hover:text-white"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Treatments List -->
          <div class="relative z-2 border-t border-[#e8f0f8] bg-linear-to-b from-white/50 to-white p-[clamp(20px,3vw,32px)]">
            <ul
              class="grid grid-cols-2 gap-[clamp(12px,1.8vw,16px)] max-[620px]:grid-cols-1"
              role="list"
            >
              {category.treatments.map((treatment, index) => (
                <li
                  class="group/item flex items-start gap-3 p-3 rounded-lg bg-white/50 border border-transparent transition-all duration-200 hover:bg-linear-to-br hover:from-accent-blue/5 hover:to-card-blue/5 hover:border-card-blue/30"
                  role="listitem"
                >
                  <span
                    class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-accent-blue to-card-blue text-[11px] font-bold text-white mt-0.5"
                    aria-hidden="true"
                  >
                    ✓
                  </span>
                  <span class="text-[13px] font-semibold text-heading leading-tight group-hover/item:text-card-blue transition-colors duration-200">
                    {treatment}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom accent line -->
          <div
            class={`absolute bottom-0 left-0 h-1 bg-linear-to-r ${category.color} transform transition-all duration-300 group-hover:w-full`}
            style="width: 0%;"
            aria-hidden="true"
          ></div>
        </article>
      ))
    }
  </div>

  <!-- CTA -->
  <div class="mt-[clamp(40px,8vw,60px)] flex justify-center">
    <a
      class="inline-flex min-h-14.5 items-center gap-3 rounded-full bg-linear-to-r from-accent-blue to-card-blue py-0 pr-7 pl-3 text-base font-extrabold text-white no-underline shadow-[0_18px_34px_rgba(43,93,158,0.26)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_22px_42px_rgba(43,93,158,0.32)] max-[620px]:min-h-13 max-[620px]:pr-5.5 max-[620px]:text-sm"
      href="#contact-us"
    >
      <span
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/20"
        aria-hidden="true"
      >
        <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" role="img">
          <path
            d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5H19a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h1.25V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v8A1.5 1.5 0 0 0 5 19.5h14a1.5 1.5 0 0 0 1.5-1.5v-8h-17Zm3 3.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5a.75.75 0 0 1-.75-.75Z"
            fill="currentColor"
          ></path>
        </svg>
      </span>
      Explore our treatments
    </a>
  </div>
</section>
