<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrappers = document.querySelectorAll('.category-card-wrapper');
    
    // Intersection Observer for scroll-triggered slide-ins
    const observerOptions = {
      root: null,
      threshold: 0.1,
      rootMargin: '0px 0px -40px 0px'
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = Number(el.dataset.index ?? 0) * 80;
          
          setTimeout(() => {
            el.style.transform = 'translateY(0)';
            el.style.opacity = '1';
          }, delay);
          
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    wrappers.forEach(wrapper => observer.observe(wrapper));
  });
</script>

<style>
  /* Custom self-contained styles for high performance animations */
  @keyframes float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-4px);
    }
    100% {
      transform: translateY(0px);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  /* STABLE SLOT WRAPPER (Portrait Ratio, matches our team cards perfectly) */
  .category-card-wrapper {
    width: 320px;
    height: 450px;
    perspective: 1200px;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
    z-index: 10;
  }

  /* 3D CARD CONTAINER */
  .category-showcase-card {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
    border-radius: 24px;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(41, 64, 115, 0.04);
  }

  /* FLIP TRIGGERS ON WRAPPER HOVER */
  .category-card-wrapper:hover .category-showcase-card {
    transform: rotateY(180deg);
    box-shadow: 
      0 24px 60px rgba(31, 63, 117, 0.16),
      0 0 30px rgba(88, 179, 250, 0.08);
  }

  /* FRONT & BACK FACES */
  .card-face-front,
  .card-face-back {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    transition: border-color 0.3s ease;
  }

  /* FRONT FACE STYLE */
  .card-face-front {
    background-color: rgba(255, 255, 255, 0.98);
    border: 1px solid #f1f5f9;
    z-index: 2;
  }

  /* BACK FACE STYLE (Theme matches reference exactly!) */
  .card-face-back {
    transform: rotateY(180deg);
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    z-index: 1;
  }

  .category-card-wrapper:hover .card-face-front {
    border-color: rgba(88, 179, 250, 0.2);
  }

  /* INNER LAYOUT UTILS */
  .card-visual-section {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 16px;
  }

  .card-orb-frame {
    width: 180px;
    height: 180px;
  }

  .card-info-section {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .compact-footer {
    width: 100%;
  }

  /* Responsive Stacking for small viewports */
  @media (max-width: 680px) {
    .category-card-wrapper {
      width: 100% !important;
      max-width: 320px !important;
      height: 450px !important;
    }
  }
</style>
