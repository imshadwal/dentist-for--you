                  <a 
                    href="#contact-us" 
                    class={`inline-flex items-center justify-center text-center mt-5 w-full py-2.5 px-4 rounded-xl bg-linear-to-r ${category.color} text-white text-xs font-bold shadow-md hover:scale-[1.02] active:scale-[0.98] transition-all no-underline`}
                  >
