---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<section class="mx-auto w-full max-w-[1760px] px-2 sm:px-4 md:px-6 py-16 md:py-24">
  <div class="max-w-3xl">
    <p class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase">Legal</p>
    <h1 class="mt-3 text-[clamp(32px,4vw,52px)] font-extrabold leading-[1.18] text-heading tracking-tight">
      {title}
    </h1>
    {description && (
      <p class="mt-4 text-base leading-relaxed text-heading/70">{description}</p>
    )}
    <p class="mt-2 text-sm text-heading/50">Last updated: 15 August 2026</p>

    <div class="legal-copy mt-10 space-y-8 text-[15px] leading-relaxed text-heading/80">
      <slot />
    </div>

    <nav class="mt-14 pt-6 border-t border-[#d6e6fb] flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold" aria-label="Legal pages">
      <a class="text-card-blue hover:underline" href="/privacy-policy">Privacy policy</a>
      <a class="text-card-blue hover:underline" href="/terms-of-service">Terms of service</a>
      <a class="text-card-blue hover:underline" href="/cookie-policy">Cookie policy</a>
      <a class="text-card-blue hover:underline" href="/patient-consent">Patient consent & disclaimer</a>
    </nav>
  </div>
</section>

<style>
  .legal-copy :global(h2) {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-heading);
  }
  .legal-copy :global(p),
  .legal-copy :global(ul) {
    margin: 0.75rem 0 0;
  }
  .legal-copy :global(ul) {
    padding-left: 1.2rem;
  }
  .legal-copy :global(li) {
    margin-top: 0.4rem;
  }
  .legal-copy :global(a) {
    color: var(--color-card-blue);
    font-weight: 600;
  }
</style>
