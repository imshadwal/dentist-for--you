---
const testimonials = [
  {
    tab: "Aesthetic dentistry",
    title: "Kriti's smile,",
    subtitle: "transformed.",
    summary:
      "Kriti felt self-conscious about the gaps and uneven shape of her teeth. She wanted a natural, brighter smile that still felt like her own - just more balanced, polished, and confident.",
    highlights: [
      "Smile design planning with digital preview",
      "Minimal tooth preparation to preserve enamel",
      "Placement of ultra-thin porcelain veneers",
    ],
    beforeImage: "/images/testimonials/aesthetic_before.png",
    afterImage: "/images/testimonials/aesthetic_after.png",
    beforeAlt: "Before aesthetic dentistry smile",
    afterAlt: "After aesthetic dentistry smile",
    portrait: "/images/testimonials/portrait_kriti.png",
    portraitAlt: "Portrait of Kriti smiling",
    caption:
      "Kriti's smile, before and after - confident, complete, and truly hers.",
  },
  {
    tab: "Orthodontics",
    title: "Aarav's bite,",
    subtitle: "rebalanced.",
    summary:
      "Crowding and a deep bite made cleaning difficult and left Aarav hesitant to smile. A clear aligner series delivered steady, measurable progress without disrupting his schedule.",
    highlights: [
      "Digital bite analysis and precision mapping",
      "Clear aligner series with weekly tracking",
      "Custom retention plan to lock in results",
    ],
    beforeImage: "/images/testimonials/ortho_before.png",
    afterImage: "/images/testimonials/ortho_after.png",
    beforeAlt: "Before orthodontic alignment",
    afterAlt: "After orthodontic alignment",
    portrait: "/images/testimonials/portrait_aarav.png",
    portraitAlt: "Portrait of Aarav smiling",
    caption: "Aarav's alignment journey, step-by-step and on schedule.",
  },
  {
    tab: "Implantology",
    title: "Ananya's confidence,",
    subtitle: "restored.",
    summary:
      "A missing molar had Ananya chewing on one side and hiding her smile in photos. A guided implant and custom ceramic crown brought back full function with a seamless match.",
    highlights: [
      "3D cone-beam scan and bone planning",
      "Guided implant placement for precision",
      "Custom ceramic crown matched to enamel",
    ],
    beforeImage: "/images/testimonials/implant_before.png",
    afterImage: "/images/testimonials/implant_after.png",
    beforeAlt: "Before dental implant restoration",
    afterAlt: "After dental implant restoration",
    portrait: "/images/testimonials/portrait_ananya.png",
    portraitAlt: "Portrait of Ananya smiling",
    caption: "Ananya's implant blends in seamlessly with her natural smile.",
  },
  {
    tab: "Whitening",
    title: "Maya's brightness,",
    subtitle: "renewed.",
    summary:
      "Years of coffee and tea left Maya's smile dull and uneven. A sensitivity-safe whitening protocol lifted the shade evenly, then take-home trays kept it radiant.",
    highlights: [
      "Shade assessment and sensitivity prep",
      "In-chair whitening with gum protection",
      "Custom take-home trays for maintenance",
    ],
    beforeImage: "/images/testimonials/whitening_before.png",
    afterImage: "/images/testimonials/whitening_after.png",
    beforeAlt: "Before teeth whitening",
    afterAlt: "After teeth whitening",
    portrait: "/images/testimonials/portrait_maya.png",
    portraitAlt: "Portrait of Maya smiling",
    caption: "Maya's whitening results look bright but still natural.",
  },
];

const defaultTab = testimonials[0];
---

<section
  class="mx-auto w-full max-w-[1760px] px-4 sm:px-5 md:px-8 py-20 md:py-28"
  id="testimonials"
  aria-labelledby="testimonials-title"
  data-testimonials
>
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">
    <div class="max-w-xl">
      <p class="eyebrow">Testimonials</p>
      <h2
        id="testimonials-title"
        class="mt-3 text-[clamp(32px,4.2vw,56px)] font-extrabold leading-[1.18] text-heading"
      >
        Real stories. Real smiles.
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-body">
        Visible change, told by the people who sat in the chair.
      </p>
    </div>

    <div
      class="flex flex-wrap gap-2"
      role="tablist"
      aria-label="Testimonial categories"
    >
      {
        testimonials.map((tab, index) => (
          <button
            type="button"
            role="tab"
            data-tab-trigger
            data-tab-index={index}
            aria-controls="testimonial-panel"
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? "0" : "-1"}
            class={`rounded-full border px-4 py-2 text-base font-semibold transition duration-200 ${
              index === 0
                ? "border-card-blue bg-card-blue text-white"
                : "border-[#d6e6fb] bg-white text-body hover:border-card-blue hover:text-heading"
            }`}
          >
            {tab.tab}
          </button>
        ))
      }
    </div>
  </div>

  <div
    class="mt-10 grid grid-cols-1 lg:grid-cols-[minmax(0,1.15fr)_minmax(280px,0.85fr)] overflow-hidden rounded-[28px] border border-[#d6e6fb] bg-white shadow-[0_18px_40px_rgba(31,63,117,0.08)]"
  >
    <div
      class="compare-slider relative isolate min-h-[280px] w-full overflow-hidden bg-[#e8f1fb] lg:min-h-[520px]"
      data-compare
    >
      <div
        class="absolute left-4 top-4 z-10 rounded-full bg-white px-3 py-1 text-base font-bold text-heading shadow-sm"
      >
        Before
      </div>
      <div
        class="absolute right-4 top-4 z-10 rounded-full bg-white px-3 py-1 text-base font-bold text-heading shadow-sm"
      >
        After
      </div>

      <img
        class="compare-before absolute inset-0 h-full w-full object-cover"
        src={defaultTab.beforeImage}
        alt={defaultTab.beforeAlt}
        data-before-image
        loading="lazy"
      />
      <img
        class="compare-after absolute inset-0 h-full w-full object-cover"
        src={defaultTab.afterImage}
        alt={defaultTab.afterAlt}
        data-after-image
        loading="lazy"
      />

      <div class="compare-divider absolute inset-y-0 z-10 w-0.5 bg-white"></div>
      <div
        class="compare-handle absolute top-1/2 z-20 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white text-sm font-extrabold text-heading shadow-[0_10px_24px_rgba(41,64,115,0.28)]"
        aria-hidden="true"
      >
        Drag
      </div>

      <input
        class="absolute inset-0 z-30 h-full w-full cursor-ew-resize opacity-0"
        type="range"
        min="0"
        max="100"
        value="50"
        data-compare-range
        aria-label="Drag to compare"
      />
      <div class="pointer-events-none aspect-4/3 w-full lg:hidden"></div>
    </div>

    <div
      class="flex flex-col justify-center gap-6 p-6 sm:p-8 lg:p-10"
      role="tabpanel"
      id="testimonial-panel"
      data-tab-panel
    >
      <div class="flex items-center gap-4">
        <img
          class="h-16 w-16 shrink-0 rounded-full object-cover ring-2 ring-[#d6e6fb]"
          src={defaultTab.portrait}
          alt={defaultTab.portraitAlt}
          data-portrait-image
          loading="lazy"
        />
        <h3 class="m-0 text-[clamp(22px,2.2vw,30px)] font-extrabold leading-[1.15] text-heading">
          <span data-tab-title>{defaultTab.title}</span>
          <span class="block" data-tab-subtitle>{defaultTab.subtitle}</span>
        </h3>
      </div>

      <p class="m-0 text-lg leading-relaxed text-body" data-tab-summary>
        {defaultTab.summary}
      </p>

      <div>
        <p class="m-0 text-base font-bold uppercase tracking-[0.12em] text-card-blue">
          What we did
        </p>
        <ul class="mt-3 flex flex-col gap-2.5" data-tab-list>
          {
            defaultTab.highlights.map((item) => (
              <li class="flex items-start gap-3 text-base leading-relaxed text-heading">
                <span
                  class="mt-1.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#2b5d9e] text-[11px] font-bold text-white"
                  aria-hidden="true"
                >
                  ✓
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <p
        class="m-0 border-t border-[#d6e6fb] pt-5 text-base leading-relaxed text-body"
        data-portrait-caption
      >
        {defaultTab.caption}
      </p>
    </div>
  </div>
  <script
    type="application/json"
    data-testimonials-data
    set:html={JSON.stringify(testimonials)}
  />
</section>

<script>
  const testimonialSections = document.querySelectorAll<HTMLElement>(
    "[data-testimonials]",
  );

  testimonialSections.forEach((section) => {
    const dataScript = section.querySelector<HTMLScriptElement>(
      "[data-testimonials-data]",
    );

    if (!dataScript?.textContent) {
      return;
    }

    let data = [];

    try {
      data = JSON.parse(dataScript.textContent);
    } catch {
      return;
    }

    if (!Array.isArray(data) || data.length === 0) {
      return;
    }

    const triggers = Array.from(
      section.querySelectorAll<HTMLButtonElement>("[data-tab-trigger]"),
    );
    const titleEl = section.querySelector<HTMLElement>("[data-tab-title]");
    const subtitleEl = section.querySelector<HTMLElement>(
      "[data-tab-subtitle]",
    );
    const summaryEl = section.querySelector<HTMLElement>("[data-tab-summary]");
    const listEl = section.querySelector<HTMLUListElement>("[data-tab-list]");
    const beforeImg = section.querySelector<HTMLImageElement>(
      "[data-before-image]",
    );
    const afterImg =
      section.querySelector<HTMLImageElement>("[data-after-image]");
    const portraitImg = section.querySelector<HTMLImageElement>(
      "[data-portrait-image]",
    );
    const captionEl = section.querySelector<HTMLElement>(
      "[data-portrait-caption]",
    );
    const panelEl = section.querySelector<HTMLElement>("[data-tab-panel]");

    const activeClasses = ["border-card-blue", "bg-card-blue", "text-white"];
    const inactiveClasses = [
      "border-[#d6e6fb]",
      "bg-white",
      "text-body",
      "hover:border-card-blue",
      "hover:text-heading",
    ];

    const renderHighlights = (items: string[]) => {
      if (!listEl) {
        return;
      }

      listEl.innerHTML = "";

      items.forEach((item) => {
        const listItem = document.createElement("li");
        listItem.className =
          "flex items-start gap-3 text-base leading-relaxed text-heading";

        const mark = document.createElement("span");
        mark.className =
          "mt-1.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#2b5d9e] text-[11px] font-bold text-white";
        mark.setAttribute("aria-hidden", "true");
        mark.textContent = "✓";

        const text = document.createElement("span");
        text.textContent = item;

        listItem.append(mark, text);
        listEl.appendChild(listItem);
      });
    };

    const applyTab = (index: number) => {
      const tab = data[index];
      if (!tab) {
        return;
      }

      triggers.forEach((button, buttonIndex) => {
        const isActive = buttonIndex === index;
        button.setAttribute("aria-selected", isActive ? "true" : "false");
        button.setAttribute("tabindex", isActive ? "0" : "-1");

        activeClasses.forEach((className) =>
          button.classList.toggle(className, isActive),
        );
        inactiveClasses.forEach((className) =>
          button.classList.toggle(className, !isActive),
        );
      });

      if (panelEl) {
        panelEl.setAttribute("aria-label", tab.tab);
      }

      if (titleEl) {
        titleEl.textContent = tab.title;
      }

      if (subtitleEl) {
        subtitleEl.textContent = tab.subtitle;
      }

      if (summaryEl) {
        summaryEl.textContent = tab.summary;
      }

      renderHighlights(tab.highlights);

      if (beforeImg) {
        beforeImg.src = tab.beforeImage;
        beforeImg.alt = tab.beforeAlt;
      }

      if (afterImg) {
        afterImg.src = tab.afterImage;
        afterImg.alt = tab.afterAlt;
      }

      if (portraitImg) {
        portraitImg.src = tab.portrait;
        portraitImg.alt = tab.portraitAlt;
      }

      if (captionEl) {
        captionEl.textContent = tab.caption;
      }
    };

    triggers.forEach((button) => {
      button.addEventListener("click", () => {
        const index = Number(button.dataset.tabIndex ?? 0);
        applyTab(index);
      });

      button.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") {
          return;
        }

        event.preventDefault();
        const currentIndex = Number(button.dataset.tabIndex ?? 0);
        const delta = event.key === "ArrowRight" ? 1 : -1;
        const nextIndex = (currentIndex + delta + data.length) % data.length;
        const nextButton = triggers[nextIndex];

        nextButton?.focus();
        applyTab(nextIndex);
      });
    });

    applyTab(0);

    const compareSections =
      section.querySelectorAll<HTMLElement>("[data-compare]");

    compareSections.forEach((compareSection) => {
      const range = compareSection.querySelector<HTMLInputElement>(
        "[data-compare-range]",
      );
      if (!range) {
        return;
      }

      const update = () => {
        compareSection.style.setProperty("--compare", `${range.value}%`);
      };

      update();
      range.addEventListener("input", update);
    });
  });
</script>

<style>
  .compare-slider {
    --compare: 50%;
  }

  .compare-slider img {
    object-position: center 65%;
  }

  .compare-before {
    clip-path: inset(0 calc(100% - var(--compare)) 0 0);
    z-index: 2;
  }

  .compare-after {
    z-index: 1;
  }

  .compare-divider {
    left: calc(var(--compare) - 1px);
    z-index: 10;
  }

  .compare-handle {
    left: calc(var(--compare) - 24px);
    z-index: 20;
  }
</style>
