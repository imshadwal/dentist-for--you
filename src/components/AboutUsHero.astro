---

---

<section
  class="relative mx-auto w-full max-w-[1760px] px-4 sm:px-5 md:px-8 pt-6 pb-8 md:pt-8 md:pb-10"
  id="about-hero"
  aria-labelledby="about-hero-title"
>
  <div
    class="grid grid-cols-2 gap-[clamp(24px,4vw,60px)] items-center max-[980px]:grid-cols-1 max-[980px]:gap-8"
  >
    <!-- Left: Content -->
    <div class="flex flex-col justify-center">
      <p
        class="eyebrow"
      >
        Our Story
      </p>
      <h1
        id="about-hero-title"
        class="mt-3 text-[clamp(32px,4vw,48px)] font-extrabold leading-[1.18] text-heading capitalize max-[620px]:text-[clamp(28px,9vw,44px)] max-[620px]:leading-[1.2]"
      >
        Redefining Dental Excellence
      </h1>
      <p
        class="mt-6 text-[clamp(18px,1.3vw,22px)] leading-relaxed text-body max-w-140"
      >
        At Dentist for you, Dr. Samanvaya Shukla provides calm, personal dental
        and orthodontic care for the whole family — precision with a gentle hand.
      </p>

      <div class="mt-6 flex gap-4">
        <a
          class="inline-flex min-h-14.5 items-center gap-3 rounded-full bg-linear-to-r from-accent-blue to-card-blue py-0 pr-7 pl-3 text-base font-extrabold text-white no-underline shadow-[0_18px_34px_rgba(43,93,158,0.26)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_22px_42px_rgba(43,93,158,0.32)] max-[620px]:min-h-13 max-[620px]:pr-5.5 max-[620px]:text-base"
          href="/contact-us"
        >
          <span
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/20"
            aria-hidden="true"
          >
            <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" role="img">
              <path
                d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5H19a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h1.25V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v8A1.5 1.5 0 0 0 5 19.5h14a1.5 1.5 0 0 0 1.5-1.5v-8h-17Zm3 3.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5a.75.75 0 0 1-.75-.75Z"
                fill="currentColor"></path>
            </svg>
          </span>
          Schedule a visit
        </a>
      </div>
    </div>

    <!-- Right: Premium Interactive Visual Element -->
    <div
      class="about-hero-visual relative group flex items-center justify-center h-[420px] max-[980px]:h-[320px] max-[620px]:h-[280px] rounded-3xl overflow-hidden shadow-[0_24px_48px_rgba(43,93,158,0.2)] border border-[#d6e6fb] bg-[#f8fafc]"
      aria-hidden="true"
    >
      <!-- Background Luxury Lounge with Zoom Effect -->
      <img
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        src="/images/photoshoot/IMG_6929.jpg"
        alt="Dentist for you Luxury Lounge"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-8px) rotate(1deg);
    }
    100% {
      transform: translateY(0px) rotate(0deg);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
</style>
