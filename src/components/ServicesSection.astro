---
const services = [
  {
    title: "Aesthetic dentistry",
    image: "/images/services/aesthetic_dentistry.png",
    alt: "Aesthetic dentistry",
    headline: "Aesthetic artistry",
    summary: "Veneers, bonding, and contouring for a balanced, luminous smile.",
  },
  {
    title: "Orthodontics",
    image: "/images/services/orthodontics.png",
    alt: "Orthodontic aligners",
    headline: "Alignment, refined",
    summary: "Clear aligners and braces with gentle, predictable movement.",
  },
  {
    title: "Implantology",
    image: "/images/services/implantology.png",
    alt: "Dental implant",
    headline: "Smile restoration, built to last",
    summary:
      "Permanent, natural-looking replacements created with precision and comfort.",
  },
  {
    title: "Whitening",
    image: "/images/services/whitening.png",
    alt: "Teeth whitening",
    headline: "Brightness, tailored",
    summary: "Lift stains safely while protecting enamel for a radiant finish.",
  },
  {
    title: "Surgical dentistry",
    image: "/images/services/surgical.png",
    alt: "Surgical dentistry",
    headline: "Precision surgical care",
    summary: "Guided procedures and expert aftercare for confident recovery.",
  },
];
---

<section
  class="mx-auto w-full max-w-[1280px] px-6 md:px-12 py-20 md:py-28"
  id="treatments"
  aria-labelledby="services-title"
>
  <div class="text-center">
    <p
      class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase"
    >
      Services
    </p>
    <h2
      id="services-title"
      class="mt-3 text-[clamp(32px,4vw,56px)] font-extrabold leading-[1.18] text-heading capitalize"
    >
      Expert Care For Every Smile
    </h2>
    <p
      class="mx-auto mt-4 max-w-180 text-[clamp(17px,1.2vw,20px)] leading-relaxed text-heading/70"
    >
      We offer a full spectrum of treatments - each tailored to elevate your
      health, confidence, and natural beauty.
    </p>
  </div>

  <div
    class="services-grid mt-[clamp(22px,3.6vw,40px)] flex flex-wrap gap-[clamp(12px,1.8vw,22px)]"
    data-services-grid
  >
    {
      services.map((service) => (
        <article
          class="service-card group relative flex h-65 w-full min-w-40 flex-[1_1_0%] items-stretch overflow-hidden rounded-2xl border border-[#d6e6fb] p-2 shadow-[0_18px_34px_rgba(31,63,117,0.18)] transition duration-300 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-blue/70 focus-visible:ring-offset-2 focus-visible:ring-offset-white max-[900px]:h-60 max-[620px]:min-w-full"
          data-service-card
          tabindex="0"
        >
          <div class="service-media relative flex h-full min-w-0 flex-[1_1_100%] items-end overflow-hidden rounded-xl">
            <img
              class="service-image h-full w-full object-cover"
              src={service.image}
              alt={service.alt}
              loading="lazy"
            />
            <p class="service-title absolute inset-x-0 bottom-3 mx-auto w-fit max-w-[90%] rounded-full bg-white/85 px-3 py-1 text-center text-[13px] font-semibold text-[#294073] backdrop-blur-sm">
              {service.title}
            </p>
          </div>

          <div class="service-info flex h-full min-w-0 flex-[0_0_0%] overflow-hidden opacity-0">
            <div class="service-panel flex h-full w-full flex-col justify-between rounded-xl bg-white/85 p-3 text-[#294073] shadow-[0_12px_24px_rgba(12,37,78,0.15)] backdrop-blur-sm">
              <div class="flex justify-end">
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-[#294073]/20 bg-[#294073]/10 text-[#294073]">
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    role="img"
                    aria-hidden="true"
                  >
                    <path
                      d="M7 17L17 7m0 0H9m8 0v8"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </div>
              <div>
                <p class="text-[10px] font-semibold tracking-[0.32em] text-[#294073]/60 uppercase">
                  Service
                </p>
                <p class="mt-2 text-[14px] font-semibold leading-tight text-[#294073]">
                  {service.headline}
                </p>
                <p class="mt-2 text-[11px] leading-snug text-[#294073]/75">
                  {service.summary}
                </p>
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="mt-10 flex justify-center max-[620px]:mt-8">
    <a
      class="inline-flex min-h-14.5 items-center gap-3 rounded-full bg-linear-to-r from-accent-blue to-card-blue py-0 pr-7 pl-3 text-base font-extrabold text-white no-underline shadow-[0_18px_34px_rgba(43,93,158,0.26)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_22px_42px_rgba(43,93,158,0.32)] max-[620px]:min-h-13 max-[620px]:pr-5.5 max-[620px]:text-sm"
      href="#contact-us"
    >
      <span
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/20"
        aria-hidden="true"
      >
        <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" role="img">
          <path
            d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5H19a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h1.25V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v8A1.5 1.5 0 0 0 5 19.5h14a1.5 1.5 0 0 0 1.5-1.5v-8h-17Zm3 3.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5a.75.75 0 0 1-.75-.75Z"
            fill="currentColor"></path>
        </svg>
      </span>
      Schedule a visit
    </a>
  </div>
</section>

<style>
  .services-grid {
    align-items: stretch;
  }

  .service-card {
    transition:
      flex 260ms ease,
      box-shadow 260ms ease;
  }

  .service-media {
    transition:
      flex 260ms ease,
      transform 260ms ease;
  }

  .service-image {
    transition: transform 420ms ease;
  }

  .service-info {
    pointer-events: none;
    transition:
      flex 260ms ease,
      opacity 220ms ease;
  }

  .service-panel {
    transform: translateX(8px);
    transition: transform 220ms ease;
  }

  .services-grid.has-active .service-card {
    flex: 0.85 1 0%;
  }

  .services-grid.has-active .service-card.is-active {
    flex: 1.35 1 0%;
    gap: 12px;
    z-index: 2;
  }

  .services-grid.has-active .service-card.is-active .service-media {
    flex: 0 0 56%;
    transform: translateX(-8px);
  }

  .services-grid.has-active .service-card.is-active .service-image {
    transform: scale(1.04);
  }

  .services-grid.has-active .service-card.is-active .service-info {
    flex: 0 0 44%;
    opacity: 1;
    pointer-events: auto;
  }

  .services-grid.has-active .service-card.is-active .service-panel {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-image,
    .service-media,
    .service-info,
    .service-panel {
      transition-duration: 0ms;
    }
  }
</style>

<script>
  const serviceGrids = document.querySelectorAll("[data-services-grid]");

  serviceGrids.forEach((grid) => {
    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>("[data-service-card]"),
    );

    const clearActive = () => {
      grid.classList.remove("has-active");
      cards.forEach((card) => card.classList.remove("is-active"));
    };

    const setActive = (card: HTMLElement) => {
      grid.classList.add("has-active");
      cards.forEach((item) => item.classList.remove("is-active"));
      card.classList.add("is-active");
    };

    cards.forEach((card) => {
      card.addEventListener("mouseenter", () => setActive(card));
      card.addEventListener("focusin", () => setActive(card));
      card.addEventListener("mouseleave", () => {
        if (!card.matches(":focus-within")) {
          clearActive();
        }
      });
      card.addEventListener("focusout", () => {
        requestAnimationFrame(() => {
          if (!grid.contains(document.activeElement)) {
            clearActive();
          }
        });
      });
    });
  });
</script>
