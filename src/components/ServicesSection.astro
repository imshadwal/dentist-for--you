---
const services = [
  {
    title: "Aesthetic dentistry",
    image: "/images/services/aesthetic_dentistry.png",
    alt: "Aesthetic dentistry",
    summary: "Veneers, bonding, and contouring for a balanced, luminous smile.",
  },
  {
    title: "Orthodontics",
    image: "/images/services/orthodontics.png",
    alt: "Orthodontic aligners",
    summary: "Clear aligners and braces with gentle, predictable movement.",
  },
  {
    title: "Implantology",
    image: "/images/services/implantology.png",
    alt: "Dental implant",
    summary: "Permanent, natural-looking replacements created with precision and comfort.",
  },
  {
    title: "Whitening",
    image: "/images/services/whitening.png",
    alt: "Teeth whitening",
    summary: "Lift stains safely while protecting enamel for a radiant finish.",
  },
  {
    title: "Surgical dentistry",
    image: "/images/services/surgical.png",
    alt: "Surgical dentistry",
    summary: "Guided procedures and expert aftercare for confident recovery.",
  },
];
---

<section
  class="mx-auto w-full max-w-[1760px] px-2 sm:px-4 md:px-6 py-20 md:py-28"
  id="treatments"
  aria-labelledby="services-title"
>
  <div class="text-center">
    <p class="eyebrow">Services</p>
    <h2
      id="services-title"
      class="mt-3 text-[clamp(32px,4vw,56px)] font-extrabold leading-[1.18] text-heading capitalize"
    >
      Expert Care For Every Smile
    </h2>
    <p class="mx-auto mt-5 max-w-180 text-[clamp(17px,1.2vw,20px)] leading-relaxed text-body">
      We offer a full spectrum of treatments — each tailored to elevate your
      health, confidence, and natural beauty.
    </p>
  </div>

  <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
    {
      services.map((service) => (
        <article class="flex flex-col overflow-hidden rounded-2xl border border-[#d6e6fb] bg-white shadow-[0_12px_28px_rgba(31,63,117,0.12)]">
          <div class="relative h-48 overflow-hidden bg-slate-100">
            <img
              class="h-full w-full object-cover"
              src={service.image}
              alt={service.alt}
              loading="lazy"
            />
          </div>
          <div class="flex flex-1 flex-col p-5">
            <h3 class="text-xl font-extrabold text-heading tracking-tight">
              {service.title}
            </h3>
            <p class="mt-2 text-base leading-relaxed text-body">
              {service.summary}
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <div class="mt-12 flex justify-center">
    <a
      class="inline-flex min-h-14.5 items-center gap-3 rounded-full bg-linear-to-r from-accent-blue to-card-blue py-0 pr-7 pl-3 text-base font-extrabold text-white no-underline shadow-[0_18px_34px_rgba(43,93,158,0.26)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_22px_42px_rgba(43,93,158,0.32)]"
      href="/contact-us"
    >
      <span
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/20"
        aria-hidden="true"
      >
        <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" role="img">
          <path
            d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5H19a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h1.25V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v8A1.5 1.5 0 0 0 5 19.5h14a1.5 1.5 0 0 0 1.5-1.5v-8h-17Zm3 3.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5a.75.75 0 0 1-.75-.75Z"
            fill="currentColor"></path>
        </svg>
      </span>
      Book an appointment
    </a>
  </div>
</section>
