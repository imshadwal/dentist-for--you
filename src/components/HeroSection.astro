<section
  class="relative mx-auto w-full max-w-[1760px] px-4 sm:px-5 md:px-8 pt-3 pb-1.5 md:pt-4 md:pb-2.5 overflow-hidden"
  id="home"
  aria-label="Dentist for you"
>
  <h1 class="sr-only">Dentist for you</h1>
  <div class="relative w-full min-h-[calc(100svh-100px)] rounded-2xl md:rounded-3xl overflow-hidden shadow-[0_32px_80px_rgba(41,64,115,0.22)] bg-slate-200">
    <img
      src="/images/photoshoot/IMG_6784.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      aria-hidden="true"
    />
    <p
      id="hero-video-status"
      class="absolute inset-0 z-1 flex items-center justify-center text-white text-lg font-semibold bg-heading/35"
    >
      Loading video…
    </p>
    <video
      id="hero-video"
      class="absolute inset-0 z-2 h-full w-full object-cover opacity-0 transition-opacity duration-500"
      src="/videos/testimonial.mp4"
      poster="/images/photoshoot/IMG_6784.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    ></video>
  </div>

  <div class="mt-6 md:mt-8 overflow-hidden rounded-[28px] border border-[#d6e6fb] bg-white shadow-[0_18px_40px_rgba(31,63,117,0.08)]">
    <div class="grid grid-cols-1 md:grid-cols-[minmax(0,0.7fr)_minmax(0,1.1fr)] items-center">
      <div class="flex items-center justify-center bg-[#e8f1fb] px-8 py-10 md:py-14">
        <img
          class="h-40 sm:h-52 md:h-64 w-auto object-contain mix-blend-multiply"
          src="/images/hero.png"
          alt=""
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="p-8 sm:p-10 lg:p-12">
        <p class="eyebrow">Dentist for you</p>
        <h2 class="mt-3 max-w-lg text-[clamp(28px,3.4vw,44px)] font-extrabold leading-[1.18] tracking-tight text-heading">
          Not all smiles need fixing. Some need vision.
        </h2>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-body">
          Principal-led dentistry and orthodontics in Varanasi — planned with you, not rushed through a chair.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const video = document.getElementById("hero-video") as HTMLVideoElement | null;
  const status = document.getElementById("hero-video-status");

  const showVideo = () => {
    if (!video) return;
    video.classList.remove("opacity-0");
    video.classList.add("opacity-100");
    status?.classList.add("hidden");
  };

  if (video) {
    if (video.readyState >= 2) {
      showVideo();
    } else {
      video.addEventListener("playing", showVideo, { once: true });
      video.addEventListener("canplay", showVideo, { once: true });
      video.addEventListener("error", () => {
        if (status) status.textContent = "";
        status?.classList.add("hidden");
      });
    }
  }
</script>
