---
// src/components/TreatmentCalculator.astro
---

<section class="mx-auto w-full max-w-[1440px] py-24 px-6 md:px-16 bg-white" id="treatment-calculator">
  <div class="text-center mb-16">
    <span class="text-xs font-bold tracking-[0.3em] text-slate-400 uppercase">Treatment Calculator</span>
    <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-heading">Plan your smile journey</h2>
    <p class="mt-2 text-sm text-heading/70">Estimate costs and treatment time based on your smile goals. Interactive. Free. Personalized.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
    
    <div class="lg:col-span-3 flex flex-col gap-6">
      
      <div class="bg-[#f8fafc] border border-slate-100 rounded-2xl p-6 shadow-xs flex-1">
        <h3 class="text-xs font-bold uppercase tracking-wider text-heading mb-4">
          <span class="text-slate-300 mr-1 font-mono">01.</span> Select goals
        </h3>
        <div class="space-y-3.5">
          {[
            { label: 'Straighter teeth', checked: false },
            { label: 'Replace missing tooth', checked: true },
            { label: 'Whiter smile', checked: false },
            { label: 'Complete makeover', checked: false }
          ].map((goal) => (
            <label class="flex items-center text-xs text-slate-600 font-semibold cursor-pointer select-none">
              <input 
                type="checkbox" 
                checked={goal.checked} 
                class="rounded border-slate-300 text-card-blue focus:ring-card-blue mr-3 w-4 h-4 transition-colors" 
              />
              {goal.label}
            </label>
          ))}
        </div>
      </div>

      <div class="bg-[#f8fafc] border border-slate-100 rounded-2xl p-6 shadow-xs">
        <h3 class="text-xs font-bold uppercase tracking-wider text-heading mb-3.5">
          <span class="text-slate-300 mr-1 font-mono">02.</span> Preferred method
        </h3>
        <div class="flex gap-1.5 flex-wrap">
          {['Aligners', 'Veneers', 'Implants'].map((method) => (
            <button 
              class={`px-4 py-1.5 rounded-full text-[11px] font-bold border transition-all duration-200 cursor-pointer ${
                method === 'Implants' 
                  ? 'bg-card-blue text-white border-transparent shadow-xs' 
                  : 'bg-white text-slate-500 border-slate-200 hover:border-slate-300'
              }`}
            >
              {method}
            </button>
          ))}
        </div>
      </div>

      <div class="bg-[#f8fafc] border border-slate-100 rounded-2xl p-6 shadow-xs">
        <h3 class="text-xs font-bold uppercase tracking-wider text-heading mb-3.5">
          <span class="text-slate-300 mr-1 font-mono">03.</span> Loyalty program
        </h3>
        <div class="space-y-2.5">
          <label class="flex items-center text-xs font-semibold text-slate-600 cursor-pointer">
            <input type="radio" name="loyalty" class="text-card-blue border-slate-300 mr-2.5 w-4 h-4" /> Celestia member
          </label>
          <label class="flex items-center text-xs font-semibold text-slate-600 cursor-pointer">
            <input type="radio" name="loyalty" checked class="text-card-blue border-slate-300 mr-2.5 w-4 h-4" /> Not enrolled
          </label>
        </div>
      </div>
    </div>

    <div class="lg:col-span-5 bg-gradient-to-b from-[#f8fafc] to-[#edf4fc] border border-slate-100 rounded-2xl p-6 shadow-xs flex flex-col justify-between items-center relative overflow-hidden min-h-[420px]">
      <div class="w-full flex justify-between items-center z-10">
        <h3 class="text-xs font-bold uppercase tracking-wider text-heading">
          <span class="text-slate-300 mr-1 font-mono">04.</span> Select tooth
        </h3>
        <label class="text-[11px] font-bold text-slate-400 flex items-center cursor-pointer">
          <input type="checkbox" checked class="mr-1.5 rounded border-slate-300 text-card-blue" /> All
        </label>
      </div>
      
      <div class="w-68 h-68 my-auto relative flex items-center justify-center">
        <div class="absolute inset-0 rounded-full border border-dashed border-slate-300/60 animate-[spin_60s_linear_infinite]"></div>
        <img src="/images/glass-jaw.png" alt="3D Teeth Model Visualizer" class="w-4/5 h-4/5 object-contain z-10 drop-shadow-sm mix-blend-multiply" />
        <span class="absolute bottom-0 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-[9px] tracking-wider font-bold text-slate-400 shadow-xs border border-slate-100 uppercase">
          360° Interactive
        </span>
      </div>
    </div>

    <div class="lg:col-span-4 bg-[#294073] text-white rounded-2xl p-6 shadow-md flex flex-col justify-between">
      <div>
        <span class="text-[10px] uppercase font-bold tracking-widest text-white/40 font-mono">Output Result</span>
        
        <div class="grid grid-cols-2 gap-4 mt-6 border-b border-white/10 pb-6">
          <div>
            <p class="text-[11px] text-white/50 font-medium">Treatment complexity</p>
            <h4 class="text-base font-bold mt-1 text-accent-blue flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-accent-blue animate-pulse"></span> Medium
            </h4>
          </div>
          <div>
            <p class="text-[11px] text-white/50 font-medium">Treatment time (est.)</p>
            <h4 class="text-base font-bold mt-1">3 weeks</h4>
          </div>
        </div>

        <div class="mt-6 border-b border-white/10 pb-6">
          <p class="text-[11px] text-white/50 font-medium mb-3">Recommended specialists</p>
          <div class="space-y-2">
            <div class="flex items-center space-x-3 bg-white/5 p-2 rounded-xl border border-white/5">
              <div class="w-8 h-8 rounded-full bg-slate-300 overflow-hidden">
                <img src="/images/team/doctor2.jpg" class="w-full h-full object-cover" alt="Dr. James Chen" />
              </div>
              <div>
                <h5 class="text-xs font-bold text-white">Dr. James Chen</h5>
                <p class="text-[10px] text-white/40">Orthodontic Specialist</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 lg:mt-0">
        <p class="text-[11px] text-white/50 font-medium">Estimated cost range</p>
        <h2 class="text-3xl font-black text-white tracking-tight mt-1">$2,400 - $3,100*</h2>
        <p class="text-[9px] text-white/30 mt-2.5 leading-normal">*Estimated costs scale depending on required physical custom guides or temporary crowns.</p>
      </div>
    </div>

  </div>
</section>