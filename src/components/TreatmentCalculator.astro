---
const goals = [
  { id: "straight", label: "Straighter teeth", checked: false },
  { id: "replace", label: "Replace missing tooth / Gaps", checked: true },
  { id: "white", label: "Whiter smile", checked: false },
  { id: "makeover", label: "Complete makeover", checked: false },
  { id: "caries", label: "Dental caries", checked: false },
];
---

<section
  class="mx-auto w-full max-w-[1760px] py-20 md:py-28 px-4 sm:px-5 md:px-8"
  id="treatment-calculator"
>
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">
    <div class="max-w-xl">
      <p class="eyebrow">Treatment calculator</p>
      <h2 class="mt-3 text-[clamp(32px,4vw,52px)] font-extrabold leading-[1.18] tracking-tight text-heading">
        Plan your smile journey
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-body">
        Pick a goal and a method to see complexity, time, and a treatment preview.
      </p>
    </div>
  </div>

  <div
    class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] overflow-hidden rounded-[28px] border border-[#d6e6fb] bg-white shadow-[0_18px_40px_rgba(31,63,117,0.08)]"
    data-calculator
  >
    <div class="flex flex-col gap-8 p-6 sm:p-8 lg:p-10 border-b lg:border-b-0 lg:border-r border-[#d6e6fb]">
      <div>
        <p class="text-base font-bold uppercase tracking-[0.14em] text-card-blue">01 · Goals</p>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
          {
            goals.map((goal) => (
              <label class="flex cursor-pointer select-none items-center gap-3 rounded-2xl border border-[#d6e6fb] bg-[#f8fbff] px-4 py-3.5 text-base font-semibold text-heading has-[:checked]:border-card-blue has-[:checked]:bg-[#e8f1fb]">
                <input
                  type="radio"
                  name="calc-goal"
                  data-goal={goal.id}
                  checked={goal.checked}
                  class="h-4 w-4 border-slate-300 text-card-blue focus:ring-card-blue"
                />
                {goal.label}
              </label>
            ))
          }
        </div>
      </div>

      <div>
        <p class="text-base font-bold uppercase tracking-[0.14em] text-card-blue">02 · Method</p>
        <div class="mt-4 flex flex-wrap gap-2" id="calc-method-list"></div>
        <p class="mt-3 text-sm text-body hidden" id="calc-method-empty">No method options for this goal.</p>
      </div>

      <div class="mt-auto rounded-2xl bg-[#f4f8fd] p-5 sm:p-6">
        <p class="text-base font-bold uppercase tracking-[0.14em] text-card-blue">Estimate</p>
        <div class="mt-4 grid grid-cols-2 gap-4">
          <div>
            <p class="text-base text-body">Complexity</p>
            <p class="mt-1 text-lg font-extrabold text-heading" id="calc-complexity">Medium</p>
          </div>
          <div>
            <p class="text-base text-body">Time</p>
            <p class="mt-1 text-lg font-extrabold text-heading" id="calc-time">15 days</p>
          </div>
        </div>
      </div>
    </div>

    <div class="relative flex min-h-[420px] flex-col bg-[#f3f7fc] p-5 sm:p-6 lg:p-7">
      <div class="flex shrink-0 items-center justify-between mb-4">
        <p class="text-base font-bold uppercase tracking-[0.14em] text-card-blue">03 · Preview</p>
        <label class="flex cursor-pointer select-none items-center gap-2 text-base font-semibold text-heading">
          <input
            type="checkbox"
            id="calc-highlight-toggle"
            checked
            class="h-4 w-4 rounded border-slate-300 text-card-blue"
          />
          Highlight
        </label>
      </div>

      <div
        class="relative flex flex-1 items-center justify-center overflow-hidden rounded-2xl border border-[#d6e6fb] bg-white shadow-[inset_0_1px_0_rgba(255,255,255,0.8)]"
      >
        <img
          id="calc-jaw-image"
          src="/images/treatment_calculator/implants.png"
          alt="Treatment preview"
          class="h-full max-h-[460px] w-full cursor-pointer object-contain p-3 sm:p-4 opacity-0 transition-[filter,opacity] duration-300"
        />
        <div
          id="calc-preview-loader"
          class="absolute inset-0 flex items-center justify-center bg-white"
          aria-hidden="true"
        >
          <div
            class="h-10 w-10 animate-spin rounded-full border-[3px] border-[#d6e6fb] border-t-[#2b5d9e]"
          ></div>
        </div>
        <p
          id="calc-preview-empty"
          class="absolute inset-0 hidden items-center justify-center text-center text-base font-semibold text-body bg-white"
        >
          Preview coming soon
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const calculator = document.querySelector("[data-calculator]");
    if (!calculator) return;

    type GoalId = "straight" | "replace" | "white" | "makeover" | "caries";

    const goalMethods: Record<GoalId, string[]> = {
      straight: ["Aligners", "Metallic Braces", "Ceramic Braces"],
      replace: ["Implant", "Removable partial denture", "Complete Denture", "Veneers"],
      white: ["Scaling"],
      makeover: [],
      caries: ["Filling", "Root Canal treatment"],
    };

    const methodImages: Record<string, string> = {
      Aligners: "/images/treatment_calculator/aligners.png",
      "Metallic Braces": "/images/treatment_calculator/metallic-braces.png",
      "Ceramic Braces": "/images/treatment_calculator/ceramic-braces.png",
      Implant: "/images/treatment_calculator/implants.png",
      "Removable partial denture": "/images/treatment_calculator/partial-denture.png",
      "Complete Denture": "/images/treatment_calculator/full-denture.png",
      Veneers: "/images/treatment_calculator/veneers.png",
      Scaling: "/images/treatment_calculator/scaling.png",
      Filling: "/images/treatment_calculator/filling.png",
      "Root Canal treatment": "/images/treatment_calculator/root-canal.png",
    };

    const goalImages: Partial<Record<GoalId, string>> = {
      makeover: "/images/treatment_calculator/complete-makeover.png",
    };

    const estimates: Record<GoalId, { complexity: string; time: string }> = {
      straight: { complexity: "Medium", time: "12 – 18 months" },
      replace: { complexity: "High", time: "15 days" },
      white: { complexity: "Low", time: "1 visit" },
      makeover: { complexity: "High", time: "1 month" },
      caries: { complexity: "Medium", time: "1 – 2 visits" },
    };

    const methodList = calculator.querySelector("#calc-method-list") as HTMLElement;
    const methodEmpty = calculator.querySelector("#calc-method-empty") as HTMLElement;
    const complexityEl = calculator.querySelector("#calc-complexity") as HTMLElement;
    const timeEl = calculator.querySelector("#calc-time") as HTMLElement;
    const jawImage = calculator.querySelector("#calc-jaw-image") as HTMLImageElement;
    const previewEmpty = calculator.querySelector("#calc-preview-empty") as HTMLElement;
    const previewLoader = calculator.querySelector("#calc-preview-loader") as HTMLElement;
    const highlightToggle = calculator.querySelector("#calc-highlight-toggle") as HTMLInputElement;
    const goalInputs = calculator.querySelectorAll<HTMLInputElement>("[data-goal]");

    const methodActive =
      "rounded-full border border-transparent bg-[#2b5d9e] px-5 py-2.5 text-base font-bold text-white cursor-pointer active-method";
    const methodIdle =
      "rounded-full border border-[#d6e6fb] bg-white px-5 py-2.5 text-base font-bold text-body cursor-pointer hover:border-card-blue";

    let selectedMethod = "";
    let previewRequestId = 0;

    const getSelectedGoal = (): GoalId => {
      const checked = calculator.querySelector<HTMLInputElement>("[data-goal]:checked");
      return (checked?.getAttribute("data-goal") as GoalId) || "replace";
    };

    const showLoader = () => {
      previewLoader.classList.remove("hidden");
      previewLoader.classList.add("flex");
      jawImage.classList.add("opacity-0");
    };

    const hideLoader = () => {
      previewLoader.classList.add("hidden");
      previewLoader.classList.remove("flex");
      jawImage.classList.remove("opacity-0");
    };

    const setPreview = (src: string | undefined) => {
      const requestId = ++previewRequestId;

      if (!src) {
        jawImage.removeAttribute("src");
        jawImage.classList.add("hidden");
        hideLoader();
        previewEmpty.classList.remove("hidden");
        previewEmpty.classList.add("flex");
        return;
      }

      previewEmpty.classList.add("hidden");
      previewEmpty.classList.remove("flex");
      jawImage.classList.remove("hidden");
      showLoader();

      const reveal = () => {
        if (requestId !== previewRequestId) return;
        hideLoader();
      };

      if (jawImage.src.endsWith(src) && jawImage.complete && jawImage.naturalWidth > 0) {
        reveal();
        return;
      }

      jawImage.onload = reveal;
      jawImage.onerror = reveal;
      jawImage.src = src;

      if (jawImage.complete && jawImage.naturalWidth > 0) {
        reveal();
      }
    };

    const updateEstimate = (goal: GoalId) => {
      const estimate = estimates[goal];
      complexityEl.textContent = estimate.complexity;
      complexityEl.style.color = "#2b5d9e";
      timeEl.textContent = estimate.time;
    };

    const updatePreview = (goal: GoalId) => {
      if (goal === "makeover") {
        setPreview(goalImages.makeover);
        return;
      }
      setPreview(methodImages[selectedMethod] ?? "");
    };

    const renderMethods = (goal: GoalId) => {
      const methods = goalMethods[goal];
      methodList.innerHTML = "";

      if (methods.length === 0) {
        selectedMethod = "";
        methodEmpty.classList.remove("hidden");
        updateEstimate(goal);
        updatePreview(goal);
        return;
      }

      methodEmpty.classList.add("hidden");
      selectedMethod = methods[0];

      methods.forEach((method) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.setAttribute("data-method-btn", method);
        btn.textContent = method;
        btn.className = method === selectedMethod ? methodActive : methodIdle;
        btn.addEventListener("click", () => {
          selectedMethod = method;
          methodList.querySelectorAll("[data-method-btn]").forEach((el) => {
            const name = el.getAttribute("data-method-btn");
            el.className = name === method ? methodActive : methodIdle;
          });
          updatePreview(goal);
        });
        methodList.appendChild(btn);
      });

      updateEstimate(goal);
      updatePreview(goal);
    };

    goalInputs.forEach((input) => {
      input.addEventListener("change", () => {
        if (!input.checked) return;
        renderMethods(getSelectedGoal());
      });
    });

    highlightToggle.addEventListener("change", () => {
      if (highlightToggle.checked) {
        jawImage.style.filter = "saturate(1.15) brightness(1.04)";
      } else {
        jawImage.style.filter = "saturate(0.75) brightness(0.96)";
      }
    });

    renderMethods(getSelectedGoal());
  });
</script>
