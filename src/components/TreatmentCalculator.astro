---
const goals = [
  { id: "straight", label: "Straighter teeth", checked: false },
  { id: "replace", label: "Replace missing tooth", checked: true },
  { id: "white", label: "Whiter smile", checked: false },
  { id: "makeover", label: "Complete makeover", checked: false },
];

const methods = ["Aligners", "Veneers", "Implants"];
---

<section
  class="mx-auto w-full max-w-[1760px] py-20 md:py-28 px-4 sm:px-5 md:px-8"
  id="treatment-calculator"
>
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">
    <div class="max-w-xl">
      <p class="eyebrow">Treatment calculator</p>
      <h2 class="mt-3 text-[clamp(32px,4vw,52px)] font-extrabold leading-[1.18] tracking-tight text-heading">
        Plan your smile journey
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-body">
        Pick a goal and a method to see complexity, time, and a treatment preview.
      </p>
    </div>
  </div>

  <div
    class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] overflow-hidden rounded-[28px] border border-[#d6e6fb] bg-white shadow-[0_18px_40px_rgba(31,63,117,0.08)]"
    data-calculator
  >
    <div class="flex flex-col gap-8 p-6 sm:p-8 lg:p-10 border-b lg:border-b-0 lg:border-r border-[#d6e6fb]">
      <div>
        <p class="text-base font-bold uppercase tracking-[0.14em] text-card-blue">01 · Goals</p>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
          {
            goals.map((goal) => (
              <label class="flex cursor-pointer select-none items-center gap-3 rounded-2xl border border-[#d6e6fb] bg-[#f8fbff] px-4 py-3.5 text-base font-semibold text-heading has-[:checked]:border-card-blue has-[:checked]:bg-[#e8f1fb]">
                <input
                  type="radio"
                  name="calc-goal"
                  data-goal={goal.id}
                  checked={goal.checked}
                  class="h-4 w-4 border-slate-300 text-card-blue focus:ring-card-blue"
                />
                {goal.label}
              </label>
            ))
          }
        </div>
      </div>

      <div>
        <p class="text-base font-bold uppercase tracking-[0.14em] text-card-blue">02 · Method</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            methods.map((method) => (
              <button
                type="button"
                data-method-btn={method}
                class={
                  method === "Implants"
                    ? "rounded-full border border-transparent bg-[#2b5d9e] px-5 py-2.5 text-base font-bold text-white cursor-pointer active-method"
                    : "rounded-full border border-[#d6e6fb] bg-white px-5 py-2.5 text-base font-bold text-body cursor-pointer hover:border-card-blue"
                }
              >
                {method}
              </button>
            ))
          }
        </div>
      </div>

      <div class="mt-auto rounded-2xl bg-[#f4f8fd] p-5 sm:p-6">
        <p class="text-base font-bold uppercase tracking-[0.14em] text-card-blue">Estimate</p>
        <div class="mt-4 grid grid-cols-2 gap-4">
          <div>
            <p class="text-base text-body">Complexity</p>
            <p class="mt-1 text-lg font-extrabold text-heading" id="calc-complexity">Medium</p>
          </div>
          <div>
            <p class="text-base text-body">Time</p>
            <p class="mt-1 text-lg font-extrabold text-heading" id="calc-time">15 days</p>
          </div>
        </div>
      </div>
    </div>

    <div class="relative flex min-h-[360px] flex-col bg-[#e8f1fb] p-6 sm:p-8">
      <div class="flex items-center justify-between">
        <p class="text-base font-bold uppercase tracking-[0.14em] text-card-blue">03 · Preview</p>
        <label class="flex cursor-pointer select-none items-center gap-2 text-base font-semibold text-heading">
          <input
            type="checkbox"
            id="calc-highlight-toggle"
            checked
            class="h-4 w-4 rounded border-slate-300 text-card-blue"
          />
          Highlight
        </label>
      </div>

      <div class="relative mx-auto my-auto flex h-72 w-72 items-center justify-center sm:h-80 sm:w-80">
        <div class="absolute inset-6 rounded-full bg-[#2b5d9e]/10"></div>
        <img
          id="calc-jaw-image"
          src="/images/treatment_calculator/3d_transparent.png"
          alt="Treatment preview"
          class="relative z-10 h-full w-full cursor-pointer object-contain mix-blend-multiply transition-transform duration-500"
        />
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const calculator = document.querySelector("[data-calculator]");
    if (!calculator) return;

    const straightCheck = calculator.querySelector('[data-goal="straight"]') as HTMLInputElement;
    const replaceCheck = calculator.querySelector('[data-goal="replace"]') as HTMLInputElement;
    const whiteCheck = calculator.querySelector('[data-goal="white"]') as HTMLInputElement;
    const makeoverCheck = calculator.querySelector('[data-goal="makeover"]') as HTMLInputElement;
    const methodButtons = calculator.querySelectorAll("[data-method-btn]");
    const complexityEl = calculator.querySelector("#calc-complexity") as HTMLElement;
    const timeEl = calculator.querySelector("#calc-time") as HTMLElement;
    const jawImage = calculator.querySelector("#calc-jaw-image") as HTMLImageElement;
    const highlightToggle = calculator.querySelector("#calc-highlight-toggle") as HTMLInputElement;

    let selectedMethod = "Implants";

    const methodActive =
      "rounded-full border border-transparent bg-[#2b5d9e] px-5 py-2.5 text-base font-bold text-white cursor-pointer active-method";
    const methodIdle =
      "rounded-full border border-[#d6e6fb] bg-white px-5 py-2.5 text-base font-bold text-body cursor-pointer hover:border-card-blue";

    const handleGoalChange = (changedGoal: string) => {
      if (changedGoal === "straight") updateMethodActive("Aligners");
      else if (changedGoal === "replace") updateMethodActive("Implants");
      else if (changedGoal === "white") updateMethodActive("Veneers");
      else if (changedGoal === "makeover") updateMethodActive("Veneers");
    };

    const updateMethodActive = (methodName: string) => {
      selectedMethod = methodName;
      methodButtons.forEach((btn) => {
        const btnMethod = btn.getAttribute("data-method-btn");
        btn.className = btnMethod === methodName ? methodActive : methodIdle;
      });
      calculateOutput();
    };

    const calculateOutput = () => {
      const isStraight = straightCheck.checked;
      const isReplace = replaceCheck.checked;
      const isWhite = whiteCheck.checked;
      const isMakeover = makeoverCheck.checked;

      if (!isStraight && !isReplace && !isWhite && !isMakeover) {
        complexityEl.textContent = "None selected";
        complexityEl.style.color = "#3d5278";
        timeEl.textContent = "—";
        return;
      }

      let complexity = "Low";
      let complexityColor = "#2b5d9e";
      let timeText = "1 week";

      if (isMakeover) {
        complexity = "High";
        complexityColor = "#2b5d9e";
        timeText = "1 month";
      } else if (isReplace) {
        complexity = "High";
        complexityColor = "#2b5d9e";
        timeText = "15 days";
      } else if (isStraight) {
        complexity = "Medium";
        complexityColor = "#2b5d9e";
        timeText = "12 – 18 months";
      } else if (isWhite) {
        complexity = "Low";
        complexityColor = "#2b5d9e";
        timeText = "2 visits";
      }

      complexityEl.textContent = complexity;
      complexityEl.style.color = complexityColor;
      timeEl.textContent = timeText;

      if (isMakeover) jawImage.src = "/images/treatment_calculator/3d_makeover.png";
      else if (isReplace) jawImage.src = "/images/treatment_calculator/3d_transparent.png";
      else if (isStraight) jawImage.src = "/images/treatment_calculator/3d_aligners.png";
      else if (isWhite) jawImage.src = "/images/treatment_calculator/3d_whitening.png";
    };

    [straightCheck, replaceCheck, whiteCheck, makeoverCheck].forEach((input) => {
      input.addEventListener("change", () => {
        if (!input.checked) return;
        handleGoalChange(input.getAttribute("data-goal") || "");
        calculateOutput();
      });
    });

    methodButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const method = btn.getAttribute("data-method-btn");
        if (method) updateMethodActive(method);
      });
    });

    highlightToggle.addEventListener("change", () => {
      if (highlightToggle.checked) {
        jawImage.style.filter = "saturate(1.15) brightness(1.04)";
      } else {
        jawImage.style.filter = "saturate(0.75) brightness(0.96)";
      }
    });

    calculateOutput();
  });
</script>
