---
const process = [
  {
    step: "01",
    title: "Consultation",
    description: "Meet with our specialists to discuss your concerns and goals",
  },
  {
    step: "02",
    title: "Diagnosis",
    description: "Advanced imaging and testing to understand your specific needs",
  },
  {
    step: "03",
    title: "Treatment Plan",
    description: "Customized strategy with transparent pricing and timeline",
  },
  {
    step: "04",
    title: "Treatment",
    description: "Expert care with comfort and precision using latest technology",
  },
  {
    step: "05",
    title: "Follow-up",
    description: "Post-treatment care instructions and scheduled check-ins",
  },
];
---

<section
  class="mx-auto w-[calc(100%-32px)] max-w-460 py-[clamp(40px,8vw,100px)] max-[620px]:w-[calc(100%-28px)]"
  id="treatment-process"
  aria-labelledby="process-title"
>
  <div class="text-center mb-[clamp(40px,6vw,80px)]">
    <p class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase">
      Your Journey
    </p>
    <h2
      id="process-title"
      class="mt-3 text-[clamp(36px,4.4vw,56px)] font-extrabold leading-[1.05] text-heading"
    >
      Treatment made simple
    </h2>
  </div>

  <!-- Process Timeline -->
  <div class="relative" data-process-container>
    <!-- Connecting line on desktop -->
    <div
      class="absolute top-12 left-0 right-0 h-0.5 bg-linear-to-r from-accent-blue via-card-blue to-accent-blue/30 max-[900px]:hidden"
      aria-hidden="true"
    ></div>

    <!-- Timeline items -->
    <div class="grid grid-cols-5 gap-4 max-[900px]:grid-cols-1 max-[900px]:gap-8">
      {
        process.map((item, index) => (
          <div 
            data-process-item 
            data-step-index={index} 
            class="relative flex flex-col items-center max-[900px]:items-start transition-all duration-500 process-row"
          >
            <!-- Step circle -->
            <div class="relative z-1 mb-6 max-[900px]:mb-4">
              <div class="process-dot">
                <div class="text-center">
                  <p class="text-[10px] font-bold tracking-[0.2em] text-card-blue/60 uppercase">
                    Step
                  </p>
                  <p class="text-[clamp(20px,2vw,28px)] font-extrabold text-heading leading-tight">
                    {item.step}
                  </p>
                </div>
              </div>

              <!-- Pulsing background -->
              <div class="process-glow" aria-hidden="true"></div>
            </div>

            <!-- Content -->
            <div class="grow process-text-container">
              <h3 class="text-[clamp(16px,1.5vw,20px)] font-extrabold text-heading text-center max-[900px]:text-left">
                {item.title}
              </h3>
              <p class="mt-2 text-[13px] leading-[1.4] text-heading/70 text-center max-[900px]:text-left">
                {item.description}
              </p>
            </div>

            <!-- Vertical line for mobile -->
            {index < process.length - 1 && (
              <div
                class="hidden max-[900px]:block absolute left-7 top-20 h-8 w-0.5 bg-linear-to-b from-card-blue to-accent-blue/30"
                aria-hidden="true"
              ></div>
            )}
          </div>
        ))
      }
    </div>
  </div>

  <!-- CTA -->
  <div class="mt-[clamp(40px,8vw,60px)] flex justify-center">
    <a
      class="inline-flex min-h-14.5 items-center gap-3 rounded-full bg-linear-to-r from-accent-blue to-card-blue py-0 pr-7 pl-3 text-base font-extrabold text-white no-underline shadow-[0_18px_34px_rgba(43,93,158,0.26)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_22px_42px_rgba(43,93,158,0.32)] max-[620px]:min-h-13 max-[620px]:pr-5.5 max-[620px]:text-sm"
      href="#contact-us"
    >
      <span
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/20"
        aria-hidden="true"
      >
        <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" role="img">
          <path
            d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5H19a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h1.25V3.5A .75.75 0 0 1 7 2.75ZM3.5 10v8A1.5 1.5 0 0 0 5 19.5h14a1.5 1.5 0 0 0 1.5-1.5v-8h-17Zm3 3.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5a.75.75 0 0 1-.75-.75Z"
            fill="currentColor"
          ></path>
        </svg>
      </span>
      Start your journey
    </a>
  </div>
</section>

<script>
  const container = document.querySelector("[data-process-container]");
  const items = document.querySelectorAll("[data-process-item]");

  if (container && items.length > 0) {
    const isDesktop = () => window.innerWidth > 900;

    // Desktop: Staggered sequential highlight when row enters view
    const containerObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && isDesktop()) {
            items.forEach((item, index) => {
              setTimeout(() => {
                if (isDesktop()) {
                  item.classList.add("is-active");
                }
              }, index * 200);
            });
          } else if (!entry.isIntersecting && isDesktop()) {
            items.forEach((item) => {
              item.classList.remove("is-active");
            });
          }
        });
      },
      {
        threshold: 0.25,
      }
    );

    containerObserver.observe(container);

    // Mobile: IntersectionObserver per step as they scroll vertically
    const itemObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!isDesktop()) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-active");
            } else {
              entry.target.classList.remove("is-active");
            }
          }
        });
      },
      {
        rootMargin: "-20% 0px -20% 0px",
        threshold: 0.1,
      }
    );

    items.forEach((item) => itemObserver.observe(item));

    // Handle resizing: reset active states if switching modes
    window.addEventListener("resize", () => {
      if (isDesktop()) {
        items.forEach((item) => itemObserver.unobserve(item));
      } else {
        items.forEach((item) => {
          itemObserver.observe(item);
        });
      }
    });
  }
</script>

<style>
  .process-row {
    opacity: 0.35;
    transform: translateY(15px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .process-row.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .process-glow {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: rgba(88, 179, 250, 0.15);
    transform: scale(0.9);
    opacity: 0.1;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .is-active .process-glow {
    transform: scale(1.25);
    opacity: 1;
    background: linear-gradient(135deg, rgba(88, 179, 250, 0.45) 0%, rgba(43, 93, 158, 0.45) 100%);
    box-shadow: 0 0 25px rgba(88, 179, 250, 0.45);
    animation: process-pulse 2s infinite alternate ease-in-out;
  }

  .process-dot {
    position: relative;
    display: flex;
    height: 96px;
    width: 96px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-color: #fff;
    border: 2px solid var(--color-card-blue);
    box-shadow: 0 8px 16px rgba(43, 93, 158, 0.15);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 10;
  }

  @media (max-width: 900px) {
    .process-dot {
      height: 64px;
      width: 64px;
    }
  }

  .is-active .process-dot {
    border-color: var(--color-accent-blue);
    background: linear-gradient(135deg, #fff 0%, #f0f7ff 100%);
    transform: scale(1.12);
    box-shadow: 0 12px 24px rgba(88, 179, 250, 0.35);
  }

  .process-text-container {
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes process-pulse {
    0% {
      transform: scale(1.15);
      box-shadow: 0 0 20px rgba(88, 179, 250, 0.35);
    }
    100% {
      transform: scale(1.3);
      box-shadow: 0 0 35px rgba(43, 93, 158, 0.65);
    }
  }
</style>
