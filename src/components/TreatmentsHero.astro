---

---

<section
  class="relative mx-auto w-[calc(100%-32px)] max-w-460 min-h-[calc(100svh-140px)] grid items-center pt-[clamp(40px,8vw,80px)] pb-[clamp(40px,8vw,80px)] max-[620px]:w-[calc(100%-28px)]"
  id="treatments-hero"
  aria-labelledby="treatments-hero-title"
>
  <div
    class="grid grid-cols-2 gap-[clamp(24px,4vw,60px)] items-center max-[980px]:grid-cols-1 max-[980px]:gap-8"
  >
    <!-- Left: Content -->
    <div class="flex flex-col justify-center">
      <p
        class="m-0 text-[11px] font-bold tracking-[0.38em] text-card-blue/70 uppercase"
      >
        Our Services
      </p>
      <h1
        id="treatments-hero-title"
        class="mt-3 text-[clamp(42px,5vw,72px)] font-extrabold leading-[1.02] text-heading max-[620px]:text-[clamp(36px,10vw,56px)]"
      >
        Comprehensive dental solutions
      </h1>
      <p
        class="mt-6 text-[clamp(15px,1.05vw,18px)] leading-normal text-heading/80 max-w-140"
      >
        From preventive care to advanced cosmetic procedures, we offer a
        complete spectrum of treatments designed to restore, enhance, and
        maintain your smile for life.
      </p>

      <div class="mt-10 flex gap-6 max-[620px]:gap-4">
        <a
          class="inline-flex min-h-14.5 items-center gap-3 rounded-full bg-linear-to-r from-accent-blue to-card-blue py-0 pr-7 pl-3 text-base font-extrabold text-white no-underline shadow-[0_18px_34px_rgba(43,93,158,0.26)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_22px_42px_rgba(43,93,158,0.32)] max-[620px]:min-h-13 max-[620px]:pr-5.5 max-[620px]:text-sm"
          href="#contact-us"
        >
          <span
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/20"
            aria-hidden="true"
          >
            <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" role="img">
              <path
                d="M7 2.75a.75.75 0 0 1 .75.75V5h8.5V3.5a.75.75 0 0 1 1.5 0V5H19a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h1.25V3.5A.75.75 0 0 1 7 2.75ZM3.5 10v8A1.5 1.5 0 0 0 5 19.5h14a1.5 1.5 0 0 0 1.5-1.5v-8h-17Zm3 3.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Zm0 3a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5a.75.75 0 0 1-.75-.75Z"
                fill="currentColor"></path>
            </svg>
          </span>
          Book a consultation
        </a>
      </div>
    </div>

    <!-- Right: Visual Element -->
    <div
      class="relative flex items-center justify-center h-100 max-[980px]:h-75 max-[620px]:h-70"
      aria-hidden="true"
    >
      <div class="absolute inset-0 rounded-3xl overflow-hidden">
        <div
          class="absolute inset-0 bg-linear-to-br from-accent-blue/20 to-card-blue/20 backdrop-blur-3xl"
        >
        </div>
        <svg
          class="w-full h-full object-contain p-8"
          viewBox="0 0 200 200"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <linearGradient
              id="treatment-gradient"
              x1="0%"
              y1="0%"
              x2="100%"
              y2="100%"
            >
              <stop offset="0%" style="stop-color:#58b3fa;stop-opacity:1"
              ></stop>
              <stop offset="100%" style="stop-color:#2b5d9e;stop-opacity:1"
              ></stop>
            </linearGradient>
          </defs>

          <!-- Medical/Dental Icon -->
          <circle
            cx="100"
            cy="100"
            r="90"
            fill="url(#treatment-gradient)"
            opacity="0.1"></circle>
          <circle
            cx="100"
            cy="100"
            r="70"
            fill="none"
            stroke="url(#treatment-gradient)"
            stroke-width="2"></circle>

          <!-- Treatment symbols -->
          <g fill="url(#treatment-gradient)" opacity="0.8">
            <rect x="50" y="90" width="100" height="8" rx="4"></rect>
            <rect x="92" y="50" width="8" height="100" rx="4"></rect>
            <circle
              cx="100"
              cy="100"
              r="12"
              fill="url(#treatment-gradient)"
              opacity="0.6"></circle>
          </g>

          <!-- Plus symbol animation reference -->
          <g
            stroke="url(#treatment-gradient)"
            stroke-width="3"
            fill="none"
            stroke-linecap="round"
          >
            <path d="M 100 140 L 100 160" opacity="0.5"></path>
            <path d="M 120 100 L 140 100" opacity="0.5"></path>
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>
